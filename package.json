{
  "name": "debug80-toolchain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Workspace for the Debug80 Z80 development toolchain",
  "workspaces": [
    "packages/azm",
    "apps/*",
    "integration/azm-headless"
  ],
  "scripts": {
    "build": "npm run build -w @jhlagado/azm && npm run build -w debug80",
    "typecheck": "npm run typecheck -w @jhlagado/azm && npm run typecheck -w @jhlagado/azm-headless-integration && npm run typecheck -w debug80 && npm run typecheck:webview -w debug80",
    "lint": "npm run lint --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present",
    "test": "npm run test -w @jhlagado/azm && npm run test -w @jhlagado/azm-headless-integration && npm run test -w debug80",
    "format": "npm run format --workspaces --if-present",
    "check:links": "node scripts/check-links.mjs",
    "check:links:external": "node scripts/check-links.mjs --external",
    "check:assembler-selections": "node scripts/check-assembler-selections.mjs",
    "check:source-file-sizes": "node scripts/check-source-file-sizes.mjs",
    "check:source-file-sizes:enforce": "node scripts/check-source-file-sizes.mjs --enforce-hard-cap",
    "check": "npm run build && npm run typecheck && npm run lint && npm run format:check && npm run check:assembler-selections && npm run check:azm-dependency-inventory && npm run check:cpm22-atom-candidates && npm run check:atom-e2e-fixtures && npm run test",
    "package:azm": "npm run test:package -w @jhlagado/azm",
    "package:debug80": "npm run package:check -w debug80",
    "check:azm-dependency-inventory": "node scripts/check-azm-dependency-inventory.mjs",
    "build:atom-e2e-fixtures": "node scripts/generate-atom-e2e-fixtures.mjs",
    "check:atom-e2e-fixtures": "node scripts/generate-atom-e2e-fixtures.mjs --check",
    "build:cpm22": "npm run build -w @jhlagado/azm && node scripts/cpm22/build-image.mjs",
    "import:cpm22-nucleus": "node scripts/cpm22/import-nucleus.mjs",
    "measure:cpm22-editor": "npm run build -w @jhlagado/azm && node scripts/cpm22/measure-editor-buffers.mjs",
    "measure:cpm22-editor-search": "npm run build -w @jhlagado/azm && node scripts/cpm22/measure-editor-search.mjs",
    "measure:cpm22-editor-new-file": "npm run build -w @jhlagado/azm && node scripts/cpm22/measure-editor-new-file.mjs",
    "measure:cpm22-editor-replace": "npm run build -w @jhlagado/azm && node scripts/cpm22/measure-editor-replace.mjs",
    "proof:cpm22-editor": "npm run build:cpm22 && node scripts/cpm22/prove-editor.mjs",
    "test:cpm22": "npm run build:cpm22 && node scripts/cpm22/acceptance.mjs",
    "check:cpm22-atom-candidates": "node scripts/cpm22/check-atom-assembly-candidates.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@jhlagado/z80-tool-services": "git+https://github.com/jhlagado/z80-tool-services.git#6313682d4a9bc3d08d32c11fe054d153ce350720",
    "@jhlagado/debug80-runtime": "git+https://github.com/jhlagado/debug80-runtime.git#b7343aa8c38c248abbc6ee801b4af270d4843ad6",
    "atom-z80": "git+https://github.com/jhlagado/atom.git#27b32ad97ee0596d1952617261b644f8ccc389f9"
  }
}
