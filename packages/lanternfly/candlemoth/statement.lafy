// Candlemoth — declaration and statement parser
//
// Written in level-0 Lanternfly. Last of the four files: tokenizer,
// expression, symbols, statement. This one supplies the destination types
// the expression parser settles exact literals against. Parsing Candlemoth's
// complete source is the test of whether these four files cover level 0.

// ------------------------------------------------------------------ labels
//
// The emission pass writes each code byte to a port. A stream cannot be
// patched, so a forward branch cannot be filled in after its target is
// reached, and the usual back-patch is unavailable. The three passes solve
// it instead: the layout pass records every label's address in a table, and
// the emission pass reads addresses that are already there.
//
// That makes the table global rather than per-subroutine. Both passes
// allocate the same identifiers in the same order, so an identifier means
// the same label in both, but only if the counter runs across the whole
// program — reset it per subroutine and emission reads the addresses of
// whichever subroutine layout happened to finish with.
//
// The size is measured rather than guessed. Candlemoth's own source needs 416
// labels — 297 conditionals, 50 else arms, 18 while loops at two each and 11
// counted loops at three. Five hundred and twelve leaves 23% of headroom and
// costs one kilobyte, where the two thousand this started at cost four for no
// reason anyone had checked.
//
// A kilobyte is still the price of a streaming output: a compiler that could
// seek in its own object code would spend a two-entry stack per open construct
// instead of a table sized by the whole program.

const labelLimit as u16 = 512

var labelAddress as u16[labelLimit]
var labelCount as u16 = 0

enum StatementFault as u8
    stmtFaultNone
    stmtFaultTooManyLabels
    stmtFaultExpectedName
    stmtFaultExpectedType
    stmtFaultExpectedThen
    stmtFaultExpectedEnd
    stmtFaultExpectedNewline
    stmtFaultExpectedAssign
    stmtFaultExpectedUntil
    stmtFaultExpectedParen
    stmtFaultUnexpectedToken
    stmtFaultLabelDisagreement
    stmtFaultReturnOutsideSub
    stmtFaultExitOutsideLoop
    stmtFaultTooManyArguments
    stmtFaultForwardDisagreement
    stmtFaultWrongArgumentCount
    stmtFaultRuntimeMisplaced
    stmtFaultDeclarationAfterStatement
    stmtFaultEnumNotByte
    stmtFaultCaseTypeMismatch
    stmtFaultTooManyElements
    stmtFaultElementNotConstant
    stmtFaultArrayInitialiser
end

var stmtFault as StatementFault = stmtFaultNone
var stmtFaultLine as u16 = 0

sub reportStmtFault(code as StatementFault)
    if stmtFault = stmtFaultNone then
        stmtFault = code
        stmtFaultLine = tokenLine
    end
end

sub allocateLabel() as u16
    if labelCount >= labelLimit then
        reportStmtFault(stmtFaultTooManyLabels)
        return 0
    end
    labelCount = labelCount + 1
    return labelCount - 1
end

// The layout pass writes the address; the emission pass checks that the same
// address arrives again. That check is the whole reason three passes are
// trustworthy, so it is an assertion rather than an assignment.
sub placeLabel(id as u16)
    if pass = passLayout then
        labelAddress[id] = here
        return
    end
    if pass = passEmission then
        if labelAddress[id] <> here then
            reportStmtFault(stmtFaultLabelDisagreement)
        end
    end
end

// ------------------------------------------------------------------ jumps
//
// Forward jumps are three-byte absolute, because during the layout pass the
// target address is still zero and a relative displacement would be measured
// against the wrong value — and a displacement that changed between passes
// would change the instruction's length and break the agreement the third
// pass checks. A backward jump could be relative and is left absolute for
// the same uniformity; the saving is one byte per loop and the risk is a
// whole class of pass disagreement.

const opJump as u8 = 195
const opJumpIfZero as u8 = 202
const opJumpIfNotZero as u8 = 194
const opReturn as u8 = 201
const opOrH as u8 = 180

sub emitJump(id as u16)
    emit(opJump)
    emitWord(labelAddress[id])
end

// Tests the accumulator against zero, which for a Boolean is the false case.
sub emitTest()
    emit(opLoadAFromL)
    emit(opOrH)
end

sub emitJumpIfFalse(id as u16)
    emitTest()
    emit(opJumpIfZero)
    emitWord(labelAddress[id])
end

sub emitJumpIfTrue(id as u16)
    emitTest()
    emit(opJumpIfNotZero)
    emitWord(labelAddress[id])
end

// ------------------------------------------------------------------- types
//
// The four type spellings are interned once at startup, so recognising a
// type is four `u16` comparisons rather than four spelling compares. They
// are ordinary names rather than keywords, which lets a local called `count`
// coexist with a type called `u8` without a reserved-word list that grows
// with the type system.

const typeTextBytes as u16 = 15
const typeText as u8[typeTextBytes] = [
    117, 56,                                    // u8
    117, 49, 54,                                // u16
    105, 49, 54,                                // i16
    98, 111, 111, 108, 101, 97, 110             // boolean
]
const typeTextStart as u16[4] = [0, 2, 5, 8]
const typeTextSize as u8[4] = [2, 3, 3, 7]

var typeNameU8 as u16 = 0
var typeNameU16 as u16 = 0
var typeNameI16 as u16 = 0
var typeNameBoolean as u16 = 0

// The same copy-then-intern shape `installKeywords` uses, for the same
// reason: level 0 has no strings, so a spelling is a slice of a constant
// byte array.
sub internTypeNames()
    var which as u16 = 0
    var index as u16 = 0
    var at as u16 = 0
    var interned as u16 = 0

    for which = 0 until 4
        at = typeTextStart[which]
        spellingLength = typeTextSize[which]
        for index = 0 until u16(spellingLength)
            spelling[index] = typeText[at + index]
        end
        interned = internSpelling()
        if which = 0 then
            typeNameU8 = interned
        end
        if which = 1 then
            typeNameU16 = interned
        end
        if which = 2 then
            typeNameI16 = interned
        end
        if which = 3 then
            typeNameBoolean = interned
        end
    end
end

// The type a name denotes, or `typeNone` when it denotes no type. This is
// what tells `X(y)` apart from `f(y)` without a second token: a name that
// names a type is a conversion and a name that names a subroutine is a call.
sub conversionTarget(name as u16) as TypeKind
    var found as u16 = 0

    if name = typeNameU8 then
        return typeU8
    end
    if name = typeNameU16 then
        return typeU16
    end
    if name = typeNameI16 then
        return typeI16
    end
    if name = typeNameBoolean then
        return typeBoolean
    end
    found = findSymbol(name)
    if found = 0 then
        return typeNone
    end
    if symbolClass[found - 1] = symbolEnumType then
        return typeU8
    end
    return typeNone
end

// The declaration slot of the enum a name denotes, one greater, or zero.
sub enumSlotOfTypeName(name as u16) as u16
    var found as u16 = findSymbol(name)

    if found = 0 then
        return 0
    end
    if symbolClass[found - 1] = symbolEnumType then
        return found
    end
    return 0
end

sub parseTypeName() as TypeKind
    var name as u16 = 0
    var found as u16 = 0

    if tokenKind <> kindName then
        reportStmtFault(stmtFaultExpectedType)
        return typeNone
    end
    name = tokenNameIndex
    nextToken()
    if name = typeNameU8 then
        declaredEnum = 0
        return typeU8
    end
    if name = typeNameU16 then
        declaredEnum = 0
        return typeU16
    end
    if name = typeNameI16 then
        declaredEnum = 0
        return typeI16
    end
    if name = typeNameBoolean then
        declaredEnum = 0
        return typeBoolean
    end
    found = findSymbol(name)
    if found > 0 then
        if symbolClass[found - 1] = symbolEnumType then
            // An enum is stored as the `u8` it is declared over; its identity
            // travels beside the type rather than inside it.
            declaredEnum = found
            return typeU8
        end
    end
    declaredEnum = 0
    reportStmtFault(stmtFaultExpectedType)
    return typeNone
end

// Set by `parseTypeName` to the enum a written type denotes, or zero.
var declaredEnum as u16 = 0

// --------------------------------------------------------------- boundaries

sub expectNewline()
    if tokenKind = kindNewline then
        nextToken()
        return
    end
    if tokenKind = kindEnd then
        return
    end
    reportStmtFault(stmtFaultExpectedNewline)
end

sub skipNewlines()
    while tokenKind = kindNewline
        nextToken()
    end
end

sub expectKeyword(which as Keyword, code as StatementFault)
    if tokenKind = kindKeyword then
        if tokenKeyword = which then
            nextToken()
            return
        end
    end
    reportStmtFault(code)
end

sub atKeyword(which as Keyword) as boolean
    if tokenKind <> kindKeyword then
        return false
    end
    return tokenKeyword = which
end

sub atPunct(which as Punct) as boolean
    if tokenKind <> kindPunct then
        return false
    end
    return tokenPunct = which
end

// ------------------------------------------------------------ declarations

forward sub parseStatement()
forward sub parseStatementList()

// `var name as type` with an optional `[length]` and an optional `= value`.
// The declared type is what `settleExpression` narrows the initialiser
// against, which is the destination context the expression parser was
// written without and could not test.
sub parseVariable()
    var name as u16 = 0
    var kind as TypeKind = typeNone
    var slot as u16 = 0
    var length as u16 = 0

    nextToken()
    if tokenKind <> kindName then
        reportStmtFault(stmtFaultExpectedName)
        return
    end
    name = tokenNameIndex
    nextToken()
    expectKeyword(keywordAs, stmtFaultExpectedType)
    kind = parseTypeName()

    if atPunct(punctLeftBracket) then
        nextToken()
        parseExpression()
        settleExpression(typeU16)
        if resultIsConstant then
            length = resultValue
        else
            // An array length is a compile-time quantity, because storage is
            // laid out before anything runs. A computed bound would need a
            // heap, which the language does not have.
            reportStmtFault(stmtFaultExpectedType)
        end
        if atPunct(punctRightBracket) then
            nextToken()
        else
            reportStmtFault(stmtFaultExpectedParen)
        end
    end

    slot = declareSymbol(name, symbolVariable, kind)
    symbolLength[slot] = length
    symbolEnum[slot] = declaredEnum

    if atPunct(punctEqual) then
        nextToken()
        if length > 0 then
            // A `var` array is writable storage, so its contents cannot be
            // image bytes, and level 0 has nowhere to run an initialising
            // loop before the designated start. An initialised array is a
            // `const`.
            reportStmtFault(stmtFaultArrayInitialiser)
            return
        end
        parseExpression()
        settleExpression(kind)
        // A constant initialiser could become an image byte instead of a load
        // and a store. It does not here: `settleExpression` has already
        // planted the load by the time the fold is known, and suppressing it
        // needs the same emission control as the constant-subscript
        // reduction. Both are measured together once the seed exists.
        emitStoreSymbol(slot)
    end
    expectNewline()
end

// An array initialiser: `[ v, v, v ]`, every element a constant. The values
// are emitted where the declaration sits, so the array's storage *is* those
// image bytes — which is what makes the 256-entry character-class table cost
// 256 bytes and no instructions.
//
// The declared length wins over the written count: a short list leaves the
// remaining elements zero, and a long one is an error rather than a silent
// overrun of whatever follows.
// Elements the list did not write are zero, and they still occupy the image
// because the array's storage is contiguous.
sub padArray(byteWide as boolean, remaining as u16)
    var index as u16 = 0

    for index = 0 until remaining
        if byteWide then
            emit(0)
        else
            emitWord(0)
        end
    end
end

sub parseArrayLiteral(slot as u16, kind as TypeKind, length as u16)
    var written as u16 = 0
    var byteWide as boolean = isByteWide(kind)

    // The array begins wherever the stream has reached, and every later
    // reference loads from here.
    symbolAddress[slot] = here

    nextToken()
    while true
        skipNewlines()
        if atPunct(punctRightBracket) then
            nextToken()
            padArray(byteWide, length - written)
            return
        end
        if written >= length then
            reportStmtFault(stmtFaultTooManyElements)
            return
        end

        parseExpression()
        settleExpression(kind)
        if resultIsConstant = false then
            reportStmtFault(stmtFaultElementNotConstant)
            return
        end
        if byteWide then
            emit(u8(constantPattern(resultValue, resultNegative) and 255))
        else
            emitWord(constantPattern(resultValue, resultNegative))
        end
        written = written + 1

        skipNewlines()
        if atPunct(punctComma) then
            nextToken()
        else
            if atPunct(punctRightBracket) = false then
                reportStmtFault(stmtFaultExpectedParen)
                return
            end
        end
        if stmtFault <> stmtFaultNone then
            return
        end
    end
end

// `const name as type = value`. The value must fold, and it is kept in the
// symbol table rather than in storage, so a constant costs nothing at run
// time and can be used in an array bound.
sub parseConstant()
    var name as u16 = 0
    var kind as TypeKind = typeNone
    var slot as u16 = 0
    var length as u16 = 0

    nextToken()
    if tokenKind <> kindName then
        reportStmtFault(stmtFaultExpectedName)
        return
    end
    name = tokenNameIndex
    nextToken()
    expectKeyword(keywordAs, stmtFaultExpectedType)
    kind = parseTypeName()

    if atPunct(punctLeftBracket) then
        // `const name as type[length]` — a placed array. Its slot is declared
        // before the literal is read, because the literal fixes its address.
        nextToken()
        parseExpression()
        settleExpression(typeU16)
        if resultIsConstant then
            length = resultValue
        else
            reportStmtFault(stmtFaultExpectedType)
        end
        if atPunct(punctRightBracket) then
            nextToken()
        else
            reportStmtFault(stmtFaultExpectedParen)
        end

        slot = declareSymbol(name, symbolConstant, kind)
        symbolLength[slot] = length
        symbolEnum[slot] = declaredEnum

        if atPunct(punctEqual) then
            nextToken()
        else
            reportStmtFault(stmtFaultExpectedAssign)
            return
        end
        if atPunct(punctLeftBracket) = false then
            reportStmtFault(stmtFaultExpectedAssign)
            return
        end
        parseArrayLiteral(slot, kind, length)
        expectNewline()
        return
    end

    if atPunct(punctEqual) then
        nextToken()
    else
        reportStmtFault(stmtFaultExpectedAssign)
    end

    // `settleExpression` is deliberately not called: it plants the load that
    // materialises a constant, and a constant declaration produces no code
    // at all. The fit check it would have performed is done here instead.
    parseExpression()
    if resultIsConstant = false then
        reportStmtFault(stmtFaultUnexpectedToken)
    end
    if exactFits(resultValue, resultNegative, kind) = false then
        reportExprFault(exprFaultConstantRange)
    end

    slot = declareSymbol(name, symbolConstant, kind)
    symbolValue[slot] = resultValue
    symbolNegative[slot] = resultNegative
    symbolEnum[slot] = declaredEnum
    expectNewline()
end

// ------------------------------------------------------------- assignment
//
// The left side is read before the right, so an element assignment computes
// its address first and pushes it. That order matters: the index expression
// and the value expression both use HL, and the address must survive the
// second one.

sub parseAssignment()
    var name as u16 = 0
    var found as u16 = 0
    var slot as u16 = 0
    var kind as TypeKind = typeNone
    var subscripted as boolean = false

    name = tokenNameIndex
    nextToken()

    found = findSymbol(name)
    if found = 0 then
        reportSymbolFault(symbolFaultNotDeclared)
        return
    end
    slot = found - 1
    if symbolClass[slot] = symbolConstant then
        reportSymbolFault(symbolFaultReadOnly)
        return
    end
    kind = symbolType[slot]

    if atPunct(punctLeftBracket) then
        subscripted = true
        nextToken()
        kind = emitElementAddress(slot)
        emit(opPushHl)
    end

    if atPunct(punctEqual) then
        nextToken()
    else
        reportStmtFault(stmtFaultExpectedAssign)
        return
    end

    parseExpression()
    settleExpression(kind)

    if subscripted then
        emit(opPopDe)
        emitStoreElement(kind)
    else
        emitStoreSymbol(slot)
    end
    expectNewline()
end

// --------------------------------------------------------------- selection

sub parseIf()
    var skipArm as u16 = 0
    var skipRest as u16 = 0

    nextToken()
    parseExpression()
    settleExpression(typeBoolean)
    expectKeyword(keywordThen, stmtFaultExpectedThen)

    skipArm = allocateLabel()
    emitJumpIfFalse(skipArm)
    expectNewline()
    parseStatementList()

    if atKeyword(keywordElse) then
        nextToken()
        skipRest = allocateLabel()
        emitJump(skipRest)
        placeLabel(skipArm)
        expectNewline()
        parseStatementList()
        placeLabel(skipRest)
    else
        placeLabel(skipArm)
    end
    expectKeyword(keywordEnd, stmtFaultExpectedEnd)
    expectNewline()
end

// ------------------------------------------------------------------- loops
//
// `exit` and `continue` need the enclosing loop's two labels, and loops
// nest, so the labels are a stack. Eight deep is past anything in the
// compiler's own source, which reaches three.

const loopLimit as u8 = 8

var loopBreakLabel as u16[loopLimit]
var loopContinueLabel as u16[loopLimit]
var loopDepth as u8 = 0

sub pushLoop(breakLabel as u16, continueLabel as u16)
    if loopDepth >= loopLimit then
        reportStmtFault(stmtFaultTooManyLabels)
        return
    end
    loopBreakLabel[loopDepth] = breakLabel
    loopContinueLabel[loopDepth] = continueLabel
    loopDepth = loopDepth + 1
end

sub popLoop()
    if loopDepth > 0 then
        loopDepth = u8(loopDepth - 1)
    end
end

sub parseWhile()
    var top as u16 = allocateLabel()
    var out as u16 = allocateLabel()

    nextToken()
    placeLabel(top)
    parseExpression()
    settleExpression(typeBoolean)
    emitJumpIfFalse(out)
    expectNewline()

    pushLoop(out, top)
    parseStatementList()
    popLoop()

    emitJump(top)
    placeLabel(out)
    expectKeyword(keywordEnd, stmtFaultExpectedEnd)
    expectNewline()
end

// One storage slot holds the loop's limit. Nested counted loops would need
// one per level; Candlemoth's own source never nests a counted loop, so one
// is declared and the restriction is recorded rather than designed around.
var forLimitSlot as u16 = 0

// `for name = first until last`. The Level Zero ruling removed `for ... to`:
// every counted loop in Candlemoth is exclusive, and the token audit found
// the parser still accepting the inclusive form after the ruling had removed
// it from the subset.
//
// The control variable is an ordinary declared local, which the findings
// ledger records as a level-0 consequence: there is no implicit declaration,
// so the name must already exist.
sub parseFor()
    var name as u16 = 0
    var found as u16 = 0
    var slot as u16 = 0
    var top as u16 = 0
    var out as u16 = 0
    var again as u16 = 0
    var kind as TypeKind = typeNone

    nextToken()
    if tokenKind <> kindName then
        reportStmtFault(stmtFaultExpectedName)
        return
    end
    name = tokenNameIndex
    nextToken()

    found = findSymbol(name)
    if found = 0 then
        reportSymbolFault(symbolFaultNotDeclared)
        return
    end
    slot = found - 1
    kind = symbolType[slot]

    if atPunct(punctEqual) then
        nextToken()
    else
        reportStmtFault(stmtFaultExpectedAssign)
        return
    end
    parseExpression()
    settleExpression(kind)
    emitStoreSymbol(slot)

    if atKeyword(keywordUntil) then
        nextToken()
    else
        reportStmtFault(stmtFaultExpectedUntil)
        return
    end

    // The limit is evaluated once, into a compiler-made local, because
    // re-evaluating it each turn would be a second reading of an expression
    // the source wrote once.
    parseExpression()
    settleExpression(kind)
    emitStoreSymbol(forLimitSlot)

    top = allocateLabel()
    out = allocateLabel()
    again = allocateLabel()

    placeLabel(top)
    emitLoadSymbol(slot)
    emit(opPushHl)
    emitLoadSymbol(forLimitSlot)
    emit(opPopDe)
    // `until` leaves the loop when the control variable reaches the limit.
    emitHelperCall(comparisonHelper(punctGreaterEqual, kind = typeI16))
    emitJumpIfTrue(out)
    expectNewline()

    pushLoop(out, again)
    parseStatementList()
    popLoop()

    placeLabel(again)
    emitLoadSymbol(slot)
    emitLoadOperand(1)
    emitAdd()
    emitStoreSymbol(slot)
    emitJump(top)
    placeLabel(out)

    expectKeyword(keywordEnd, stmtFaultExpectedEnd)
    expectNewline()
end

// ------------------------------------------------------------------- calls

const argumentLimit as u8 = 8

// A call evaluates its arguments left to right into the callee's parameter
// storage. Static frames mean a parameter has a fixed address, so an
// argument is a store rather than a push, and the call sequence is the same
// whether or not the callee is in a recursive group. Save-around-call is the
// caller's business and is emitted by the subroutine body, not here.
sub parseCallArguments(slot as u16)
    var parameter as u16 = slot + 1
    var given as u16 = 0
    var wanted as u16 = symbolLength[slot]

    if atPunct(punctLeftParen) = false then
        reportStmtFault(stmtFaultExpectedParen)
        return
    end
    nextToken()

    while atPunct(punctRightParen) = false
        if given >= u16(argumentLimit) then
            reportStmtFault(stmtFaultTooManyArguments)
            return
        end
        if given >= wanted then
            reportStmtFault(stmtFaultWrongArgumentCount)
            return
        end
        parseExpression()
        settleExpression(symbolType[parameter])
        emitStoreSymbol(parameter)
        parameter = parameter + 1
        given = given + 1
        if atPunct(punctComma) then
            nextToken()
        else
            if atPunct(punctRightParen) = false then
                reportStmtFault(stmtFaultExpectedParen)
                return
            end
        end
    end
    nextToken()

    if given <> wanted then
        reportStmtFault(stmtFaultWrongArgumentCount)
        return
    end

    emit(opCall)
    emitWord(symbolAddress[slot])
end

sub parseCallStatement()
    var name as u16 = tokenNameIndex
    var found as u16 = 0

    nextToken()
    found = findSymbol(name)
    if found = 0 then
        reportSymbolFault(symbolFaultNotDeclared)
        return
    end
    parseCallArguments(found - 1)
    expectNewline()
end

// -------------------------------------------------------------- statements

var currentReturnType as TypeKind = typeNone

sub parseReturn()
    nextToken()
    if tokenKind = kindNewline then
        emit(opReturn)
        expectNewline()
        return
    end
    parseExpression()
    settleExpression(currentReturnType)
    emit(opReturn)
    expectNewline()
end

sub parseExit()
    nextToken()
    if loopDepth = 0 then
        reportStmtFault(stmtFaultExitOutsideLoop)
        return
    end
    emitJump(loopBreakLabel[loopDepth - 1])
    expectNewline()
end

sub parseContinue()
    nextToken()
    if loopDepth = 0 then
        reportStmtFault(stmtFaultExitOutsideLoop)
        return
    end
    emitJump(loopContinueLabel[loopDepth - 1])
    expectNewline()
end

// ----------------------------------------------------------- enumerations
//
// `enum Name as u8` followed by one member per line. Each member becomes a
// constant of the enum's type carrying its ordinal, and the enum's own slot
// carries the member count in `symbolLength` — which is what the checked
// ordinal conversion checks against.
//
// Only `u8` is accepted. Section 3 allows an enum over any integer type, and
// level 0 has no enum over anything else, so the wider forms stay out under
// the boundary rule.
sub parseEnum()
    var name as u16 = 0
    var slot as u16 = 0
    var member as u16 = 0
    var ordinal as u16 = 0
    var representation as TypeKind = typeNone
    var memberSlot as u16 = 0

    nextToken()
    if tokenKind <> kindName then
        reportStmtFault(stmtFaultExpectedName)
        return
    end
    name = tokenNameIndex
    nextToken()
    expectKeyword(keywordAs, stmtFaultExpectedType)
    representation = parseTypeName()
    if representation <> typeU8 then
        reportStmtFault(stmtFaultEnumNotByte)
    end
    expectNewline()

    slot = declareSymbol(name, symbolEnumType, typeU8)

    while true
        skipNewlines()
        if atKeyword(keywordEnd) then
            nextToken()
            symbolLength[slot] = ordinal
            expectNewline()
            return
        end
        if tokenKind <> kindName then
            reportStmtFault(stmtFaultExpectedName)
            return
        end
        member = tokenNameIndex
        nextToken()

        // A member is an ordinary constant of the enum's type, so every rule
        // that already holds for a constant holds for it: it folds where it
        // is used, costs no storage, and can appear in an array bound.
        memberSlot = declareSymbol(member, symbolConstant, typeU8)
        symbolValue[memberSlot] = ordinal
        symbolEnum[memberSlot] = slot + 1
        ordinal = ordinal + 1
        expectNewline()
        if stmtFault <> stmtFaultNone then
            return
        end
    end
end

// --------------------------------------------------------------- select
//
// One constant per `case`, and no fall-through: an arm ends where the next
// `case` begins. Multi-value and range cases are out under the boundary rule.
//
// The selector is evaluated once into compiler-owned storage and compared
// against each label in turn. A jump table would be faster and needs the
// labels to be dense, which the compiler cannot know until every arm is read
// — and it has read none of them when it must emit the dispatch.
// One slot holds the selector under test. Nested `select` statements would
// need one per level; the front end nests none, so one is declared and the
// restriction recorded, as for the counted loop's limit.
var selectSlot as u16 = 0

sub parseSelect()
    var out as u16 = allocateLabel()
    var nextArm as u16 = 0
    var kind as TypeKind = typeNone
    var selectorEnum as u16 = 0
    var arms as u16 = 0

    nextToken()
    parseExpression()
    settleExpression(typeNone)
    kind = resultType
    selectorEnum = resultEnum
    emitStoreSymbol(selectSlot)
    expectNewline()

    while true
        skipNewlines()
        if atKeyword(keywordCase) then
            nextToken()
            nextArm = allocateLabel()

            emitLoadSymbol(selectSlot)
            emit(opPushHl)
            parseExpression()
            settleExpression(kind)
            if resultEnum <> selectorEnum then
                reportStmtFault(stmtFaultCaseTypeMismatch)
            end
            if resultIsConstant then
                emitLoadAccumulator(constantPattern(resultValue, resultNegative))
            end
            emit(opPopDe)
            emitHelperCall(comparisonHelper(punctEqual, false))
            emitJumpIfFalse(nextArm)
            expectNewline()

            parseStatementList()
            emitJump(out)
            placeLabel(nextArm)
            arms = arms + 1
        else
            if atKeyword(keywordElse) then
                nextToken()
                expectNewline()
                parseStatementList()
                expectKeyword(keywordEnd, stmtFaultExpectedEnd)
                placeLabel(out)
                expectNewline()
                return
            end
            if atKeyword(keywordEnd) then
                nextToken()
                placeLabel(out)
                expectNewline()
                return
            end
            reportStmtFault(stmtFaultUnexpectedToken)
            return
        end
        if stmtFault <> stmtFaultNone then
            return
        end
    end
end

// A subroutine name at statement position begins a call; anything else that
// can be assigned to is a variable. The distinction is the symbol's class, so
// it needs no second token.
sub nameBeginsCall() as boolean
    var found as u16 = findSymbol(tokenNameIndex)

    if found = 0 then
        return false
    end
    return symbolClass[found - 1] = symbolSubroutine
end

sub parseStatement()
    if tokenKind = kindKeyword then
        // Review finding 21: `var` and `const` used to be statements, so the
        // parser accepted a declaration after a statement and inside a loop
        // or branch. Section 4 puts every routine declaration before every
        // statement, and `parseDeclarationPrefix` is the only place that
        // reads one.
        if tokenKeyword = keywordVar then
            reportStmtFault(stmtFaultDeclarationAfterStatement)
            return
        end
        if tokenKeyword = keywordConst then
            reportStmtFault(stmtFaultDeclarationAfterStatement)
            return
        end
        if tokenKeyword = keywordIf then
            parseIf()
            return
        end
        if tokenKeyword = keywordWhile then
            parseWhile()
            return
        end
        if tokenKeyword = keywordSelect then
            parseSelect()
            return
        end
        if tokenKeyword = keywordFor then
            parseFor()
            return
        end
        if tokenKeyword = keywordReturn then
            parseReturn()
            return
        end
        if tokenKeyword = keywordExit then
            parseExit()
            return
        end
        if tokenKeyword = keywordContinue then
            parseContinue()
            return
        end
        reportStmtFault(stmtFaultUnexpectedToken)
        nextToken()
        return
    end
    if tokenKind = kindName then
        // A name begins either an assignment or a call, and one token of
        // lookahead separates them. The tokenizer offers exactly one, which
        // is the constraint the findings ledger records; this is the place
        // it is spent.
        if nameBeginsCall() then
            parseCallStatement()
        else
            parseAssignment()
        end
        return
    end
    reportStmtFault(stmtFaultUnexpectedToken)
    nextToken()
end

// Every declaration a routine makes, before its first statement. Section 4
// puts them there, and reading them in one place is what lets
// `parseStatement` reject one that appears later.
sub parseDeclarationPrefix()
    while true
        skipNewlines()
        if tokenKind <> kindKeyword then
            return
        end
        if tokenKeyword = keywordVar then
            parseVariable()
        else
            if tokenKeyword = keywordConst then
                parseConstant()
            else
                return
            end
        end
        if stmtFault <> stmtFaultNone then
            return
        end
    end
end

// A statement list ends at `end`, `else`, `case` or end of input. None of
// those is consumed here, so the caller reads whichever one it was written
// to accept.
sub parseStatementList()
    while true
        skipNewlines()
        if tokenKind = kindEnd then
            return
        end
        if tokenKind = kindKeyword then
            if tokenKeyword = keywordEnd then
                return
            end
            if tokenKeyword = keywordElse then
                return
            end
            if tokenKeyword = keywordCase then
                return
            end
        end
        parseStatement()
        if stmtFault <> stmtFaultNone then
            return
        end
    end
end

// ------------------------------------------------------------ subroutines

// A subroutine's `symbolLength` holds its parameter count, and its
// parameters are the slots immediately above it. That adjacency is what lets
// a call site reach a parameter by arithmetic instead of by name, which
// matters because a parameter is out of scope everywhere a call is written.
//
// `declaring` is false when the body follows a `forward sub`: the parameters
// already exist at fixed addresses, and declaring a second set would give
// the body different storage from every call site. The list is still read,
// so a body that disagrees with its forward declaration is caught.
sub parseParameters(slot as u16, declaring as boolean)
    var name as u16 = 0
    var kind as TypeKind = typeNone
    var count as u16 = 0

    if atPunct(punctLeftParen) = false then
        reportStmtFault(stmtFaultExpectedParen)
        return
    end
    nextToken()

    while atPunct(punctRightParen) = false
        if tokenKind <> kindName then
            reportStmtFault(stmtFaultExpectedName)
            return
        end
        name = tokenNameIndex
        nextToken()
        expectKeyword(keywordAs, stmtFaultExpectedType)
        kind = parseTypeName()

        if declaring then
            declareSymbol(name, symbolParameter, kind)
        else
            if symbolName[slot + 1 + count] <> name then
                reportStmtFault(stmtFaultForwardDisagreement)
            end
            if symbolType[slot + 1 + count] <> kind then
                reportStmtFault(stmtFaultForwardDisagreement)
            end
        end
        count = count + 1

        if atPunct(punctComma) then
            nextToken()
        end
    end
    nextToken()

    if declaring then
        symbolLength[slot] = count
    else
        if symbolLength[slot] <> count then
            reportStmtFault(stmtFaultForwardDisagreement)
        end
    end
end

sub parseSubroutine(declaredForward as boolean)
    var name as u16 = 0
    var slot as u16 = 0
    var found as u16 = 0
    var declaring as boolean = true

    nextToken()
    if tokenKind <> kindName then
        reportStmtFault(stmtFaultExpectedName)
        return
    end
    name = tokenNameIndex
    nextToken()

    // A `forward sub` declared the name and its parameters already, so the
    // body reuses that slot rather than declaring a second one. Parameter
    // storage is addressed from the slot, so a duplicate would give the body
    // different addresses from every call site.
    found = findSymbol(name)
    if found > 0 then
        if symbolClass[found - 1] = symbolSubroutine then
            declaring = false
            slot = found - 1
        else
            slot = declareSymbol(name, symbolSubroutine, typeNone)
        end
    else
        slot = declareSymbol(name, symbolSubroutine, typeNone)
    end

    if declaring then
        enterLocals()
        parseParameters(slot, true)
        markBodyBase()
    else
        reenterLocals(slot + 1, symbolLength[slot])
        parseParameters(slot, false)
    end

    currentReturnType = typeNone
    if atKeyword(keywordAs) then
        nextToken()
        currentReturnType = parseTypeName()
    end
    if declaring then
        symbolType[slot] = currentReturnType
    else
        if symbolType[slot] <> currentReturnType then
            reportStmtFault(stmtFaultForwardDisagreement)
        end
    end

    if declaredForward then
        leaveLocals()
        expectNewline()
        return
    end

    symbolAddress[slot] = here
    expectNewline()
    // The transient region was opened when the parameter list closed, so the
    // prefix declares straight into it. Calling `markBodyBase` again here
    // would reset the region and discard what the prefix had just declared.
    parseDeclarationPrefix()
    parseStatementList()
    expectKeyword(keywordEnd, stmtFaultExpectedEnd)

    // A body that falls off its end still returns. A body with a declared
    // result that falls off its end returns whatever the accumulator holds,
    // which the language leaves undefined and this compiler does not
    // diagnose; the analysis pass is where that check belongs.
    emit(opReturn)
    leaveLocals()
    expectNewline()
end

// ------------------------------------------------------------------- units

sub parseUnit()
    while true
        skipNewlines()
        if tokenKind = kindEnd then
            return
        end
        if atKeyword(keywordForward) then
            nextToken()
            if atKeyword(keywordSub) then
                parseSubroutine(true)
            else
                reportStmtFault(stmtFaultUnexpectedToken)
                nextToken()
            end
        else
            if atKeyword(keywordSub) then
                parseSubroutine(false)
            else
                // At module level a declaration is the only thing there is:
                // level 0 has no mainline statements outside a routine.
                if atKeyword(keywordVar) then
                    parseVariable()
                else
                    if atKeyword(keywordConst) then
                        parseConstant()
                    else
                        if atKeyword(keywordEnum) then
                            parseEnum()
                        else
                            reportStmtFault(stmtFaultUnexpectedToken)
                            nextToken()
                        end
                    end
                end
            end
        end
        if stmtFault <> stmtFaultNone then
            return
        end
        if symbolFault <> symbolFaultNone then
            return
        end
    end
end

sub startParser()
    labelCount = 0
    loopDepth = 0
    stmtFault = stmtFaultNone
    stmtFaultLine = 0
    symbolFault = symbolFaultNone
    symbolCount = 0
    currentDepth = 0
    localFrom = 0
    localTop = 0
    paramFrom = 0
    paramCount = 0
    internTypeNames()
    // `nameLimit` and above are past the last interning slot, so no source
    // spelling produces them and the compiler's own storage cannot be
    // assigned to. Two distinct values, or the second declaration would be a
    // redeclaration of the first.
    forLimitSlot = declareSymbol(nameLimit, symbolVariable, typeU16)
    selectSlot = declareSymbol(nameLimit + 1, symbolVariable, typeU16)
end
