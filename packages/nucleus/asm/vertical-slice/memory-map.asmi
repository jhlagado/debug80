; Nucleus vertical-slice proof memory map
;
; Every end symbol is exclusive. The map keeps the 16 KiB compiler-core gate
; visible while giving every other account a distinct, bounded proof region.

CompilerCoreBase    .equ $0000
CompilerCoreLimit   .equ $4000

CompilerWorkBase    .equ $4000
CompilerWorkLimit   .equ $5000

SourceBase          .equ $5000
SourceLimit         .equ $5800

GeneratedBase       .equ $5800
GeneratedLimit      .equ $6800

TargetRuntimeBase   .equ $6800
TargetRuntimeLimit  .equ $7800

ExecutionBase       .equ $7800
ExecutionLimit      .equ $8800

ServiceBase         .equ $8800
ServiceLimit        .equ $9000

ProofBase           .equ $9000
ProofLimit          .equ $9800

SpareBase           .equ $9800
SpareLimit          .equ $F000

; Transactional Z80 emission keeps the prior 4 KiB published image here.
; Proof-only overflow sources end below this bounded subregion.
BackupBase    .equ $A000
BackupLimit   .equ $B000

StackFloor          .equ $F000
StackTop            .equ $FF00

HighReservedBase    .equ $FF00
AddressSpaceLimit   .equ $10000
