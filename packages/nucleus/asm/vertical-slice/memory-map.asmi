; Nucleus vertical-slice proof memory map
;
; Every end symbol is exclusive. The map keeps the 16 KiB compiler-core gate
; visible while giving every other account a distinct, bounded proof region.

CompilerCoreBase    .equ $0000
CompilerCoreLimit   .equ $4000

CompilerWorkBase    .equ $4000
CompilerWorkLimit   .equ $5000

SourceBase          .equ $5000
SourceLimit         .equ $5800

GeneratedBase       .equ $5800
GeneratedLimit      .equ $6800

; Historical direct-sink module proofs retain this complete-image region and
; its segmented variant. Production target proofs use target-memory-map.asmi
; and therefore cannot resolve these symbols.
GeneratedCodeBase       .equ GeneratedBase
GeneratedCodeLimit      .equ $6400
GeneratedRoDataBase     .equ GeneratedCodeLimit
GeneratedRoDataLimit    .equ GeneratedLimit

TargetRuntimeBase   .equ $6800
TargetRuntimeLimit  .equ $7800

ExecutionBase       .equ $7800
ExecutionLimit      .equ $8800

; Runtime state occupies the first page of ExecutionBase. Mutable initialized
; data and zero-initialized data occupy adjacent target regions after it.
ProgramDataBase         .equ ExecutionBase+$0100
ProgramDataLimit        .equ ProgramDataBase+$0400
ProgramBssBase          .equ ProgramDataLimit
ProgramBssLimit         .equ ProgramBssBase+$0400
ProgramDataRegionLimit  .equ ProgramBssLimit
ProgramDataRegionCapacity .equ ProgramDataRegionLimit-ProgramDataBase
GeneratedRoDataCapacity .equ GeneratedRoDataLimit-GeneratedRoDataBase

ServiceBase         .equ $8800
ServiceLimit        .equ $9000

ProofBase           .equ $9000
ProofLimit          .equ $9800

SpareBase           .equ $9800
SpareLimit          .equ $F000

; Historical direct-sink module proofs keep the prior published image here.
; Production target proofs release and account for this complete 4 KiB range.
BackupBase    .equ $A000
BackupLimit   .equ $B000

StackFloor          .equ $F000
StackTop            .equ $FF00

HighReservedBase    .equ $FF00
AddressSpaceLimit   .equ $10000
