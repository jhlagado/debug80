; Fixed compiler state for the scalar-local, counted-loop, and array slice.

CompilerStateBase       .equ CompilerWorkBase

SourcePartId            .equ CompilerStateBase+$00
SourceCursor            .equ CompilerStateBase+$01
SourceEnd               .equ CompilerStateBase+$03
SourceOffset            .equ CompilerStateBase+$05
SourceLine              .equ CompilerStateBase+$07
SourceColumn            .equ CompilerStateBase+$09
SourceLineHasToken       .equ CompilerStateBase+$0B
SourceDelimiterDepth    .equ CompilerStateBase+$0C

TokenStartOffset        .equ CompilerStateBase+$0D
TokenStartLine          .equ CompilerStateBase+$0F
TokenStartColumn        .equ CompilerStateBase+$11
TokenLexemePointer      .equ CompilerStateBase+$13
TokenLength             .equ CompilerStateBase+$15

DiagnosticCode          .equ CompilerStateBase+$16
DiagnosticPartId        .equ CompilerStateBase+$17
DiagnosticOffset        .equ CompilerStateBase+$18
DiagnosticLine          .equ CompilerStateBase+$1A
DiagnosticColumn        .equ CompilerStateBase+$1C

; A diagnostic ends parsing, so the live semantic sink may reuse the eventual
; offset and line fields. DiagnosticCode and DiagnosticPartId remain clear on
; successful compilation; an error overwrites all reused bytes before return.
; The high byte of DiagnosticLine and both bytes of DiagnosticColumn extend
; past CompilerStateEnd into the dead semantic buffer. The diagnostic is
; terminal, so no semantic byte remains live.
SinkCursor              .equ CompilerStateBase+$18
SinkOperationCount      .equ CompilerStateBase+$1A

; Emission begins only after parsing succeeds. Its scratch words therefore
; overlay dead source, token, diagnostic, and sink fields. SourcePartId and
; TokenStartOffset..TokenStartColumn remain intact for an emitter diagnostic.
GeneratedSize           .equ CompilerStateBase+$01
EmitCursor              .equ CompilerStateBase+$03
EmitCodeStart           .equ CompilerStateBase+$05
EmitLoopHead            .equ CompilerStateBase+$07
EmitExitFixup           .equ CompilerStateBase+$09
EmitFailureFixup        .equ CompilerStateBase+$0B
EmitUpdateExitFixup     .equ CompilerStateBase+$19
EmitPatchAddress        .equ CompilerStateBase+$13
EmitLimit               .equ CompilerStateBase+$15
EmitDataFixup           .equ CompilerStateBase+$17

CompilerStateEnd        .equ CompilerStateBase+$1B
SemanticBufferBase      .equ CompilerStateEnd
; The leading byte is an operation count and the remaining 255 bytes are a
; bounded variable-width transcript. The previous 33-byte proof buffer was
; already full and could not represent the complete scalar-expression layer.
SemanticBufferLimit     .equ SemanticBufferBase+$100

; One retained forward signature is enough for the first routine-call slice.
; The source bytes remain stable, so exact names are retained as pointer/length
; pairs rather than copied into another buffer.
ForwardNamePointer      .equ SemanticBufferLimit+$00
ForwardNameLength       .equ SemanticBufferLimit+$02
ForwardParameterPointer .equ SemanticBufferLimit+$03
ForwardParameterLength  .equ SemanticBufferLimit+$05
ForwardOrdinal          .equ SemanticBufferLimit+$06
ForwardCompleted        .equ SemanticBufferLimit+$07

; The predictive expression path keeps one token of lookahead. $FF denotes an
; empty lookahead cell; token ordinals occupy the low half of the byte range.
ParserLookaheadKind     .equ SemanticBufferLimit+$08
ParserLookaheadValue    .equ SemanticBufferLimit+$09

; Source bytes remain resident through compilation, so a scalar symbol keeps
; the exact spelling as a pointer and length instead of copying name bytes.
; The entry at SymbolCount is provisional until the declaration initializer
; succeeds; lookup sees only the committed prefix.
SymbolCount             .equ SemanticBufferLimit+$0B
NextLocalSlot           .equ SemanticBufferLimit+$0C
NextProgramSlot         .equ SemanticBufferLimit+$0D
SymbolTableBase         .equ SemanticBufferLimit+$0E
SymbolEntrySize         .equ 6
SymbolCapacity          .equ 6
SymbolTableLimit        .equ SymbolTableBase+SymbolEntrySize*SymbolCapacity

; Expression metadata is deliberately explicit in the correctness build.
; A bounded stack retains the left operand of recursive expression parses;
; each entry is metadata plus a constant value word. The later compression
; pass may overlay this state once its liveness has been measured.
ExpressionExpectedType  .equ SymbolTableLimit+$00
ExpressionEmitEnabled   .equ SymbolTableLimit+$01
ExpressionSuppressFault .equ SymbolTableLimit+$02
ExpressionStackDepth    .equ SymbolTableLimit+$03
ExpressionRightMeta     .equ SymbolTableLimit+$04
ExpressionRightValue    .equ SymbolTableLimit+$05
ExpressionLeftMeta      .equ SymbolTableLimit+$07
ExpressionLeftValue     .equ SymbolTableLimit+$08
ExpressionOperator      .equ SymbolTableLimit+$0A
ExpressionOperatorOffset .equ SymbolTableLimit+$0B
DeclarationInfo         .equ SymbolTableLimit+$0D
DeclarationPayload      .equ SymbolTableLimit+$0E
DeclarationNamePointer  .equ SymbolTableLimit+$10
DeclarationNameLength   .equ SymbolTableLimit+$12
ExpressionCallOffset    .equ SymbolTableLimit+$13
DeclarationNamePosition .equ SymbolTableLimit+$15
ExpressionStackBase     .equ SymbolTableLimit+$1B
ExpressionStackCapacity .equ 16
ExpressionStackEntrySize .equ 7
ExpressionStackLimit    .equ ExpressionStackBase+ExpressionStackCapacity*ExpressionStackEntrySize

; Boolean short-circuit emission retains one forward patch per nesting level.
EmitBooleanFixupDepth   .equ ExpressionStackLimit+$00
EmitBooleanFixupBase    .equ ExpressionStackLimit+$01
EmitBooleanFixupCapacity .equ 16
EmitBooleanFixupLimit   .equ EmitBooleanFixupBase+EmitBooleanFixupCapacity*2
CompilerWorkspaceEnd    .equ EmitBooleanFixupLimit

; Emission follows successful parsing and may overlay the retained forward.
SemanticReadCursor      .equ ForwardNamePointer
EmitRoutineAddress      .equ ForwardParameterPointer
EmitRoutineCallFixup    .equ ForwardParameterLength
EmitIfFixup             .equ ForwardOrdinal

TokenEof                .equ 0
TokenNewline            .equ 1
TokenName               .equ 2
TokenCharacter          .equ 3
TokenNumber             .equ 4
TokenLeftParen          .equ 5
TokenRightParen         .equ 6
TokenEquals             .equ 7
TokenSub                .equ 8
TokenFails              .equ 9
TokenOr                 .equ 10
TokenFail               .equ 11
TokenEnd                .equ 12
TokenVar                .equ 13
TokenAs                 .equ 14
TokenU8                 .equ 15
TokenFor                .equ 16
TokenUntil              .equ 17
TokenLeftBracket        .equ 18
TokenRightBracket       .equ 19
TokenComma              .equ 20
TokenForward            .equ 21
TokenReturn             .equ 22
TokenIf                 .equ 23
TokenMinus              .equ 24
TokenPlus               .equ 25
TokenStar               .equ 26
TokenU16                .equ 27
TokenBoolean            .equ 28
TokenTrue               .equ 29
TokenFalse              .equ 30
TokenConst              .equ 31
TokenSlash              .equ 32
TokenLess               .equ 33
TokenLessEqual          .equ 34
TokenGreater            .equ 35
TokenGreaterEqual       .equ 36
TokenNotEqual           .equ 37
TokenNot                .equ 38
TokenAnd                .equ 39

DiagnosticNone          .equ 0
DiagnosticLexical       .equ 1
DiagnosticExpectedMain  .equ 17
DiagnosticExpectedWrite .equ 22
DiagnosticExpectedIndex .equ 29
DiagnosticActiveCounter .equ 36
DiagnosticExpectedTopLevel .equ 37
DiagnosticExpectedBytes .equ 38
DiagnosticExpectedArrayLength .equ 39
DiagnosticSinkCapacity  .equ 40
DiagnosticFixupRange    .equ 41
DiagnosticExpectedRead  .equ 45
DiagnosticExpectedValue .equ 51
DiagnosticExpectedResult .equ 52
DiagnosticForwardMismatch .equ 53
DiagnosticForwardIncomplete .equ 54
DiagnosticDuplicateName .equ 55
DiagnosticSymbolCapacity .equ 56
DiagnosticUnknownName   .equ 57
DiagnosticExpectedScalar .equ 58
DiagnosticExpectedType .equ 59
DiagnosticTypeMismatch .equ 60
DiagnosticIntegerRange .equ 61
DiagnosticDivisionZero .equ 62
DiagnosticNarrowing    .equ 63
DiagnosticComparisonChain .equ 64
DiagnosticExpressionCapacity .equ 65
DiagnosticBooleanFixupCapacity .equ 66
DiagnosticInternalOperation .equ 67

; Ordinary token mismatches encode the token ordinal directly. Named-value
; mismatches retain their context-specific diagnostic codes above.
DiagnosticExpectedTokenBase .equ $80
DiagnosticExpectedEof   .equ DiagnosticExpectedTokenBase+TokenEof
DiagnosticExpectedLine  .equ DiagnosticExpectedTokenBase+TokenNewline
DiagnosticExpectedChar  .equ DiagnosticExpectedTokenBase+TokenCharacter
DiagnosticExpectedNumber .equ DiagnosticExpectedTokenBase+TokenNumber
DiagnosticExpectedLeft  .equ DiagnosticExpectedTokenBase+TokenLeftParen
DiagnosticExpectedRight .equ DiagnosticExpectedTokenBase+TokenRightParen
DiagnosticExpectedEqual .equ DiagnosticExpectedTokenBase+TokenEquals
DiagnosticExpectedSub   .equ DiagnosticExpectedTokenBase+TokenSub
DiagnosticExpectedFails .equ DiagnosticExpectedTokenBase+TokenFails
DiagnosticExpectedOr    .equ DiagnosticExpectedTokenBase+TokenOr
DiagnosticExpectedFail  .equ DiagnosticExpectedTokenBase+TokenFail
DiagnosticExpectedEnd   .equ DiagnosticExpectedTokenBase+TokenEnd
DiagnosticExpectedVar   .equ DiagnosticExpectedTokenBase+TokenVar
DiagnosticExpectedAs    .equ DiagnosticExpectedTokenBase+TokenAs
DiagnosticExpectedU8    .equ DiagnosticExpectedTokenBase+TokenU8
DiagnosticExpectedFor   .equ DiagnosticExpectedTokenBase+TokenFor
DiagnosticExpectedUntil .equ DiagnosticExpectedTokenBase+TokenUntil
DiagnosticExpectedLeftBracket .equ DiagnosticExpectedTokenBase+TokenLeftBracket
DiagnosticExpectedRightBracket .equ DiagnosticExpectedTokenBase+TokenRightBracket
DiagnosticExpectedComma .equ DiagnosticExpectedTokenBase+TokenComma
DiagnosticExpectedForward .equ DiagnosticExpectedTokenBase+TokenForward
DiagnosticExpectedReturn .equ DiagnosticExpectedTokenBase+TokenReturn
DiagnosticExpectedIf    .equ DiagnosticExpectedTokenBase+TokenIf
DiagnosticExpectedMinus .equ DiagnosticExpectedTokenBase+TokenMinus
DiagnosticExpectedPlus  .equ DiagnosticExpectedTokenBase+TokenPlus
DiagnosticExpectedStar  .equ DiagnosticExpectedTokenBase+TokenStar

ScalarTypeExact         .equ 0
ScalarTypeU8            .equ 1
ScalarTypeU16           .equ 2
ScalarTypeBoolean       .equ 3
ScalarMetaTypeMask      .equ $03
ScalarMetaConstant      .equ $80

SymbolClassConstant     .equ $00
SymbolClassProgram      .equ $04
SymbolClassLocal        .equ $08
SymbolClassMask         .equ $0C

SymbolInfoConstantU8    .equ SymbolClassConstant+ScalarTypeU8
SymbolInfoConstantU16   .equ SymbolClassConstant+ScalarTypeU16
SymbolInfoConstantBoolean .equ SymbolClassConstant+ScalarTypeBoolean
SymbolInfoProgramU8     .equ SymbolClassProgram+ScalarTypeU8
SymbolInfoProgramU16    .equ SymbolClassProgram+ScalarTypeU16
SymbolInfoProgramBoolean .equ SymbolClassProgram+ScalarTypeBoolean
SymbolInfoLocalU8       .equ SymbolClassLocal+ScalarTypeU8
SymbolInfoLocalU16      .equ SymbolClassLocal+ScalarTypeU16
SymbolInfoLocalBoolean  .equ SymbolClassLocal+ScalarTypeBoolean

SemanticDeclareU8       .equ 1
SemanticForUntilU8      .equ 2
SemanticWriteOutputByte .equ 3
SemanticPropagate       .equ 4
SemanticEndLoop         .equ 5
SemanticReturn          .equ 6
SemanticStaticU8Array   .equ 7
SemanticReadInputByte   .equ 8
SemanticStoreResultU8   .equ 9
SemanticLoadArrayU8     .equ 10
SemanticWriteOutputU8   .equ 11
SemanticCallLiteralU8   .equ 12
SemanticWriteLocalU8    .equ 13
SemanticBeginForwardU8  .equ 14
SemanticIfParameterZero .equ 15
SemanticReturnParameter .equ 16
SemanticEndIf           .equ 17
SemanticReturnSelfMinus .equ 18
SemanticEndRoutine      .equ 19
SemanticDefineProgramU8 .equ 20
SemanticBeginMain       .equ 21
SemanticDeclareLocalU8  .equ 22
SemanticLiteralU8       .equ 23
SemanticLoadProgramU8   .equ 24
SemanticLoadLocalU8     .equ 25
SemanticMultiplyU8      .equ 26
SemanticAddU8           .equ 27
SemanticStoreProgramU8  .equ 28
SemanticStoreLocalU8    .equ 29
SemanticWriteValueU8    .equ 30
SemanticEndMain         .equ 31
SemanticDefineProgram16 .equ 32
SemanticDeclareLocal16  .equ 33
SemanticLiteral16       .equ 34
SemanticLoadProgram16   .equ 35
SemanticLoadLocal16     .equ 36
SemanticAdd8            .equ 37
SemanticAdd16           .equ 38
SemanticSubtract8       .equ 39
SemanticSubtract16      .equ 40
SemanticMultiply8       .equ 41
SemanticMultiply16      .equ 42
SemanticDivide8         .equ 43
SemanticDivide16        .equ 44
SemanticNegate8         .equ 45
SemanticNegate16        .equ 46
SemanticNot8            .equ 47
SemanticNot16           .equ 48
SemanticNotBoolean      .equ 49
SemanticAnd8            .equ 50
SemanticAnd16           .equ 51
SemanticOr8             .equ 52
SemanticOr16            .equ 53
SemanticCompare8        .equ 54
SemanticCompare16       .equ 55
SemanticCompareBoolean  .equ 56
SemanticNarrowU8        .equ 57
SemanticStoreProgram16  .equ 58
SemanticStoreLocal16    .equ 59
SemanticBeginBooleanAnd .equ 60
SemanticBeginBooleanOr  .equ 61
SemanticEndBoolean      .equ 62

ComparisonEqual         .equ 0
ComparisonNotEqual      .equ 1
ComparisonLess          .equ 2
ComparisonLessEqual     .equ 3
ComparisonGreater       .equ 4
ComparisonGreaterEqual  .equ 5
