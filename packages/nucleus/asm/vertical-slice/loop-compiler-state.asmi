; Fixed compiler state for the scalar-local, counted-loop, and array slice.

CompilerStateBase       .equ CompilerWorkBase

SourcePartId            .equ CompilerStateBase+$00
SourceCursor            .equ CompilerStateBase+$01
SourceEnd               .equ CompilerStateBase+$03
SourceOffset            .equ CompilerStateBase+$05
SourceLine              .equ CompilerStateBase+$07
SourceColumn            .equ CompilerStateBase+$09
SourceLineHasToken       .equ CompilerStateBase+$0B
SourceDelimiterDepth    .equ CompilerStateBase+$0C
TokenizerEofPending     .equ CompilerStateBase+$0D

TokenKind               .equ CompilerStateBase+$0E
TokenValue              .equ CompilerStateBase+$0F
TokenStartOffset        .equ CompilerStateBase+$10
TokenStartLine          .equ CompilerStateBase+$12
TokenStartColumn        .equ CompilerStateBase+$14
TokenLexemePointer      .equ CompilerStateBase+$16
TokenLength             .equ CompilerStateBase+$18

DiagnosticCode          .equ CompilerStateBase+$19
DiagnosticPartId        .equ CompilerStateBase+$1A
DiagnosticOffset        .equ CompilerStateBase+$1B
DiagnosticLine          .equ CompilerStateBase+$1D
DiagnosticColumn        .equ CompilerStateBase+$1F

; A diagnostic ends parsing, so the live semantic sink may reuse the eventual
; offset and line fields. DiagnosticCode and DiagnosticPartId remain clear on
; successful compilation; an error overwrites all reused bytes before return.
SinkCursor              .equ CompilerStateBase+$1B
SinkOperationCount      .equ CompilerStateBase+$1D

; Emission begins only after parsing succeeds. Its scratch words therefore
; overlay dead source, token, diagnostic, and sink fields. SourcePartId and
; TokenStartOffset..TokenStartColumn remain intact for an emitter diagnostic.
GeneratedSize           .equ CompilerStateBase+$01
EmitCursor              .equ CompilerStateBase+$03
EmitCodeStart           .equ CompilerStateBase+$05
EmitLoopHead            .equ CompilerStateBase+$07
EmitExitFixup           .equ CompilerStateBase+$09
EmitFailureFixup        .equ CompilerStateBase+$0B
EmitUpdateExitFixup     .equ CompilerStateBase+$0D
EmitPatchAddress        .equ CompilerStateBase+$16
EmitLimit               .equ CompilerStateBase+$18
EmitDataFixup           .equ CompilerStateBase+$1A

CompilerStateEnd        .equ CompilerStateBase+$1E
SemanticBufferBase      .equ CompilerStateEnd
SemanticBufferLimit     .equ SemanticBufferBase+$0E
CompilerWorkspaceEnd    .equ SemanticBufferLimit

TokenEof                .equ 0
TokenNewline            .equ 1
TokenName               .equ 2
TokenCharacter          .equ 3
TokenNumber             .equ 4
TokenLeftParen          .equ 5
TokenRightParen         .equ 6
TokenEquals             .equ 7
TokenSub                .equ 8
TokenFails              .equ 9
TokenOr                 .equ 10
TokenFail               .equ 11
TokenEnd                .equ 12
TokenVar                .equ 13
TokenAs                 .equ 14
TokenU8                 .equ 15
TokenFor                .equ 16
TokenUntil              .equ 17
TokenLeftBracket        .equ 18
TokenRightBracket       .equ 19
TokenComma              .equ 20

DiagnosticNone          .equ 0
DiagnosticLexical       .equ 1
DiagnosticExpectedSub   .equ 16
DiagnosticExpectedMain  .equ 17
DiagnosticExpectedLeft  .equ 18
DiagnosticExpectedRight .equ 19
DiagnosticExpectedFails .equ 20
DiagnosticExpectedLine  .equ 21
DiagnosticExpectedWrite .equ 22
DiagnosticExpectedChar  .equ 23
DiagnosticExpectedOr    .equ 24
DiagnosticExpectedFail  .equ 25
DiagnosticExpectedEnd   .equ 26
DiagnosticExpectedEof   .equ 27
DiagnosticExpectedVar   .equ 28
DiagnosticExpectedIndex .equ 29
DiagnosticExpectedAs    .equ 30
DiagnosticExpectedU8    .equ 31
DiagnosticExpectedEqual .equ 32
DiagnosticExpectedNumber .equ 33
DiagnosticExpectedFor   .equ 34
DiagnosticExpectedUntil .equ 35
DiagnosticActiveCounter .equ 36
DiagnosticExpectedTopLevel .equ 37
DiagnosticExpectedBytes .equ 38
DiagnosticExpectedArrayLength .equ 39
DiagnosticSinkCapacity  .equ 40
DiagnosticFixupRange    .equ 41
DiagnosticExpectedLeftBracket .equ 42
DiagnosticExpectedRightBracket .equ 43
DiagnosticExpectedComma .equ 44
DiagnosticExpectedRead  .equ 45

SemanticDeclareU8       .equ 1
SemanticForUntilU8      .equ 2
SemanticWriteOutputByte .equ 3
SemanticPropagate       .equ 4
SemanticEndLoop         .equ 5
SemanticReturn          .equ 6
SemanticStaticU8Array   .equ 7
SemanticReadInputByte   .equ 8
SemanticStoreResultU8   .equ 9
SemanticLoadArrayU8     .equ 10
SemanticWriteOutputU8   .equ 11
