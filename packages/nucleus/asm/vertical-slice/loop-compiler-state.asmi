; Fixed compiler state for the scalar-local, counted-loop, and array slice.

CompilerStateBase       .equ CompilerWorkBase

SourcePartId            .equ CompilerStateBase+$00
SourceCursor            .equ CompilerStateBase+$01
SourceEnd               .equ CompilerStateBase+$03
SourceOffset            .equ CompilerStateBase+$05
SourceLine              .equ CompilerStateBase+$07
SourceColumn            .equ CompilerStateBase+$09
SourceLineHasToken       .equ CompilerStateBase+$0B
SourceDelimiterDepth    .equ CompilerStateBase+$0C

TokenStartOffset        .equ CompilerStateBase+$0D
TokenStartLine          .equ CompilerStateBase+$0F
TokenStartColumn        .equ CompilerStateBase+$11
TokenLexemePointer      .equ CompilerStateBase+$13
TokenLength             .equ CompilerStateBase+$15

DiagnosticCode          .equ CompilerStateBase+$16
DiagnosticPartId        .equ CompilerStateBase+$17
DiagnosticOffset        .equ CompilerStateBase+$18
DiagnosticLine          .equ CompilerStateBase+$1A
DiagnosticColumn        .equ CompilerStateBase+$1C

; A diagnostic ends parsing, so the live semantic sink may reuse the eventual
; offset and line fields. DiagnosticCode and DiagnosticPartId remain clear on
; successful compilation; an error overwrites all reused bytes before return.
; The high byte of DiagnosticLine and both bytes of DiagnosticColumn extend
; past CompilerStateEnd into the dead semantic buffer. The diagnostic is
; terminal, so no semantic byte remains live.
SinkCursor              .equ CompilerStateBase+$18
SinkOperationCount      .equ CompilerStateBase+$1A

; Emission begins only after parsing succeeds. Its scratch words therefore
; overlay dead source, token, diagnostic, and sink fields. SourcePartId and
; TokenStartOffset..TokenStartColumn remain intact for an emitter diagnostic.
GeneratedSize           .equ CompilerStateBase+$01
EmitCursor              .equ CompilerStateBase+$03
EmitCodeStart           .equ CompilerStateBase+$05
EmitLoopHead            .equ CompilerStateBase+$07
EmitExitFixup           .equ CompilerStateBase+$09
EmitFailureFixup        .equ CompilerStateBase+$0B
EmitUpdateExitFixup     .equ CompilerStateBase+$19
EmitPatchAddress        .equ CompilerStateBase+$13
EmitLimit               .equ CompilerStateBase+$15
EmitDataFixup           .equ CompilerStateBase+$17

CompilerStateEnd        .equ CompilerStateBase+$1B
SemanticBufferBase      .equ CompilerStateEnd
SemanticBufferLimit     .equ SemanticBufferBase+$10

; One retained forward signature is enough for the first routine-call slice.
; The source bytes remain stable, so exact names are retained as pointer/length
; pairs rather than copied into another buffer.
ForwardNamePointer      .equ SemanticBufferLimit+$00
ForwardNameLength       .equ SemanticBufferLimit+$02
ForwardParameterPointer .equ SemanticBufferLimit+$03
ForwardParameterLength  .equ SemanticBufferLimit+$05
ForwardOrdinal          .equ SemanticBufferLimit+$06
ForwardCompleted        .equ SemanticBufferLimit+$07
CompilerWorkspaceEnd    .equ SemanticBufferLimit+$08

; Emission follows successful parsing and may overlay the retained forward.
SemanticReadCursor      .equ ForwardNamePointer
EmitRoutineAddress      .equ ForwardParameterPointer
EmitRoutineCallFixup    .equ ForwardParameterLength
EmitIfFixup             .equ ForwardOrdinal

TokenEof                .equ 0
TokenNewline            .equ 1
TokenName               .equ 2
TokenCharacter          .equ 3
TokenNumber             .equ 4
TokenLeftParen          .equ 5
TokenRightParen         .equ 6
TokenEquals             .equ 7
TokenSub                .equ 8
TokenFails              .equ 9
TokenOr                 .equ 10
TokenFail               .equ 11
TokenEnd                .equ 12
TokenVar                .equ 13
TokenAs                 .equ 14
TokenU8                 .equ 15
TokenFor                .equ 16
TokenUntil              .equ 17
TokenLeftBracket        .equ 18
TokenRightBracket       .equ 19
TokenComma              .equ 20
TokenForward            .equ 21
TokenReturn             .equ 22
TokenIf                 .equ 23
TokenMinus              .equ 24

DiagnosticNone          .equ 0
DiagnosticLexical       .equ 1
DiagnosticExpectedMain  .equ 17
DiagnosticExpectedWrite .equ 22
DiagnosticExpectedIndex .equ 29
DiagnosticActiveCounter .equ 36
DiagnosticExpectedTopLevel .equ 37
DiagnosticExpectedBytes .equ 38
DiagnosticExpectedArrayLength .equ 39
DiagnosticSinkCapacity  .equ 40
DiagnosticFixupRange    .equ 41
DiagnosticExpectedRead  .equ 45
DiagnosticExpectedValue .equ 51
DiagnosticExpectedResult .equ 52
DiagnosticForwardMismatch .equ 53
DiagnosticForwardIncomplete .equ 54

; Ordinary token mismatches encode the token ordinal directly. Named-value
; mismatches retain their context-specific diagnostic codes above.
DiagnosticExpectedTokenBase .equ $80
DiagnosticExpectedEof   .equ DiagnosticExpectedTokenBase+TokenEof
DiagnosticExpectedLine  .equ DiagnosticExpectedTokenBase+TokenNewline
DiagnosticExpectedChar  .equ DiagnosticExpectedTokenBase+TokenCharacter
DiagnosticExpectedNumber .equ DiagnosticExpectedTokenBase+TokenNumber
DiagnosticExpectedLeft  .equ DiagnosticExpectedTokenBase+TokenLeftParen
DiagnosticExpectedRight .equ DiagnosticExpectedTokenBase+TokenRightParen
DiagnosticExpectedEqual .equ DiagnosticExpectedTokenBase+TokenEquals
DiagnosticExpectedSub   .equ DiagnosticExpectedTokenBase+TokenSub
DiagnosticExpectedFails .equ DiagnosticExpectedTokenBase+TokenFails
DiagnosticExpectedOr    .equ DiagnosticExpectedTokenBase+TokenOr
DiagnosticExpectedFail  .equ DiagnosticExpectedTokenBase+TokenFail
DiagnosticExpectedEnd   .equ DiagnosticExpectedTokenBase+TokenEnd
DiagnosticExpectedVar   .equ DiagnosticExpectedTokenBase+TokenVar
DiagnosticExpectedAs    .equ DiagnosticExpectedTokenBase+TokenAs
DiagnosticExpectedU8    .equ DiagnosticExpectedTokenBase+TokenU8
DiagnosticExpectedFor   .equ DiagnosticExpectedTokenBase+TokenFor
DiagnosticExpectedUntil .equ DiagnosticExpectedTokenBase+TokenUntil
DiagnosticExpectedLeftBracket .equ DiagnosticExpectedTokenBase+TokenLeftBracket
DiagnosticExpectedRightBracket .equ DiagnosticExpectedTokenBase+TokenRightBracket
DiagnosticExpectedComma .equ DiagnosticExpectedTokenBase+TokenComma
DiagnosticExpectedForward .equ DiagnosticExpectedTokenBase+TokenForward
DiagnosticExpectedReturn .equ DiagnosticExpectedTokenBase+TokenReturn
DiagnosticExpectedIf    .equ DiagnosticExpectedTokenBase+TokenIf
DiagnosticExpectedMinus .equ DiagnosticExpectedTokenBase+TokenMinus

SemanticDeclareU8       .equ 1
SemanticForUntilU8      .equ 2
SemanticWriteOutputByte .equ 3
SemanticPropagate       .equ 4
SemanticEndLoop         .equ 5
SemanticReturn          .equ 6
SemanticStaticU8Array   .equ 7
SemanticReadInputByte   .equ 8
SemanticStoreResultU8   .equ 9
SemanticLoadArrayU8     .equ 10
SemanticWriteOutputU8   .equ 11
SemanticCallLiteralU8   .equ 12
SemanticWriteLocalU8    .equ 13
SemanticBeginForwardU8  .equ 14
SemanticIfParameterZero .equ 15
SemanticReturnParameter .equ 16
SemanticEndIf           .equ 17
SemanticReturnSelfMinus .equ 18
SemanticEndRoutine      .equ 19
