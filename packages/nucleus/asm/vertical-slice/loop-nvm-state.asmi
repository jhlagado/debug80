; Writable state for the counted-loop NVM proof target.

NvmStateBase            .equ ExecutionBase
NvmImagePointer         .equ NvmStateBase+$00
NvmCodePointer          .equ NvmStateBase+$02
NvmPc                   .equ NvmStateBase+$04
NvmInstructionStart     .equ NvmStateBase+$06
NvmSlots                .equ NvmStateBase+$08
NvmSlotsEnd             .equ NvmSlots+$0C
NvmArgument0            .equ NvmSlotsEnd
NvmArgumentMask         .equ NvmArgument0+$02
NvmCompletion           .equ NvmArgumentMask+$02
NvmError                .equ NvmCompletion+$01
NvmRunState             .equ NvmError+$01
NvmTrapNumber           .equ NvmRunState+$01
NvmTrapRoutine          .equ NvmTrapNumber+$01
NvmTrapOffset           .equ NvmTrapRoutine+$01
NvmTrapError            .equ NvmTrapOffset+$02
NvmStateEnd             .equ NvmTrapError+$01

NvmCompletionNone       .equ 0
NvmCompletionSuccess    .equ 1
NvmCompletionFailure    .equ 3

NvmRunReady             .equ 1
NvmRunSucceeded         .equ 2
NvmRunTrapped           .equ 3
NvmRunInvalid           .equ 4

ServiceFailureCall      .equ ServiceBase+$00
ServiceCallCount        .equ ServiceBase+$01
ServiceOutputLength     .equ ServiceBase+$02
ServiceOutputBase       .equ ServiceBase+$03
ServiceOutputCapacity   .equ 4
ServiceStateEnd         .equ ServiceOutputBase+ServiceOutputCapacity

NvmImageSize            .equ 96
NvmCodeOffset           .equ 42
NvmCodeSize             .equ 54
NvmClobberCount         .equ 6
GeneratedImageEnd       .equ GeneratedBase+NvmImageSize
