; Writable state for the direct-Z80 counted-loop proof target.

NativeStateBase         .equ ExecutionBase
NativeRunState          .equ NativeStateBase+$00
NativeTrapNumber        .equ NativeStateBase+$01
NativeTrapRoutine       .equ NativeStateBase+$02
NativeTrapOffset        .equ NativeStateBase+$03
NativeTrapError         .equ NativeStateBase+$05
NativeActivationDepth   .equ NativeStateBase+$06
NativeActivationLimit   .equ NativeStateBase+$07
NativeScalarSlot        .equ NativeStateBase+$08
NativeActivationArena   .equ NativeStateBase+$09
NativeActivationCapacity .equ 8
NativeStateEnd          .equ NativeActivationArena+NativeActivationCapacity

NativeRunReady          .equ 1
NativeRunSucceeded      .equ 2
NativeRunTrapped        .equ 3

ServiceFailureCall      .equ ServiceBase+$00
ServiceCallCount        .equ ServiceBase+$01
ServiceOutputLength     .equ ServiceBase+$02
ServiceOutputBase       .equ ServiceBase+$03
ServiceOutputCapacity   .equ 4
ServiceInputLength      .equ ServiceBase+$07
ServiceInputCursor      .equ ServiceBase+$08
ServiceInputFailure     .equ ServiceBase+$09
ServiceInputBase        .equ ServiceBase+$0A
ServiceInputCapacity    .equ 4
ServiceStateEnd         .equ ServiceInputBase+ServiceInputCapacity

NativeProgramSize       .equ 54
NativeLoopFailureOffset .equ 30
GeneratedNativeEnd      .equ GeneratedBase+NativeProgramSize

NativeArrayProgramSize  .equ 74
NativeArrayInputFailureOffset .equ 0
NativeArrayBoundsOffset .equ 10
NativeArrayOutputFailureOffset .equ 22
GeneratedArrayEnd       .equ GeneratedBase+NativeArrayProgramSize

NativeCallProgramSize   .equ 99
GeneratedCallEnd        .equ GeneratedBase+NativeCallProgramSize
