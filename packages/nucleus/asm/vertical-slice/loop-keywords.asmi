; Compact variable-length keyword table followed by parser-only names.

KeywordTable:
            .db  3,"var",TokenVar
            .db  2,"as",TokenAs
            .db  2,"u8",TokenU8
            .db  3,"u16",TokenU16
            .db  7,"boolean",TokenBoolean
            .db  4,"true",TokenTrue
            .db  5,"false",TokenFalse
            .db  5,"const",TokenConst
            .db  2,"or",TokenOr
            .db  3,"and",TokenAnd
            .db  3,"not",TokenNot
            .db  4,"fail",TokenFail
            .db  3,"end",TokenEnd
            .db  3,"sub",TokenSub
            .db  5,"fails",TokenFails
            .db  3,"for",TokenFor
            .db  5,"until",TokenUntil
            .db  7,"forward",TokenForward
            .db  6,"return",TokenReturn
            .db  2,"if",TokenIf
            .db  6,"elseif",TokenElseIf
            .db  4,"else",TokenElse
            .db  5,"while",TokenWhile
            .db  2,"to",TokenTo
            .db  4,"step",TokenStep
            .db  4,"exit",TokenExit
            .db  8,"continue",TokenContinue
KeywordCount            .equ 28

PunctuationTable:
            .db  "=",TokenEquals
            .db  ",",TokenComma
            .db  "-",TokenMinus
            .db  "+",TokenPlus
            .db  "*",TokenStar
            .db  "/",TokenSlash
PunctuationCount        .equ 6

NameMain:               .db "main"
NameIndex:              .db "index"
NameBytes:              .db "bytes"
NameReadInputByte:      .db "readInputByte"
NameWriteOutputByte:    .db "writeOutputByte"
NameResult:             .db "result"
