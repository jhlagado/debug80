; Compact variable-length keyword table followed by parser-only names.

KeywordTable:
            .db  3,"var",TokenVar
            .db  2,"as",TokenAs
            .db  2,"u8",TokenU8
            .db  2,"or",TokenOr
            .db  4,"fail",TokenFail
            .db  3,"end",TokenEnd
            .db  3,"sub",TokenSub
            .db  5,"fails",TokenFails
            .db  3,"for",TokenFor
            .db  5,"until",TokenUntil
            .db  7,"forward",TokenForward
            .db  6,"return",TokenReturn
            .db  2,"if",TokenIf
KeywordCount            .equ 13

PunctuationTable:
            .db  "=",TokenEquals
            .db  ",",TokenComma
            .db  "-",TokenMinus
PunctuationCount        .equ 3

NameMain:               .db "main"
NameIndex:              .db "index"
NameBytes:              .db "bytes"
NameReadInputByte:      .db "readInputByte"
NameWriteOutputByte:    .db "writeOutputByte"
NameDescend:            .db "descend"
NameValue:              .db "value"
NameResult:             .db "result"
