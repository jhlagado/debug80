Stage7CallDepthSource:
            .db "record Box",10
            .db "value as u8",10
            .db "end",10
            .db "var box as Box",10
            .db "sub keep(item as Box) as Box",10
            .db "return item",10
            .db "end",10
            .db "sub main()",10
            .db "keep(keep(keep(keep(keep(box)))))",10
            .db "end",10
