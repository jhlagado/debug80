            .org ProofBase
.routine out carry,zero clobbers sign,parity,halfCarry,A,BC,DE,HL,IX,IY
ProofStart:
            LD   SP,StackTop
            XOR  A
            LD   (ProofStatus),A
            LD   (ProofCase),A
            LD   A,160
            LD   HL,Stage7LL1ConstantSource
            LD   DE,Stage7LL1ConstantSourceEnd
            CALL CompileAggregateCallSlice
            JP   C,ProofConstantCompileFailure
            CALL EncodeAggregateProgram
            JP   C,ProofConstantEncodeFailure
            CALL Reset
            CALL ProofCallGenerated
            JP   C,ProofConstantFrameFailure
            LD   A,(RunState)
            CP   RunSucceeded
            JP   NZ,ProofConstantRunFailure
            LD   A,(ServiceOutputLength)
            CP   1
            JP   NZ,ProofConstantOutputFailure
            LD   A,(ServiceOutputBase)
            CP   2
            JP   NZ,ProofConstantOutputFailure
            LD   A,160
            LD   HL,Stage7ParserCoverageSource
            LD   DE,Stage7ParserCoverageSourceEnd
            CALL CompileAggregateCallSlice
            JR   C,ProofCompileFailure
            CALL EncodeAggregateProgram
            JR   C,ProofEncodeFailure
            LD   HL,(GeneratedSize)
            LD   (ProofGeneratedSize),HL
            CALL Reset
            CALL ProofCallGenerated
            JR   C,ProofFrameFailure
            LD   A,(RunState)
            CP   RunSucceeded
            JR   NZ,ProofRunFailure
            LD   A,(ServiceOutputLength)
            CP   1
            JR   NZ,ProofOutputFailure
            LD   A,(ServiceOutputBase)
            CP   9
            JR   NZ,ProofOutputFailure
            LD   A,(ProgramDataBase+1)
            CP   3
            JR   NZ,ProofOutputFailure
            LD   A,(ProgramDataBase+2)
            OR   A
            JR   NZ,ProofOutputFailure
            LD   A,(ProgramDataBase+3)
            OR   A
            JR   NZ,ProofOutputFailure
            LD   A,$A5
            LD   (ProofStatus),A
            HALT

ProofCompileFailure:
            LD   A,1
            JR   ProofFailed
ProofEncodeFailure:
            LD   A,2
            JR   ProofFailed
ProofFrameFailure:
            LD   A,3
            JR   ProofFailed
ProofRunFailure:
            LD   A,4
            JR   ProofFailed
ProofOutputFailure:
            LD   A,5
            JR   ProofFailed
ProofConstantCompileFailure:
            LD   A,6
            JR   ProofFailed
ProofConstantEncodeFailure:
            LD   A,7
            JR   ProofFailed
ProofConstantFrameFailure:
            LD   A,8
            JR   ProofFailed
ProofConstantRunFailure:
            LD   A,9
            JR   ProofFailed
ProofConstantOutputFailure:
            LD   A,10
ProofFailed:
            LD   (ProofCase),A
            HALT

; The generated program must restore both the root hardware stack and IX.
.routine out A,carry,zero clobbers sign,parity,halfCarry,BC,DE,HL,IX,IY
ProofCallGenerated:
            LD   HL,0
            ADD  HL,SP
            LD   (ProofExpectedSP),HL
            LD   IX,$A55A
            CALL GeneratedBase
            PUSH IX
            POP  DE
            LD   HL,$A55A
            OR   A
            SBC  HL,DE
            JR   NZ,ProofCallGeneratedFailure
            LD   HL,0
            ADD  HL,SP
            LD   DE,(ProofExpectedSP)
            OR   A
            SBC  HL,DE
            RET  Z
ProofCallGeneratedFailure:
            SCF
            RET

ProofExpectedSP:   .dw 0
ProofGeneratedSize: .dw 0
ProofStatus:        .db 0
ProofCase:          .db 0
ProofEnd:
