; Packed aggregate-call and Stage 8 routine state. Four direct routine entries,
; sixteen retained parameter positions, and four nested parser call frames are
; bounded independently. Source bytes remain resident, so names use
; pointer/length pairs. Types are the Stage 6 one-byte ordinals.

STG7STTB             EQU AGGRGTW0 ;@NUC-GLOBAL Stage7StateBase PERMANENT STG7STTB
STG7RTNC          EQU STG7STTB+$00 ;@NUC-GLOBAL Stage7RoutineCount PERMANENT STG7RTNC
STG7PRM0        EQU STG7STTB+$01 ;@NUC-GLOBAL Stage7ParameterCount PERMANENT STG7PRM0
STG7CRR1        EQU STG7STTB+$02 ;@NUC-GLOBAL Stage7CurrentRoutine PERMANENT STG7CRR1
STG7CRR2     EQU STG7STTB+$03 ;@NUC-GLOBAL Stage7CurrentResultType PERMANENT STG7CRR2
STG7CRR3 EQU STG7STTB+$04 ;@NUC-GLOBAL Stage7CurrentParameterStart PERMANENT STG7CRR3
STG7CRR4 EQU STG7STTB+$05 ;@NUC-GLOBAL Stage7CurrentParameterCount PERMANENT STG7CRR4
STG7GLBL     EQU STG7STTB+$06 ;@NUC-GLOBAL Stage7GlobalSymbolCount PERMANENT STG7GLBL
STG7PTHT              EQU STG7STTB+$07 ;@NUC-GLOBAL Stage7PathType PERMANENT STG7PTHT
STG7PTHE            EQU STG7STTB+$08  ;@NUC-GLOBAL Stage7PathExtent PERMANENT STG7PTHE; word
STG7PTHO            EQU STG7STTB+$0A  ;@NUC-GLOBAL Stage7PathOffset PERMANENT STG7PTHO; word
STG7ARGM         EQU STG7STTB+$0C ;@NUC-GLOBAL Stage7ArgumentIndex PERMANENT STG7ARGM
STG7ARG0         EQU STG7STTB+$0D ;@NUC-GLOBAL Stage7ArgumentCount PERMANENT STG7ARG0
STG7CLLR        EQU STG7STTB+$0E ;@NUC-GLOBAL Stage7CallResultType PERMANENT STG7CLLR
STG7CLLL             EQU STG7STTB+$0F ;@NUC-GLOBAL Stage7CallLabel PERMANENT STG7CLLL
STG7CLLO            EQU STG7STTB+$10 ;@NUC-GLOBAL Stage7CallOffset PERMANENT STG7CLLO
STG7CLLD             EQU STG7STTB+$12 ;@NUC-GLOBAL Stage7CallDepth PERMANENT STG7CLLD
STG7CRR5          EQU STG7STTB+$13 ;@NUC-GLOBAL Stage7CurrentFlags PERMANENT STG7CRR5
STG8FLRO         EQU STG7STTB+$14 ;@NUC-GLOBAL Stage8FailureOffset PERMANENT STG8FLRO
STG8DRCT        EQU STG7STTB+$16 ;@NUC-GLOBAL Stage8DirectFailable PERMANENT STG8DRCT
STG8CLLM       EQU STG7STTB+$17 ;@NUC-GLOBAL Stage8CallModePointer PERMANENT STG8CLLM
STG8FRWR      EQU STG7STTB+$19 ;@NUC-GLOBAL Stage8ForwardMainFlags PERMANENT STG8FRWR
; Number of already-evaluated destination carriers below a failable result.
; A local handler discards these before entering its statement body.
STG8RTND      EQU STG7STTB+$1A ;@NUC-GLOBAL Stage8RetainedCarriers PERMANENT STG8RTND
; These values span expression parsing, so nested calls must not overlay them.
STG8SRVC             EQU STG7STTB+$1B ;@NUC-GLOBAL Stage8ServiceId PERMANENT STG8SRVC
STG8CLLF             EQU STG7STTB+$1C ;@NUC-GLOBAL Stage8CallFlags PERMANENT STG8CLLF
STG7STTE              EQU STG7STTB+$1D ;@NUC-GLOBAL Stage7StateEnd PERMANENT STG7STTE

STG7RTNT      EQU STG7STTE ;@NUC-GLOBAL Stage7RoutineTableBase PERMANENT STG7RTNT
STG7RTNE      EQU 8 ;@NUC-GLOBAL Stage7RoutineEntrySize PERMANENT STG7RTNE
STG7RTN0       EQU 4 ;@NUC-GLOBAL Stage7RoutineCapacity PERMANENT STG7RTN0
STG7RTN1     EQU STG7RTNT+STG7RTNE*STG7RTN0 ;@NUC-GLOBAL Stage7RoutineTableLimit PERMANENT STG7RTN1
STG7RTNN    EQU 0 ;@NUC-GLOBAL Stage7RoutineNamePointer PERMANENT STG7RTNN
STG7RTN2     EQU 2 ;@NUC-GLOBAL Stage7RoutineNameLength PERMANENT STG7RTN2
STG7RTNP EQU 3 ;@NUC-GLOBAL Stage7RoutineParameterStart PERMANENT STG7RTNP
STG7RTN3 EQU 4 ;@NUC-GLOBAL Stage7RoutineParameterCount PERMANENT STG7RTN3
STG7RTNR     EQU 5 ;@NUC-GLOBAL Stage7RoutineResultType PERMANENT STG7RTNR
STG7RTNL          EQU 6 ;@NUC-GLOBAL Stage7RoutineLabel PERMANENT STG7RTNL
STG7RTNF          EQU 7 ;@NUC-GLOBAL Stage7RoutineFlags PERMANENT STG7RTNF

STG7PRM1    EQU STG7RTN1 ;@NUC-GLOBAL Stage7ParameterTableBase PERMANENT STG7PRM1
STG7PRM2    EQU 4 ;@NUC-GLOBAL Stage7ParameterEntrySize PERMANENT STG7PRM2
STG7PRM3     EQU 16 ;@NUC-GLOBAL Stage7ParameterCapacity PERMANENT STG7PRM3
STG7PRM4   EQU STG7PRM1+STG7PRM2*STG7PRM3 ;@NUC-GLOBAL Stage7ParameterTableLimit PERMANENT STG7PRM4
STG7PRM5  EQU 0 ;@NUC-GLOBAL Stage7ParameterNamePointer PERMANENT STG7PRM5
STG7PRM6   EQU 2 ;@NUC-GLOBAL Stage7ParameterNameLength PERMANENT STG7PRM6
STG7PRM7         EQU 3 ;@NUC-GLOBAL Stage7ParameterType PERMANENT STG7PRM7

STG7CLL1         EQU STG7PRM4 ;@NUC-GLOBAL Stage7CallFrameBase PERMANENT STG7CLL1
STG7CLL2         EQU 8 ;@NUC-GLOBAL Stage7CallFrameSize PERMANENT STG7CLL2
STG7CLL3     EQU 4 ;@NUC-GLOBAL Stage7CallFrameCapacity PERMANENT STG7CLL3
STG7CLL4        EQU STG7CLL1+STG7CLL2*STG7CLL3 ;@NUC-GLOBAL Stage7CallFrameLimit PERMANENT STG7CLL4
STG7CLL5        EQU 0 ;@NUC-GLOBAL Stage7CallFrameLabel PERMANENT STG7CLL5
STG7CLL6       EQU 1 ;@NUC-GLOBAL Stage7CallFrameResult PERMANENT STG7CLL6
STG7CLL7    EQU 2 ;@NUC-GLOBAL Stage7CallFrameParameter PERMANENT STG7CLL7
STG7CLL8    EQU 3 ;@NUC-GLOBAL Stage7CallFrameRemaining PERMANENT STG7CLL8
STG7CLL9 EQU 4 ;@NUC-GLOBAL Stage7CallFrameArgumentCount PERMANENT STG7CLL9
STG7CLLA       EQU 5 ;@NUC-GLOBAL Stage7CallFrameOffset PERMANENT STG7CLLA
STG7CLLB        EQU 7 ;@NUC-GLOBAL Stage7CallFrameFlags PERMANENT STG7CLLB

STG7CMPL  EQU STG7CLL4 ;@NUC-GLOBAL Stage7CompilerWorkspaceEnd PERMANENT STG7CMPL

; The memory-backed multipart adapter retains only the next external
; descriptor, the number of later source parts, and a pending boundary-newline
; flag. Source bytes and the descriptor table remain outside compiler
; workspace. Part ordinals are byte-sized and come from the active descriptor.
SRCPRTDS  EQU STG7CMPL ;@NUC-GLOBAL SourcePartDescriptorCursor PERMANENT SRCPRTDS
SRCPRTSR        EQU SRCPRTDS+2 ;@NUC-GLOBAL SourcePartsRemaining PERMANENT SRCPRTSR
SRCPRTPN    EQU SRCPRTSR+1 ;@NUC-GLOBAL SourcePartPendingNewline PERMANENT SRCPRTPN
SRCMLTPR EQU SRCPRTPN+1 ;@NUC-GLOBAL SourceMultipartWorkspaceEnd PERMANENT SRCMLTPR
SRCPRTD0    EQU 5 ;@NUC-GLOBAL SourcePartDescriptorSize PERMANENT SRCPRTD0
SRCPRTCP          EQU 255 ;@NUC-GLOBAL SourcePartCapacity PERMANENT SRCPRTCP

; Emission begins only after parsing has published the semantic transcript, so
; its consecutive call fields overlay the no-longer-live declaration prefix.
STG8EMT0         EQU STG7STTB ;@NUC-GLOBAL Stage8EmitFieldBase PERMANENT STG8EMT0
STG8EMTC         EQU STG8EMT0+$00 ;@NUC-GLOBAL Stage8EmitCallFlags PERMANENT STG8EMTC
STG8EMTR        EQU STG8EMT0+$01 ;@NUC-GLOBAL Stage8EmitResultType PERMANENT STG8EMTR
STG8EMT1          EQU STG8EMT0+$02 ;@NUC-GLOBAL Stage8EmitCallMode PERMANENT STG8EMT1
STG8EMTH      EQU STG8EMT0+$03 ;@NUC-GLOBAL Stage8EmitHandlerLabel PERMANENT STG8EMTH
STG8EMT2  EQU STG8EMT0+$04 ;@NUC-GLOBAL Stage8EmitRetainedCarriers PERMANENT STG8EMT2

STG7RTN4      EQU 28 ;@NUC-GLOBAL Stage7RoutineLabelBase PERMANENT STG7RTN4
; Label 27 is the callable body of main. The startup wrapper calls this label
; just like a source call, while labels 28..31 retain ordinary routines.
STG7MNLB             EQU 27 ;@NUC-GLOBAL Stage7MainLabel PERMANENT STG7MNLB
STG7CNTR     EQU STG7MNLB ;@NUC-GLOBAL Stage7ControlLabelLimit PERMANENT STG7CNTR
STG7MNRT           EQU $FE ;@NUC-GLOBAL Stage7MainRoutine PERMANENT STG7MNRT
STG7NORS              EQU 0 ;@NUC-GLOBAL Stage7NoResult PERMANENT STG7NORS
STG7RTN5          EQU 1 ;@NUC-GLOBAL Stage7RoutineFails PERMANENT STG7RTN5
STG7RTNM           EQU 2 ;@NUC-GLOBAL Stage7RoutineMain PERMANENT STG7RTNM
STG8RTNI     EQU 4 ;@NUC-GLOBAL Stage8RoutineIncomplete PERMANENT STG8RTNI
; Target bank ordinals occupy unused routine/symbol metadata bits. The first
; banked profile is deliberately bounded to four banks.
TRGTBNKC          EQU 4 ;@NUC-GLOBAL TargetBankCapacity PERMANENT TRGTBNKC
TRGTBNKS             EQU 4 ;@NUC-GLOBAL TargetBankShift PERMANENT TRGTBNKS
TRGTBNKM              EQU $30 ;@NUC-GLOBAL TargetBankMask PERMANENT TRGTBNKM

STG8CLL0       EQU 0 ;@NUC-GLOBAL Stage8CallModeInfallible PERMANENT STG8CLL0
STG8CLL1 EQU 1 ;@NUC-GLOBAL Stage8CallModePropagateRoutine PERMANENT STG8CLL1
STG8CLL2    EQU 2 ;@NUC-GLOBAL Stage8CallModePropagateMain PERMANENT STG8CLL2
STG8CLL3           EQU 3 ;@NUC-GLOBAL Stage8CallModeHandle PERMANENT STG8CLL3

; Stage 7 semantic operations extend the dense production dispatch range.
SMNTCBGN EQU 82 ;@NUC-GLOBAL SemanticBeginGeneralRoutine PERMANENT SMNTCBGN
SMNTCBND       EQU 83 ;@NUC-GLOBAL SemanticBindParameter PERMANENT SMNTCBND
SMNTCCLL         EQU 84 ;@NUC-GLOBAL SemanticCallGeneral PERMANENT SMNTCCLL
SMNTCRTR     EQU 85 ;@NUC-GLOBAL SemanticReturnAggregate PERMANENT SMNTCRTR
SMNTCEND   EQU 86 ;@NUC-GLOBAL SemanticEndGeneralRoutine PERMANENT SMNTCEND
SMNTCLDP    EQU 87 ;@NUC-GLOBAL SemanticLoadProgramAlias PERMANENT SMNTCLDP
SMNTCLD0  EQU 88 ;@NUC-GLOBAL SemanticLoadParameterAlias PERMANENT SMNTCLD0
SMNTCSLC         EQU 89 ;@NUC-GLOBAL SemanticSelectField PERMANENT SMNTCSLC
SMNTCSL0         EQU 90 ;@NUC-GLOBAL SemanticSelectIndex PERMANENT SMNTCSL0
SMNTCLDI       EQU 91 ;@NUC-GLOBAL SemanticLoadIndirect8 PERMANENT SMNTCLDI
SMNTCLD1      EQU 92 ;@NUC-GLOBAL SemanticLoadIndirect16 PERMANENT SMNTCLD1
SMNTCSTR      EQU 93 ;@NUC-GLOBAL SemanticStoreIndirect8 PERMANENT SMNTCSTR
SMNTCST0     EQU 94 ;@NUC-GLOBAL SemanticStoreIndirect16 PERMANENT SMNTCST0
SMNTCCPY       EQU 95 ;@NUC-GLOBAL SemanticCopyAggregate PERMANENT SMNTCCPY
SMNTCST1        EQU 96 ;@NUC-GLOBAL SemanticStringLength PERMANENT SMNTCST1
SMNTCST2         EQU 97 ;@NUC-GLOBAL SemanticStringIndex PERMANENT SMNTCST2
SMNTCFLR         EQU 98 ;@NUC-GLOBAL SemanticFailRoutine PERMANENT SMNTCFLR
SMNTCFLM            EQU 99 ;@NUC-GLOBAL SemanticFailMain PERMANENT SMNTCFLM
SMNTCRT0 EQU 100 ;@NUC-GLOBAL SemanticReturnFailableScalar PERMANENT SMNTCRT0
SMNTCRT1 EQU 101 ;@NUC-GLOBAL SemanticReturnFailableAggregate PERMANENT SMNTCRT1
SMNTCEN0  EQU 102 ;@NUC-GLOBAL SemanticEndFailableRoutine PERMANENT SMNTCEN0
SMNTCSKP          EQU 103 ;@NUC-GLOBAL SemanticSkipHandler PERMANENT SMNTCSKP
SMNTCBG0         EQU 104 ;@NUC-GLOBAL SemanticBeginHandler PERMANENT SMNTCBG0
SMNTCEN1           EQU 105 ;@NUC-GLOBAL SemanticEndHandler PERMANENT SMNTCEN1
SMNTCBG1    EQU 106 ;@NUC-GLOBAL SemanticBeginCallableMain PERMANENT SMNTCBG1
SMNTCLDR    EQU 107 ;@NUC-GLOBAL SemanticLoadReadOnlyAlias PERMANENT SMNTCLDR

STG8SRV0       EQU 0 ;@NUC-GLOBAL Stage8ServiceReadInput PERMANENT STG8SRV0
STG8SRV1     EQU 1 ;@NUC-GLOBAL Stage8ServiceWriteOutput PERMANENT STG8SRV1
STG8SRV2     EQU 2 ;@NUC-GLOBAL Stage8ServiceReadStorage PERMANENT STG8SRV2
STG8SRV3   EQU 3 ;@NUC-GLOBAL Stage8ServiceRewindStorage PERMANENT STG8SRV3
STG8SRV4    EQU 4 ;@NUC-GLOBAL Stage8ServiceWriteStorage PERMANENT STG8SRV4
STG8SRV5     EQU 5 ;@NUC-GLOBAL Stage8ServiceSeekStorage PERMANENT STG8SRV5
STG8PRDF EQU 6 ;@NUC-GLOBAL Stage8PredefinedConstantBase PERMANENT STG8PRDF

; One completed call selector carries the target kind, successful-result
; retention choice, and dense target ID. Source labels occupy 27..31 and
; service IDs occupy 0..5, so both fit without widening the transcript.
STG8CLLB    EQU $80 ;@NUC-GLOBAL Stage8CallableServiceFlag PERMANENT STG8CLLB
STG8CLL4       EQU $40 ;@NUC-GLOBAL Stage8CallableKeepFlag PERMANENT STG8CLL4
STG8CLL5     EQU $3F ;@NUC-GLOBAL Stage8CallableSourceMask PERMANENT STG8CLL5
STG8CLL6    EQU $07 ;@NUC-GLOBAL Stage8CallableServiceMask PERMANENT STG8CLL6

; Service selectors use their otherwise-free middle bits for the fixed
; signature: optional scalar parameter type in bits 3..4 and a successful u8
; result in bit 5. Every service is failable.
STG8SRV6    EQU $18 ;@NUC-GLOBAL Stage8ServiceArgumentMask PERMANENT STG8SRV6
STG8SRV7     EQU $10 ;@NUC-GLOBAL Stage8ServiceArgumentU16 PERMANENT STG8SRV7
STG8SRV8        EQU $20 ;@NUC-GLOBAL Stage8ServiceResultU8 PERMANENT STG8SRV8

DGNSTCRT  EQU 84 ;@NUC-GLOBAL DiagnosticRoutineCapacity PERMANENT DGNSTCRT
DGNSTCPR EQU 85 ;@NUC-GLOBAL DiagnosticParameterCapacity PERMANENT DGNSTCPR
DGNSTCTR   EQU 86 ;@NUC-GLOBAL DiagnosticTransientAlias PERMANENT DGNSTCTR
DGNSTCFL   EQU 87 ;@NUC-GLOBAL DiagnosticFailureContext PERMANENT DGNSTCFL
DGNSTCSR EQU 88 ;@NUC-GLOBAL DiagnosticSourcePartCapacity PERMANENT DGNSTCSR
