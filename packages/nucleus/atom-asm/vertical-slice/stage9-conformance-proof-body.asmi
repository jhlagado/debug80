;@ROUTINE IN A,BC OUT A,CARRY,ZERO CLOBBERS SIGN,PARITY,HALFCARRY,BC,DE,HL
.L0000H:
            LD   (PRFEXPC8),A
            LD   (PRFEXPC3),BC
            LD   A,(RunState)
            CP   RNTRPPD
            JR   NZ,.L0000F
            LD   A,(PRFEXPC8)
            LD   HL,TRPNMBR
            CP   (HL)
            JR   NZ,.L0000F
            LD   HL,(TRPOFFST)
            LD   DE,(PRFEXPC3)
            OR   A
            SBC  HL,DE
            JR   NZ,.L0000F
            LD   A,(ACTVTNDP)
            OR   A
            RET  Z
            SCF
            RET

; Generated code must restore the root SP and IX on every terminal path.
;@ROUTINE OUT A,CARRY,ZERO CLOBBERS SIGN,PARITY,HALFCARRY,BC,DE,HL,IX,IY
PRFCLLGN: ;@NUC-GLOBAL ProofCallGenerated PERMANENT PRFCLLGN
            LD   HL,0
            ADD  HL,SP
            LD   (PRFEXPC0),HL
            LD   IX,$A55A
            CALL GNRTDBS
            PUSH IX
            POP  DE
            LD   HL,$A55A
            OR   A
            SBC  HL,DE
            JR   NZ,PRFCLLG1
            LD   HL,0
            ADD  HL,SP
            LD   DE,(PRFEXPC0)
            OR   A
            SBC  HL,DE
            RET  Z
PRFCLLG1: ;@NUC-GLOBAL ProofCallGeneratedFailure PERMANENT PRFCLLG1
            SCF
            RET

PRFCMPLF: LD A,1 ;@NUC-GLOBAL ProofCompileFailure PERMANENT PRFCMPLF
                     JR PRFFLD
PRFENCDF:  LD A,2 ;@NUC-GLOBAL ProofEncodeFailure PERMANENT PRFENCDF
                     JR PRFFLD
PRFRNFLR:     LD A,3 ;@NUC-GLOBAL ProofRunFailure PERMANENT PRFRNFLR
PRFFLD: ;@NUC-GLOBAL ProofFailed PERMANENT PRFFLD
            LD   (PRFCS),A
            HALT

PRFEXPC0: DW 0 ;@NUC-GLOBAL ProofExpectedSP PERMANENT PRFEXPC0
PRFEXPC3: DW 0 ;@NUC-GLOBAL ProofExpectedOffset PERMANENT PRFEXPC3
PRFEXPC8: DB 0 ;@NUC-GLOBAL ProofExpectedTrap PERMANENT PRFEXPC8
PRFMXGNR: DW 0 ;@NUC-GLOBAL ProofMaxGenerated PERMANENT PRFMXGNR
PRFMXGN0: DW 0 ;@NUC-GLOBAL ProofMaxGeneratedCode PERMANENT PRFMXGN0
PRFMXGN1: DW 0 ;@NUC-GLOBAL ProofMaxGeneratedRoData PERMANENT PRFMXGN1
PRFMXGN2: DW 0 ;@NUC-GLOBAL ProofMaxGeneratedData PERMANENT PRFMXGN2
PRFMXGN3: DW 0 ;@NUC-GLOBAL ProofMaxGeneratedBss PERMANENT PRFMXGN3
PRFEXPC5: DB 0 ;@NUC-GLOBAL ProofExpectedDiagnostic PERMANENT PRFEXPC5
PRFEXPC9: DB 0 ;@NUC-GLOBAL ProofExpectedPart PERMANENT PRFEXPC9
PRFPRTCN: DB 0 ;@NUC-GLOBAL ProofPartCount PERMANENT PRFPRTCN
PRFSTTS:     DB 0 ;@NUC-GLOBAL ProofStatus PERMANENT PRFSTTS
PRFCS:       DB 0 ;@NUC-GLOBAL ProofCase PERMANENT PRFCS
ProofEnd:
