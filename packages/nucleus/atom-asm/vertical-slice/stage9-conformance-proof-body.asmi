;@ROUTINE IN A,DE,HL OUT A,CARRY,ZERO CLOBBERS SIGN,PARITY,HALFCARRY,BC,DE,HL,IX,IY
.L00000:
            CALL CMPLAGG0
            RET  C
            CALL ENCDAGGR
            RET  C
            JR   .L00002

;@ROUTINE IN A,DE,HL OUT A,CARRY,ZERO CLOBBERS SIGN,PARITY,HALFCARRY,BC,DE,HL,IX,IY
.L00001:
            CALL .L00000
            RET  C
            CALL .L0000D
            JP   PRFCLLGN

;@ROUTINE OUT A,CARRY,ZERO CLOBBERS SIGN,PARITY,HALFCARRY,BC,DE,HL
.L00002:
            LD   HL,(GNRTDSZ)
            LD   DE,(GNRTDROD)
            ADD  HL,DE
            LD   B,H
            LD   C,L
            LD   DE,(PRFMXGNR)
            OR   A
            SBC  HL,DE
            JR   C,.L00003
            JR   Z,.L00003
            LD   H,B
            LD   L,C
            LD   (PRFMXGNR),HL
            LD   HL,(GNRTDSZ)
            LD   (PRFMXGN0),HL
            LD   HL,(GNRTDROD)
            LD   (PRFMXGN1),HL
            LD   HL,(GNRTDDTS)
            LD   (PRFMXGN2),HL
            LD   HL,(GNRTDBSS)
            LD   (PRFMXGN3),HL
.L00003:
            XOR  A
            RET

; The just-published image must match the preceding image retained by
; BeginProgram. This directly proves that a successful assert contributes no
; semantic operation or generated byte.
;@ROUTINE OUT A,CARRY,ZERO CLOBBERS SIGN,PARITY,HALFCARRY,BC,DE,HL
.L00004:
            LD   HL,(GNRTDSZ)
            LD   DE,(PBLSHDSZ)
            OR   A
            SBC  HL,DE
            JR   NZ,.L00008
            LD   HL,(GNRTDROD)
            LD   DE,(PBLSHDRO)
            OR   A
            SBC  HL,DE
            JR   NZ,.L00008
            LD   HL,(GNRTDDTS)
            LD   DE,(PBLSHDDT)
            OR   A
            SBC  HL,DE
            JR   NZ,.L00008
            LD   HL,(GNRTDBSS)
            LD   DE,(PBLSHDBS)
            OR   A
            SBC  HL,DE
            JR   NZ,.L00008
            LD   BC,(GNRTDSZ)
            LD   HL,GNRTDBS
            LD   DE,BCKPBS
.L00005:
            LD   A,B
            OR   C
            JR   Z,.L00006
            LD   A,(DE)
            CP   (HL)
            JR   NZ,.L00008
            INC  DE
            INC  HL
            DEC  BC
            JR   .L00005
.L00006:
            LD   BC,(GNRTDROD)
            LD   HL,GNRTDRO0
            LD   DE,S9BRDO
.L00007:
            LD   A,B
            OR   C
            RET  Z
            LD   A,(DE)
            CP   (HL)
            JR   NZ,.L00008
            INC  DE
            INC  HL
            DEC  BC
            JR   .L00007
.L00008:
            SCF
            RET

;@ROUTINE IN A,B,DE,HL,IX OUT A,CARRY,ZERO CLOBBERS SIGN,PARITY,HALFCARRY,BC,DE,HL,IX,IY
.L00009:
            LD   (PRFEXPC9),A
            LD   A,B
            LD   (PRFEXPC5),A
            PUSH IX
            POP  BC
            LD   (PRFEXPC3),BC
            LD   A,(PRFEXPC9)
            CALL CMPLAGG0
            JR   NC,.L0000C
            JR   .L0000B

;@ROUTINE IN A,B,C,HL,IX OUT A,CARRY,ZERO CLOBBERS SIGN,PARITY,HALFCARRY,BC,DE,HL,IX,IY
.L0000A:
            LD   (PRFPRTCN),A
            LD   A,B
            LD   (PRFEXPC5),A
            LD   A,C
            LD   (PRFEXPC9),A
            PUSH IX
            POP  BC
            LD   (PRFEXPC3),BC
            LD   A,(PRFPRTCN)
            CALL CMPLAGGR
            JR   NC,.L0000C
.L0000B:
            LD   A,(PRFEXPC5)
            LD   HL,DGNSTCCD
            CP   (HL)
            JR   NZ,.L0000C
            LD   A,(PRFEXPC9)
            LD   HL,DGNSTCP0
            CP   (HL)
            JR   NZ,.L0000C
            LD   HL,(DGNSTCOF)
            LD   DE,(PRFEXPC3)
            OR   A
            SBC  HL,DE
            RET  Z
.L0000C:
            SCF
            RET

;@ROUTINE OUT A,CARRY,ZERO CLOBBERS SIGN,PARITY,HALFCARRY,B,C,HL
.L0000D:
            CALL Reset
            XOR  A
            LD   (SRVCINPT),A
            LD   (SRVCSTRG),A
            RET

;@ROUTINE IN A OUT A,CARRY,ZERO CLOBBERS SIGN,PARITY,HALFCARRY,B,HL
.L0000E:
            LD   B,A
            LD   A,(RunState)
            CP   RNSCCDD
            JR   NZ,.L0000F
            LD   A,(SRVCOTPT)
            CP   1
            JR   NZ,.L0000F
            LD   A,(SRVCOTP0)
            CP   B
            JR   NZ,.L0000F
            LD   A,(ACTVTNDP)
            OR   A
            RET  Z
.L0000F:
            SCF
            RET

;@ROUTINE OUT A,CARRY,ZERO CLOBBERS SIGN,PARITY,HALFCARRY,HL
.L0000G:
