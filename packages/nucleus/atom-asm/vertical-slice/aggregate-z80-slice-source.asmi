            ORG SRCBS
AGGRGTAC: ;@NUC-GLOBAL AggregateAcceptedSource PERMANENT AGGRGTAC
            DB "record Pixel",10
            DB "r as u8",10
            DB "g as u8",10
            DB "b as u8",10
            DB "end",10
            DB "record Entry",10
            DB "id as u16",10
            DB "color as Pixel",10
            DB "label as string[4]",10
            DB "samples as u8[3]",10
            DB "end",10
            DB "var zero as Entry",10
            DB "var one as Entry = (513,(1,2,3),\"A\\xAf\",[4,5,6])",10
            DB "var many as Entry[2] = ["
            DB "(1,(7,8,9),\"xy\",[10,11,12]),"
            DB "(2,(13,14,15),\"\",[16,17,18])]",10
            DB "sub main() fails",10
            DB "end",10
AGGRGTA0: ;@NUC-GLOBAL AggregateAcceptedSourceEnd PERMANENT AGGRGTA0

AGGRGTCN: ;@NUC-GLOBAL AggregateCountSource PERMANENT AGGRGTCN
            DB "record Pair",10,"left as u8",10,"right as u8",10,"end",10
            DB "var bad as Pair = (1)",10
.L00000:
            DB "sub main() fails",10,"end",10
AGGRGTC2: ;@NUC-GLOBAL AggregateCountSourceEnd PERMANENT AGGRGTC2

AGGRGTSH: ;@NUC-GLOBAL AggregateShapeSource PERMANENT AGGRGTSH
            DB "record Pair",10,"left as u8",10,"right as u8",10,"end",10
            DB "var bad as Pair = [1,2]",10
AGGRGTS1: ;@NUC-GLOBAL AggregateShapeSourceEnd PERMANENT AGGRGTS1

AGGRGTTM: ;@NUC-GLOBAL AggregateTooManySource PERMANENT AGGRGTTM
            DB "record Pair",10,"left as u8",10,"right as u8",10,"end",10
            DB "var bad as Pair = (1,2,3)",10
AGGRGTT2: ;@NUC-GLOBAL AggregateTooManySourceEnd PERMANENT AGGRGTT2

AGGRGTCL: ;@NUC-GLOBAL AggregateCloseShapeSource PERMANENT AGGRGTCL
