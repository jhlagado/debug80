            DB "var bad as Pair = (1,2]",10
AGGRGTC3: ;@NUC-GLOBAL AggregateCloseShapeSourceEnd PERMANENT AGGRGTC3

AGGRGTT3: ;@NUC-GLOBAL AggregateTypeSource PERMANENT AGGRGTT3
