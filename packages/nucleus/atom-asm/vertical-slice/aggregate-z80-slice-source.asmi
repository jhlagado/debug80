AGGRGTT4: ;@NUC-GLOBAL AggregateTypeSourceEnd PERMANENT AGGRGTT4

AGGRGTR0: ;@NUC-GLOBAL AggregateRecordNameScalarSource PERMANENT AGGRGTR0
            DB "record R",10,"v as u8",10,"end",10
            DB "sub main() fails",10
            DB "writeOutputByte(R) else fail",10
            DB "end",10
AGGRGTR1: ;@NUC-GLOBAL AggregateRecordNameScalarSourceEnd PERMANENT AGGRGTR1

AGGRGTOB: ;@NUC-GLOBAL AggregateObjectScalarSource PERMANENT AGGRGTOB
            DB "record R",10,"v as u8",10,"end",10
            DB "var item as R",10
            DB "sub main() fails",10
            DB "writeOutputByte(item) else fail",10
            DB "end",10
AGGRGTO0: ;@NUC-GLOBAL AggregateObjectScalarSourceEnd PERMANENT AGGRGTO0

AGGRGTO1: ;@NUC-GLOBAL AggregateObjectAssignmentSource PERMANENT AGGRGTO1
            DB "record R",10,"v as u8",10,"end",10
            DB "var item as R",10
            DB "sub main() fails",10
            DB "item = 1",10
            DB "end",10
AGGRGTO2: ;@NUC-GLOBAL AggregateObjectAssignmentSourceEnd PERMANENT AGGRGTO2

AGGRGTR2: ;@NUC-GLOBAL AggregateRecordStepSource PERMANENT AGGRGTR2
            DB "record R",10,"v as u8",10,"end",10
            DB "sub main() fails",10
            DB "var i as u8 = 0",10
            DB "for i = 0 until 10 step "
.L00000:
            DB "R",10
            DB "end",10,"end",10
AGGRGTR3: ;@NUC-GLOBAL AggregateRecordStepSourceEnd PERMANENT AGGRGTR3

AGGRGTDP: ;@NUC-GLOBAL AggregateDuplicateFieldSource PERMANENT AGGRGTDP
            DB "record R",10,"first as u8",10
.L00000:
            DB "first as u16",10,"end",10
AGGRGTD0: ;@NUC-GLOBAL AggregateDuplicateFieldSourceEnd PERMANENT AGGRGTD0

AGGRGTS2: ;@NUC-GLOBAL AggregateStringLengthSource PERMANENT AGGRGTS2
            DB "var bad as string[2] = \"abc\"",10
AGGRGTS3: ;@NUC-GLOBAL AggregateStringLengthSourceEnd PERMANENT AGGRGTS3

AGGRGTBL: ;@NUC-GLOBAL AggregateBooleanSource PERMANENT AGGRGTBL
            DB "record Flags",10
            DB "off as boolean",10,"enabled as boolean",10,"end",10
            DB "var flags as Flags = (false,true)",10
            DB "sub main() fails",10,"end",10
AGGRGTB0: ;@NUC-GLOBAL AggregateBooleanSourceEnd PERMANENT AGGRGTB0

AGGRGTID: ;@NUC-GLOBAL AggregateIdentitySource PERMANENT AGGRGTID
