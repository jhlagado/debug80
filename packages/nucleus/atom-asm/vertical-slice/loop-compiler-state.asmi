; Fixed compiler state for the scalar-local, counted-loop, and array slice.

CMPLRSTT       EQU CMPLRWR0 ;@NUC-GLOBAL CompilerStateBase PERMANENT CMPLRSTT

SRCPRTID            EQU CMPLRSTT+$00 ;@NUC-GLOBAL SourcePartId PERMANENT SRCPRTID
SRCCRSR            EQU CMPLRSTT+$01 ;@NUC-GLOBAL SourceCursor PERMANENT SRCCRSR
SRCEND               EQU CMPLRSTT+$03 ;@NUC-GLOBAL SourceEnd PERMANENT SRCEND
SRCOFFST            EQU CMPLRSTT+$05 ;@NUC-GLOBAL SourceOffset PERMANENT SRCOFFST
SRCLN              EQU CMPLRSTT+$07 ;@NUC-GLOBAL SourceLine PERMANENT SRCLN
SRCCLMN            EQU CMPLRSTT+$09 ;@NUC-GLOBAL SourceColumn PERMANENT SRCCLMN
SRCLNHST       EQU CMPLRSTT+$0B ;@NUC-GLOBAL SourceLineHasToken PERMANENT SRCLNHST
SRCDLMTR    EQU CMPLRSTT+$0C ;@NUC-GLOBAL SourceDelimiterDepth PERMANENT SRCDLMTR

TKNSTRTO        EQU CMPLRSTT+$0D ;@NUC-GLOBAL TokenStartOffset PERMANENT TKNSTRTO
TKNSTRTL          EQU CMPLRSTT+$0F ;@NUC-GLOBAL TokenStartLine PERMANENT TKNSTRTL
TKNSTRTC        EQU CMPLRSTT+$11 ;@NUC-GLOBAL TokenStartColumn PERMANENT TKNSTRTC
TKNLXMPN      EQU CMPLRSTT+$13 ;@NUC-GLOBAL TokenLexemePointer PERMANENT TKNLXMPN
TKNLNGTH             EQU CMPLRSTT+$15 ;@NUC-GLOBAL TokenLength PERMANENT TKNLNGTH

DGNSTCCD          EQU CMPLRSTT+$16 ;@NUC-GLOBAL DiagnosticCode PERMANENT DGNSTCCD
DGNSTCP0        EQU CMPLRSTT+$17 ;@NUC-GLOBAL DiagnosticPartId PERMANENT DGNSTCP0
DGNSTCOF        EQU CMPLRSTT+$18 ;@NUC-GLOBAL DiagnosticOffset PERMANENT DGNSTCOF
DGNSTCLN          EQU CMPLRSTT+$1A ;@NUC-GLOBAL DiagnosticLine PERMANENT DGNSTCLN
DGNSTCCL        EQU CMPLRSTT+$1C ;@NUC-GLOBAL DiagnosticColumn PERMANENT DGNSTCCL

; A diagnostic ends parsing, so the live semantic sink may reuse the eventual
; offset and line fields. DiagnosticCode and DiagnosticPartId remain clear on
; successful compilation; an error overwrites all reused bytes before return.
; The high byte of DiagnosticLine and both bytes of DiagnosticColumn extend
; past CompilerStateEnd into the dead semantic buffer. The diagnostic is
; terminal, so no semantic byte remains live.
SNKCRSR              EQU CMPLRSTT+$18 ;@NUC-GLOBAL SinkCursor PERMANENT SNKCRSR
SNKOPRTN      EQU CMPLRSTT+$1A ;@NUC-GLOBAL SinkOperationCount PERMANENT SNKOPRTN

; Emission begins only after parsing succeeds. Its scratch words therefore
; overlay dead source, token, diagnostic, and sink fields. SourcePartId and
; TokenStartOffset..TokenStartColumn remain intact for an emitter diagnostic.
EMTCRSR              EQU CMPLRSTT+$03 ;@NUC-GLOBAL EmitCursor PERMANENT EMTCRSR
EMTCDSTR           EQU CMPLRSTT+$05 ;@NUC-GLOBAL EmitCodeStart PERMANENT EMTCDSTR
EMTLPHD            EQU CMPLRSTT+$07 ;@NUC-GLOBAL EmitLoopHead PERMANENT EMTLPHD
EMTEXTFX           EQU CMPLRSTT+$09 ;@NUC-GLOBAL EmitExitFixup PERMANENT EMTEXTFX
EMTFLRFX        EQU CMPLRSTT+$0B ;@NUC-GLOBAL EmitFailureFixup PERMANENT EMTFLRFX
EMTUPDTE     EQU CMPLRSTT+$19 ;@NUC-GLOBAL EmitUpdateExitFixup PERMANENT EMTUPDTE
EMTPTCHA        EQU CMPLRSTT+$13 ;@NUC-GLOBAL EmitPatchAddress PERMANENT EMTPTCHA
EMTLMT               EQU CMPLRSTT+$15 ;@NUC-GLOBAL EmitLimit PERMANENT EMTLMT
EMTDTFXP           EQU CMPLRSTT+$17 ;@NUC-GLOBAL EmitDataFixup PERMANENT EMTDTFXP

CMPLRST0        EQU CMPLRSTT+$1B ;@NUC-GLOBAL CompilerStateEnd PERMANENT CMPLRST0
SMNTCBFF      EQU CMPLRST0 ;@NUC-GLOBAL SemanticBufferBase PERMANENT SMNTCBFF
; The leading byte is an operation count and the remaining 511 bytes are a
; bounded variable-width transcript. Word aggregate operands must not make the
; complete Chapter 21 program depend on the retired byte-extent encoding.
SMNTCBF0     EQU SMNTCBFF+$200 ;@NUC-GLOBAL SemanticBufferLimit PERMANENT SMNTCBF0

; One retained forward signature is enough for the first routine-call slice.
; The source bytes remain stable, so exact names are retained as pointer/length
; pairs rather than copied into another buffer.
FRWRDNMP      EQU SMNTCBF0+$00 ;@NUC-GLOBAL ForwardNamePointer PERMANENT FRWRDNMP
FRWRDNML       EQU SMNTCBF0+$02 ;@NUC-GLOBAL ForwardNameLength PERMANENT FRWRDNML
FRWRDPRM EQU SMNTCBF0+$03 ;@NUC-GLOBAL ForwardParameterPointer PERMANENT FRWRDPRM
FRWRDPR0  EQU SMNTCBF0+$05 ;@NUC-GLOBAL ForwardParameterLength PERMANENT FRWRDPR0
FRWRDORD          EQU SMNTCBF0+$06 ;@NUC-GLOBAL ForwardOrdinal PERMANENT FRWRDORD
FRWRDCMP        EQU SMNTCBF0+$07 ;@NUC-GLOBAL ForwardCompleted PERMANENT FRWRDCMP
FRWRDPR1    EQU SMNTCBF0+$08 ;@NUC-GLOBAL ForwardParameterType PERMANENT FRWRDPR1
FRWRDRSL       EQU SMNTCBF0+$09 ;@NUC-GLOBAL ForwardResultType PERMANENT FRWRDRSL

; The predictive expression path keeps one token of lookahead. $FF denotes an
; empty lookahead cell; token ordinals occupy the low half of the byte range.
PRSRLKHD     EQU SMNTCBF0+$0A ;@NUC-GLOBAL ParserLookaheadKind PERMANENT PRSRLKHD
PRSRLKH0    EQU SMNTCBF0+$0B ;@NUC-GLOBAL ParserLookaheadValue PERMANENT PRSRLKH0

; Source bytes remain resident through compilation, so a scalar symbol keeps
; the exact spelling as a pointer and length instead of copying name bytes.
; The entry at SymbolCount is provisional until the declaration initializer
; succeeds; lookup sees only the committed prefix.
SYMBLCNT             EQU SMNTCBF0+$0D ;@NUC-GLOBAL SymbolCount PERMANENT SYMBLCNT
NXTLCLSL           EQU SMNTCBF0+$0E ;@NUC-GLOBAL NextLocalSlot PERMANENT NXTLCLSL
NXTPRGRM         EQU SMNTCBF0+$0F ;@NUC-GLOBAL NextProgramSlot PERMANENT NXTPRGRM
SYMBLTBL         EQU SMNTCBF0+$10 ;@NUC-GLOBAL SymbolTableBase PERMANENT SYMBLTBL
SYMBLENT         EQU 6 ;@NUC-GLOBAL SymbolEntrySize PERMANENT SYMBLENT
SYMBLCPC          EQU 16 ;@NUC-GLOBAL SymbolCapacity PERMANENT SYMBLCPC
SYMBLTB0        EQU SYMBLTBL+SYMBLENT*SYMBLCPC ;@NUC-GLOBAL SymbolTableLimit PERMANENT SYMBLTB0

; Expression metadata is deliberately explicit in the correctness build.
; A bounded stack retains the left operand of recursive expression parses;
; each entry is metadata plus a constant value word. The later compression
; pass may overlay this state once its liveness has been measured.
EXPRSSNE  EQU SYMBLTB0+$00 ;@NUC-GLOBAL ExpressionExpectedType PERMANENT EXPRSSNE
EXPRSSN2   EQU SYMBLTB0+$01 ;@NUC-GLOBAL ExpressionEmitEnabled PERMANENT EXPRSSN2
EXPRSSNS EQU SYMBLTB0+$02 ;@NUC-GLOBAL ExpressionSuppressFault PERMANENT EXPRSSNS
EXPRSSN3    EQU SYMBLTB0+$03 ;@NUC-GLOBAL ExpressionStackDepth PERMANENT EXPRSSN3
EXPRSSNR     EQU SYMBLTB0+$04 ;@NUC-GLOBAL ExpressionRightMeta PERMANENT EXPRSSNR
EXPRSSN4    EQU SYMBLTB0+$05 ;@NUC-GLOBAL ExpressionRightValue PERMANENT EXPRSSN4
EXPRSSNL      EQU SYMBLTB0+$07 ;@NUC-GLOBAL ExpressionLeftMeta PERMANENT EXPRSSNL
EXPRSSN5     EQU SYMBLTB0+$08 ;@NUC-GLOBAL ExpressionLeftValue PERMANENT EXPRSSN5
EXPRSSN6      EQU SYMBLTB0+$0A ;@NUC-GLOBAL ExpressionOperator PERMANENT EXPRSSN6
EXPRSSN7 EQU SYMBLTB0+$0B ;@NUC-GLOBAL ExpressionOperatorOffset PERMANENT EXPRSSN7
DCLRTNIN         EQU SYMBLTB0+$0D ;@NUC-GLOBAL DeclarationInfo PERMANENT DCLRTNIN
DCLRTNPY      EQU SYMBLTB0+$0E ;@NUC-GLOBAL DeclarationPayload PERMANENT DCLRTNPY
DCLRTNNM  EQU SYMBLTB0+$10 ;@NUC-GLOBAL DeclarationNamePointer PERMANENT DCLRTNNM
DCLRTNN0   EQU SYMBLTB0+$12 ;@NUC-GLOBAL DeclarationNameLength PERMANENT DCLRTNN0
EXPRSSNC    EQU SYMBLTB0+$13 ;@NUC-GLOBAL ExpressionCallOffset PERMANENT EXPRSSNC
DCLRTNN1 EQU SYMBLTB0+$15  ;@NUC-GLOBAL DeclarationNamePosition PERMANENT DCLRTNN1; offset, line, column
EXPRSSNV EQU SYMBLTB0+$1B  ;@NUC-GLOBAL ExpressionValuePosition PERMANENT EXPRSSNV; offset, line, column
EXPRSSN8 EQU SYMBLTB0+$21 ;@NUC-GLOBAL ExpressionLeftPositionPointer PERMANENT EXPRSSN8
EXPRSSN9     EQU SYMBLTB0+$23 ;@NUC-GLOBAL ExpressionStackBase PERMANENT EXPRSSN9
EXPRSSNA EQU 16 ;@NUC-GLOBAL ExpressionStackCapacity PERMANENT EXPRSSNA
EXPRSSNB EQU 13 ;@NUC-GLOBAL ExpressionStackEntrySize PERMANENT EXPRSSNB
EXPRSSND    EQU EXPRSSN9+EXPRSSNA*EXPRSSNB ;@NUC-GLOBAL ExpressionStackLimit PERMANENT EXPRSSND

; Boolean short-circuit emission retains one forward patch per nesting level.
EMTBLNFX   EQU EXPRSSND+$00 ;@NUC-GLOBAL EmitBooleanFixupDepth PERMANENT EMTBLNFX
EMTBLNF0    EQU EXPRSSND+$01 ;@NUC-GLOBAL EmitBooleanFixupBase PERMANENT EMTBLNF0
EMTBLNF1 EQU 16 ;@NUC-GLOBAL EmitBooleanFixupCapacity PERMANENT EMTBLNF1
EMTBLNF2   EQU EMTBLNF0+EMTBLNF1*2 ;@NUC-GLOBAL EmitBooleanFixupLimit PERMANENT EMTBLNF2

; Structured-control parsing and Z80 emission occur in disjoint phases.
; The parser uses bounded ten-byte control frames; after successful parsing the
; Z80 backend reuses the same region for absolute labels and branch fixups.
CNTRLWRK    EQU EMTBLNF2 ;@NUC-GLOBAL ControlWorkspaceBase PERMANENT CNTRLWRK
CNTRLDPT            EQU CNTRLWRK+$00 ;@NUC-GLOBAL ControlDepth PERMANENT CNTRLDPT
CNTRLNXT        EQU CNTRLWRK+$01 ;@NUC-GLOBAL ControlNextLabel PERMANENT CNTRLNXT
CNTRLGLB EQU CNTRLWRK+$02 ;@NUC-GLOBAL ControlGlobalSymbolCount PERMANENT CNTRLGLB
CNTRLRTN      EQU CNTRLWRK+$03 ;@NUC-GLOBAL ControlRoutineKind PERMANENT CNTRLRTN
CNTRLRSL       EQU CNTRLWRK+$04 ;@NUC-GLOBAL ControlResultType PERMANENT CNTRLRSL
CNTRLSQN EQU CNTRLWRK+$05 ;@NUC-GLOBAL ControlSequenceFallsThrough PERMANENT CNTRLSQN
CNTRLFRM        EQU CNTRLWRK+$08 ;@NUC-GLOBAL ControlFrameBase PERMANENT CNTRLFRM
CNTRLFR0        EQU 10 ;@NUC-GLOBAL ControlFrameSize PERMANENT CNTRLFR0
CNTRLFR1    EQU 8 ;@NUC-GLOBAL ControlFrameCapacity PERMANENT CNTRLFR1
CNTRLFR2       EQU CNTRLFRM+CNTRLFR0*CNTRLFR1 ;@NUC-GLOBAL ControlFrameLimit PERMANENT CNTRLFR2

CNTRLKND           EQU 1 ;@NUC-GLOBAL ControlKindIf PERMANENT CNTRLKND
CNTRLKN0        EQU 2 ;@NUC-GLOBAL ControlKindWhile PERMANENT CNTRLKN0
CNTRLKN1          EQU 3 ;@NUC-GLOBAL ControlKindFor PERMANENT CNTRLKN1
CNTRLKN2      EQU 4 ;@NUC-GLOBAL ControlKindHandler PERMANENT CNTRLKN2
CNTRLRT0      EQU 0 ;@NUC-GLOBAL ControlRoutineNone PERMANENT CNTRLRT0
CNTRLRT1     EQU 1 ;@NUC-GLOBAL ControlRoutineValue PERMANENT CNTRLRT1
CNTRLRT2     EQU 31 ;@NUC-GLOBAL ControlRoutineLabel PERMANENT CNTRLRT2
CNTRLFR3        EQU 0 ;@NUC-GLOBAL ControlFrameKind PERMANENT CNTRLFR3
CNTRLFR4      EQU 1 ;@NUC-GLOBAL ControlFrameLabelA PERMANENT CNTRLFR4
CNTRLFR5    EQU 2 ;@NUC-GLOBAL ControlFrameContinue PERMANENT CNTRLFR5
CNTRLFR6        EQU 3 ;@NUC-GLOBAL ControlFrameExit PERMANENT CNTRLFR6
CNTRLFR7     EQU 4 ;@NUC-GLOBAL ControlFrameCounter PERMANENT CNTRLFR7
CNTRLFR8        EQU 5 ;@NUC-GLOBAL ControlFrameMode PERMANENT CNTRLFR8
CNTRLFR9        EQU 6 ;@NUC-GLOBAL ControlFrameStep PERMANENT CNTRLFR9
CNTRLFRA  EQU 8 ;@NUC-GLOBAL ControlFrameTrapOffset PERMANENT CNTRLFRA
CNTRLNOC        EQU $FF ;@NUC-GLOBAL ControlNoCounter PERMANENT CNTRLNOC

EMTCNTRL   EQU CNTRLWRK+$00 ;@NUC-GLOBAL EmitControlFixupCount PERMANENT EMTCNTRL
EMTCNTR0 EQU CNTRLWRK+$01 ;@NUC-GLOBAL EmitControlLabelValidBase PERMANENT EMTCNTR0
EMTCNTR1 EQU 32 ;@NUC-GLOBAL EmitControlLabelCapacity PERMANENT EMTCNTR1
EMTCNTR2 EQU EMTCNTR0+EMTCNTR1 ;@NUC-GLOBAL EmitControlLabelAddressBase PERMANENT EMTCNTR2
EMTCNTR3    EQU EMTCNTR2+EMTCNTR1*2 ;@NUC-GLOBAL EmitControlFixupBase PERMANENT EMTCNTR3
EMTCNTR4    EQU 3 ;@NUC-GLOBAL EmitControlFixupSize PERMANENT EMTCNTR4
EMTCNTR5 EQU 32 ;@NUC-GLOBAL EmitControlFixupCapacity PERMANENT EMTCNTR5
EMTCNTR6   EQU EMTCNTR3+EMTCNTR4*EMTCNTR5 ;@NUC-GLOBAL EmitControlFixupLimit PERMANENT EMTCNTR6
; Published program metadata must survive source parsing. It therefore cannot
; overlay SourceCursor as the earlier non-atomic slices did.
GNRTDSZ           EQU EMTCNTR6 ;@NUC-GLOBAL GeneratedSize PERMANENT GNRTDSZ
%IF SegmentedOutput
; Four target-adapter segments. Each retained entry is base then exclusive
; limit. Code and rodata have published image bytes;
; data and bss describe runtime storage initialized by the generated startup.
GNRTDROD     EQU GNRTDSZ+2 ;@NUC-GLOBAL GeneratedRoDataSize PERMANENT GNRTDROD
GNRTDDTS       EQU GNRTDROD+2 ;@NUC-GLOBAL GeneratedDataSize PERMANENT GNRTDDTS
GNRTDBSS        EQU GNRTDDTS+2 ;@NUC-GLOBAL GeneratedBssSize PERMANENT GNRTDBSS
PBLSHDSZ           EQU GNRTDBSS+2 ;@NUC-GLOBAL PublishedSize PERMANENT PBLSHDSZ
PBLSHDRO     EQU PBLSHDSZ+2 ;@NUC-GLOBAL PublishedRoDataSize PERMANENT PBLSHDRO
PBLSHDDT       EQU PBLSHDRO+2 ;@NUC-GLOBAL PublishedDataSize PERMANENT PBLSHDDT
PBLSHDBS        EQU PBLSHDDT+2 ;@NUC-GLOBAL PublishedBssSize PERMANENT PBLSHDBS
SGMNTTBL        EQU PBLSHDBS+2 ;@NUC-GLOBAL SegmentTableBase PERMANENT SGMNTTBL
SGMNTENT        EQU 4 ;@NUC-GLOBAL SegmentEntrySize PERMANENT SGMNTENT
SGMNTCPC         EQU 4 ;@NUC-GLOBAL SegmentCapacity PERMANENT SGMNTCPC
SGMNTTB0       EQU SGMNTTBL+SGMNTENT*SGMNTCPC ;@NUC-GLOBAL SegmentTableLimit PERMANENT SGMNTTB0
SGMNTEN0        EQU 0 ;@NUC-GLOBAL SegmentEntryBase PERMANENT SGMNTEN0
SGMNTEN1       EQU 2 ;@NUC-GLOBAL SegmentEntryLimit PERMANENT SGMNTEN1
SGMNTCD             EQU 0 ;@NUC-GLOBAL SegmentCode PERMANENT SGMNTCD
SGMNTROD           EQU 1 ;@NUC-GLOBAL SegmentRoData PERMANENT SGMNTROD
SGMNTDT             EQU 2 ;@NUC-GLOBAL SegmentData PERMANENT SGMNTDT
SGMNTBSS              EQU 3 ;@NUC-GLOBAL SegmentBss PERMANENT SGMNTBSS
SGMNTCDE        EQU SGMNTTBL+SGMNTENT*SGMNTCD ;@NUC-GLOBAL SegmentCodeEntry PERMANENT SGMNTCDE
SGMNTRO0      EQU SGMNTTBL+SGMNTENT*SGMNTROD ;@NUC-GLOBAL SegmentRoDataEntry PERMANENT SGMNTRO0
SGMNTDTE        EQU SGMNTTBL+SGMNTENT*SGMNTDT ;@NUC-GLOBAL SegmentDataEntry PERMANENT SGMNTDTE
SGMNTBS0         EQU SGMNTTBL+SGMNTENT*SGMNTBSS ;@NUC-GLOBAL SegmentBssEntry PERMANENT SGMNTBS0
SGMNTRO1     EQU SGMNTTB0  ;@NUC-GLOBAL SegmentRoDataCursor PERMANENT SGMNTRO1; word
PRGRMBSS        EQU SGMNTRO1+2  ;@NUC-GLOBAL ProgramBssLength PERMANENT PRGRMBSS; word
STG5WRKS      EQU PRGRMBSS+2 ;@NUC-GLOBAL Stage5WorkspaceEnd PERMANENT STG5WRKS
%ELSE
PBLSHDSZ           EQU GNRTDSZ+2 ;@NUC-GLOBAL PublishedSize PERMANENT PBLSHDSZ
STG5WRKS      EQU PBLSHDSZ+2 ;@NUC-GLOBAL Stage5WorkspaceEnd PERMANENT STG5WRKS
%ENDIF

; Stage 6 retains aggregate type and layout metadata for the complete
; compilation. Type IDs 1..3 are the predefined scalars; IDs 4 and above name
; bounded four-byte descriptors. Record field offsets remain live for the
; later selection stage, while the complete static image survives into Z80
; emission.
AGGRGTS7      EQU STG5WRKS ;@NUC-GLOBAL AggregateStateBase PERMANENT AGGRGTS7
AGGRGTMD           EQU AGGRGTS7+$00 ;@NUC-GLOBAL AggregateMode PERMANENT AGGRGTMD
AGGRGTT7      EQU AGGRGTS7+$01 ;@NUC-GLOBAL AggregateTypeCount PERMANENT AGGRGTT7
AGGRGTR6    EQU AGGRGTS7+$02 ;@NUC-GLOBAL AggregateRecordCount PERMANENT AGGRGTR6
AGGRGTF2     EQU AGGRGTS7+$03 ;@NUC-GLOBAL AggregateFieldCount PERMANENT AGGRGTF2
AGGRGTI5 EQU AGGRGTS7+$04 ;@NUC-GLOBAL AggregateInitializerDepth PERMANENT AGGRGTI5
; Nonzero once an explicit initializer has supplied at least one value. The
; value is a Boolean allocation choice, not a retained element count.
AGGRGTHS EQU AGGRGTS7+$05 ;@NUC-GLOBAL AggregateHasInitializer PERMANENT AGGRGTHS
AGGRGTCR  EQU AGGRGTS7+$06 ;@NUC-GLOBAL AggregateCurrentTypeId PERMANENT AGGRGTCR
AGGRGTC4 EQU AGGRGTS7+$07 ;@NUC-GLOBAL AggregateCurrentFieldStart PERMANENT AGGRGTC4
AGGRGTC5 EQU AGGRGTS7+$08 ;@NUC-GLOBAL AggregateCurrentFieldCount PERMANENT AGGRGTC5
AGGRGTC6 EQU AGGRGTS7+$09  ;@NUC-GLOBAL AggregateCurrentRecordExtent PERMANENT AGGRGTC6; word
AGGRGTC7 EQU AGGRGTS7+$0B  ;@NUC-GLOBAL AggregateCurrentObjectOffset PERMANENT AGGRGTC7; word
AGGRGTC8 EQU AGGRGTS7+$0D  ;@NUC-GLOBAL AggregateCurrentObjectExtent PERMANENT AGGRGTC8; word
AGGRGTC9 EQU AGGRGTS7+$0F ;@NUC-GLOBAL AggregateCandidateKind PERMANENT AGGRGTC9
AGGRGTCA  EQU AGGRGTS7+$10 ;@NUC-GLOBAL AggregateCandidateAux PERMANENT AGGRGTCA
AGGRGTCB EQU AGGRGTS7+$11  ;@NUC-GLOBAL AggregateCandidateLength PERMANENT AGGRGTCB; word
AGGRGTCC EQU AGGRGTS7+$13  ;@NUC-GLOBAL AggregateCandidateExtent PERMANENT AGGRGTCC; word
AGGRGTCD EQU AGGRGTS7+$15  ;@NUC-GLOBAL AggregateCurrentObjectEnd PERMANENT AGGRGTCD; word
AGGRGTS8       EQU AGGRGTS7+$17 ;@NUC-GLOBAL AggregateStateEnd PERMANENT AGGRGTS8

AGGRGTT8  EQU AGGRGTS8 ;@NUC-GLOBAL AggregateTypeTableBase PERMANENT AGGRGTT8
AGGRGTT9  EQU 4 ;@NUC-GLOBAL AggregateTypeEntrySize PERMANENT AGGRGTT9
AGGRGTTA   EQU 8 ;@NUC-GLOBAL AggregateTypeCapacity PERMANENT AGGRGTTA
AGGRGTTB EQU AGGRGTT8+AGGRGTT9*AGGRGTTA ;@NUC-GLOBAL AggregateTypeTableLimit PERMANENT AGGRGTTB
AGGRGTTC       EQU 0 ;@NUC-GLOBAL AggregateTypeKind PERMANENT AGGRGTTC
AGGRGTTD        EQU 1 ;@NUC-GLOBAL AggregateTypeAux PERMANENT AGGRGTTD
AGGRGTTE     EQU 2  ;@NUC-GLOBAL AggregateTypeLength PERMANENT AGGRGTTE; word
; Every dynamic type retains its complete nonzero extent as a word. Strings
; remain byte-capacity values, while arrays and records may occupy the complete
; selected program-data region.
AGGRGTTF EQU AGGRGTTB ;@NUC-GLOBAL AggregateTypeExtentBase PERMANENT AGGRGTTF
AGGRGTTG EQU AGGRGTTF+2*AGGRGTTA ;@NUC-GLOBAL AggregateTypeExtentLimit PERMANENT AGGRGTTG

AGGRGTR7 EQU AGGRGTTG ;@NUC-GLOBAL AggregateRecordTableBase PERMANENT AGGRGTR7
AGGRGTR8 EQU 2 ;@NUC-GLOBAL AggregateRecordEntrySize PERMANENT AGGRGTR8
AGGRGTR9 EQU 5 ;@NUC-GLOBAL AggregateRecordCapacity PERMANENT AGGRGTR9
AGGRGTRA EQU AGGRGTR7+AGGRGTR8*AGGRGTR9 ;@NUC-GLOBAL AggregateRecordTableLimit PERMANENT AGGRGTRA
AGGRGTRB EQU 0 ;@NUC-GLOBAL AggregateRecordFieldStart PERMANENT AGGRGTRB
AGGRGTRD EQU 1 ;@NUC-GLOBAL AggregateRecordFieldCount PERMANENT AGGRGTRD

AGGRGTF3 EQU AGGRGTRA ;@NUC-GLOBAL AggregateFieldTableBase PERMANENT AGGRGTF3
AGGRGTF4 EQU 6 ;@NUC-GLOBAL AggregateFieldEntrySize PERMANENT AGGRGTF4
AGGRGTF5  EQU 12 ;@NUC-GLOBAL AggregateFieldCapacity PERMANENT AGGRGTF5
AGGRGTF6 EQU AGGRGTF3+AGGRGTF4*AGGRGTF5 ;@NUC-GLOBAL AggregateFieldTableLimit PERMANENT AGGRGTF6
AGGRGTF7 EQU 0 ;@NUC-GLOBAL AggregateFieldNamePointer PERMANENT AGGRGTF7
AGGRGTF8 EQU 2 ;@NUC-GLOBAL AggregateFieldNameLength PERMANENT AGGRGTF8
AGGRGTF9    EQU 3 ;@NUC-GLOBAL AggregateFieldTypeId PERMANENT AGGRGTF9
AGGRGTFA    EQU 4  ;@NUC-GLOBAL AggregateFieldOffset PERMANENT AGGRGTFA; word

; One type ID per ordinary symbol is enough because the ordinary symbol table
; owns name identity and the payload word owns the program-data offset.
AGGRGTSY EQU AGGRGTF6 ;@NUC-GLOBAL AggregateSymbolTypeBase PERMANENT AGGRGTSY
AGGRGTS9 EQU AGGRGTSY+SYMBLCPC ;@NUC-GLOBAL AggregateSymbolTypeLimit PERMANENT AGGRGTS9

STTCIMGL       EQU AGGRGTS9  ;@NUC-GLOBAL StaticImageLength PERMANENT STTCIMGL; word
%IF SegmentedOutput
RDONLYIM     EQU STTCIMGL+2  ;@NUC-GLOBAL ReadOnlyImageLength PERMANENT RDONLYIM; word
; One complete object is built in scratch. Published rodata keeps initialized
; data first and aggregate-constant bytes in a read-only suffix.
AGGRGTI6 EQU RDONLYIM+2 ;@NUC-GLOBAL AggregateInitializerBase PERMANENT AGGRGTI6
AGGRGTI7 EQU 1024 ;@NUC-GLOBAL AggregateInitializerCapacity PERMANENT AGGRGTI7
STTCIMGB         EQU AGGRGTI6+AGGRGTI7 ;@NUC-GLOBAL StaticImageBase PERMANENT STTCIMGB
STTCIMGC     EQU 1024 ;@NUC-GLOBAL StaticImageCapacity PERMANENT STTCIMGC
%ELSE
STTCIMGB         EQU STTCIMGL+2 ;@NUC-GLOBAL StaticImageBase PERMANENT STTCIMGB
AGGRGTI6 EQU STTCIMGB ;@NUC-GLOBAL AggregateInitializerBase PERMANENT AGGRGTI6
STTCIMGC     EQU 255 ;@NUC-GLOBAL StaticImageCapacity PERMANENT STTCIMGC
%ENDIF
STTCIMG0        EQU STTCIMGB+STTCIMGC ;@NUC-GLOBAL StaticImageLimit PERMANENT STTCIMG0
AGGRGTW0   EQU STTCIMG0 ;@NUC-GLOBAL AggregateWorkspaceEnd PERMANENT AGGRGTW0
CMPLRWRK    EQU AGGRGTW0 ;@NUC-GLOBAL CompilerWorkspaceEnd PERMANENT CMPLRWRK

AGGRGTI8 EQU 4 ;@NUC-GLOBAL AggregateInitializerDepthCapacity PERMANENT AGGRGTI8

; Emission follows successful parsing and may overlay the retained forward.
SMNTCRDC      EQU FRWRDNMP ;@NUC-GLOBAL SemanticReadCursor PERMANENT SMNTCRDC
EMTRTNAD      EQU FRWRDPRM ;@NUC-GLOBAL EmitRoutineAddress PERMANENT EMTRTNAD
EMTRTNCL    EQU FRWRDPR0 ;@NUC-GLOBAL EmitRoutineCallFixup PERMANENT EMTRTNCL
EMTIFFXP             EQU FRWRDORD ;@NUC-GLOBAL EmitIfFixup PERMANENT EMTIFFXP

TokenEof                EQU 0
TKNNWLN            EQU 1 ;@NUC-GLOBAL TokenNewline PERMANENT TKNNWLN
TKNNM               EQU 2 ;@NUC-GLOBAL TokenName PERMANENT TKNNM
TKNCHRCT          EQU 3 ;@NUC-GLOBAL TokenCharacter PERMANENT TKNCHRCT
TKNNMBR             EQU 4 ;@NUC-GLOBAL TokenNumber PERMANENT TKNNMBR
TKNLFTPR          EQU 5 ;@NUC-GLOBAL TokenLeftParen PERMANENT TKNLFTPR
TKNRGHTP         EQU 6 ;@NUC-GLOBAL TokenRightParen PERMANENT TKNRGHTP
TKNEQLS             EQU 7 ;@NUC-GLOBAL TokenEquals PERMANENT TKNEQLS
TokenSub                EQU 8
TKNFLS              EQU 9 ;@NUC-GLOBAL TokenFails PERMANENT TKNFLS
TokenOr                 EQU 10
TKNFL               EQU 11 ;@NUC-GLOBAL TokenFail PERMANENT TKNFL
TokenEnd                EQU 12
TokenVar                EQU 13
TokenAs                 EQU 14
TokenU8                 EQU 15
TokenFor                EQU 16
TKNUNTL              EQU 17 ;@NUC-GLOBAL TokenUntil PERMANENT TKNUNTL
TKNLFTBR        EQU 18 ;@NUC-GLOBAL TokenLeftBracket PERMANENT TKNLFTBR
TKNRGHTB       EQU 19 ;@NUC-GLOBAL TokenRightBracket PERMANENT TKNRGHTB
TKNCMM              EQU 20 ;@NUC-GLOBAL TokenComma PERMANENT TKNCMM
TKNFRWRD            EQU 21 ;@NUC-GLOBAL TokenForward PERMANENT TKNFRWRD
TKNRTRN             EQU 22 ;@NUC-GLOBAL TokenReturn PERMANENT TKNRTRN
TokenIf                 EQU 23
TKNMNS              EQU 24 ;@NUC-GLOBAL TokenMinus PERMANENT TKNMNS
TKNPLS               EQU 25 ;@NUC-GLOBAL TokenPlus PERMANENT TKNPLS
TKNSTR               EQU 26 ;@NUC-GLOBAL TokenStar PERMANENT TKNSTR
