            LD   HL,(FTMPDLA)
            LD   DE,$81AA
            OR   A
            SBC  HL,DE
            JP   NZ,PRFMPFLR
            LD   HL,(ADPTRCRS)
            LD   DE,ADPTRLGB
            OR   A
            SBC  HL,DE
