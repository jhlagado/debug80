            LD   DE,ADPTRLGB
            OR   A
            SBC  HL,DE
            LD   (ADPTRUNH),HL
            LD   B,H
            LD   C,L
            LD   HL,ADPTRLGB
            LD   DE,ADPTRUN3
            LDIR
            LD   HL,ADPTRCPA
            LD   DE,ADPTRUN0
            LD   BC,TRGTMPSZ
            LDIR

            LD   A,(DGNSTCCD)
            LD   (ADPTRSVD),A

            LD   A,40
            LD   (PRFCS),A
            LD   A,2
            LD   HL,BNKDTRG3
            LD   IX,BNKDINV0
            CALL CMPLTRGT
            JP   NC,PRFCNFGR
            LD   A,(DGNSTCCD)
