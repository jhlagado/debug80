            LD   IX,CHPTR215
            CALL CMPLTRGT
            JR   C,PRFCMPLF
            LD   HL,(ADPTRCRS)
            LD   DE,ADPTRCH0
            OR   A
            SBC  HL,DE
            LD   (ADPTRCHP),HL
            LD   A,(ADPTRSVD)
            LD   (DGNSTCCD),A
            LD   A,$A5
            LD   (PRFSTTS),A
            XOR  A
            LD   (PRFCS),A
            HALT

PRFCMPLF: LD A,1 ;@NUC-GLOBAL ProofCompileFailure PERMANENT PRFCMPLF
            JR   PRFFL
PRFCMMTF:  LD A,2 ;@NUC-GLOBAL ProofCommitFailure PERMANENT PRFCMMTF
            JR   PRFFL
PRFBGNFL:   LD A,3 ;@NUC-GLOBAL ProofBeginFailure PERMANENT PRFBGNFL
            JR   PRFFL
PRFCNTXT: LD A,4 ;@NUC-GLOBAL ProofContextFailure PERMANENT PRFCNTXT
            JR   PRFFL
PRFMPFLR:     LD A,5 ;@NUC-GLOBAL ProofMapFailure PERMANENT PRFMPFLR
            JR   PRFFL
PRFLGFLR:     LD A,6 ;@NUC-GLOBAL ProofLogFailure PERMANENT PRFLGFLR
            JR   PRFFL
PRFRGNFL:  LD A,(PRFCS) ;@NUC-GLOBAL ProofRegionFailure PERMANENT PRFRGNFL
            JR   PRFFL
PRFLDDFL:  LD A,(PRFCS) ;@NUC-GLOBAL ProofLoadedFailure PERMANENT PRFLDDFL
            JR   PRFFL
PRFATMCF:  LD A,(PRFCS) ;@NUC-GLOBAL ProofAtomicFailure PERMANENT PRFATMCF
            JR   PRFFL
PRFCNFGR: LD A,(PRFCS) ;@NUC-GLOBAL ProofConfigurationFailure PERMANENT PRFCNFGR
PRFFL: ;@NUC-GLOBAL ProofFail PERMANENT PRFFL
            LD   (PRFCS),A
            LD   A,$E1
            LD   (PRFSTTS),A
            HALT

; Reserve A bytes atomically in the bounded proof-only operation log.
;@ROUTINE IN A OUT A,IY,CARRY,ZERO CLOBBERS SIGN,PARITY,HALFCARRY,DE,HL
ADPTRRSR: ;@NUC-GLOBAL AdapterReserve PERMANENT ADPTRRSR
            LD   E,A
            LD   A,(ADPTRFLR)
            OR   A
            JR   Z,.L00000
            DEC  A
            LD   (ADPTRFLR),A
            JR   NZ,.L00000
            LD   A,DGNSTCT4
            SCF
            RET
.L00000:
            LD   A,E
            LD   D,0
            LD   IY,(ADPTRCRS)
            PUSH IY
            POP  HL
            ADD  HL,DE
            LD   DE,ADPTRLG0
            OR   A
            SBC  HL,DE
            JR   C,.L00001
            JR   Z,.L00001
            LD   A,DGNSTCT4
            SCF
            RET
.L00001:
            ADD  HL,DE
            LD   (ADPTRCRS),HL
            OR   A
            RET

;@ROUTINE OUT A,CARRY,ZERO CLOBBERS SIGN,PARITY,HALFCARRY,HL
TRGTSNKS: ;@NUC-GLOBAL TargetSinkSourceProvenanceReset PERMANENT TRGTSNKS
            LD   HL,SRCPRVNA
            LD   (SRCPRVNN),HL
            XOR  A
            LD   (SRCPRVN0),A
            LD   (SRCPRVN0+1),A
            RET

; A is the one-based source part, C is the output bank, and DE..HL is the
; generated code range. This first resident emission is intentionally coarse:
; line and column are fixed at 1 and confidence is low until the semantic
; transcript carries per-operation source positions.
;@ROUTINE IN A,C,DE,HL OUT A,CARRY,ZERO CLOBBERS SIGN,PARITY,HALFCARRY,B,C,DE,HL,IX,IY
TRGTSNK0: ;@NUC-GLOBAL TargetSinkSourceProvenanceSinglePartCode PERMANENT TRGTSNK0
            LD   (SRCPRVN2),A
            LD   A,C
            LD   (SRCPRVN3),A
            LD   (SRCPRVN4),DE
            LD   (SRCPRVN5),HL
            LD   HL,1
            LD   (SRCPRVN6),HL
            LD   (SRCPRVN7),HL
            XOR  A
            LD   (SRCPRVN8),A
            JR   TRGTSNK2

; A is the one-based source part, C is the output bank, DE..HL is the generated
; code range, and SourceProvenanceLine/Column already hold the source position.
;@ROUTINE IN A,C,DE,HL OUT A,CARRY,ZERO CLOBBERS SIGN,PARITY,HALFCARRY
TRGTSNK1: ;@NUC-GLOBAL TargetSinkSourceProvenanceCurrentCode PERMANENT TRGTSNK1
            PUSH BC
            PUSH DE
            PUSH HL
            PUSH IX
            PUSH IY
            LD   (SRCPRVN2),A
            LD   A,C
            LD   (SRCPRVN3),A
            LD   (SRCPRVN4),DE
            LD   (SRCPRVN5),HL
            LD   A,2
            LD   (SRCPRVN8),A
            CALL TRGTSNK2
            LD   (SRCPRVN9),A
            POP  IY
            POP  IX
            POP  HL
            POP  DE
            POP  BC
            LD   A,(SRCPRVN9)
            RET

;@ROUTINE OUT A,CARRY,ZERO CLOBBERS SIGN,PARITY,HALFCARRY,DE,HL,IY
TRGTSNK2: ;@NUC-GLOBAL TargetSinkSourceProvenanceCodeReady PERMANENT TRGTSNK2
            PUSH IY
            LD   IY,(SRCPRVNN)
            PUSH IY
            POP  HL
            LD   DE,12
            ADD  HL,DE
            LD   DE,SRCPRVNB
            OR   A
            SBC  HL,DE
            JR   C,.L00000
            JR   Z,.L00000
            LD   A,DGNSTCT4
            POP  IY
            SCF
            RET
.L00000:
            ADD  HL,DE
            LD   (SRCPRVNN),HL
            LD   DE,SRCPRVNA
            OR   A
            SBC  HL,DE
            LD   (SRCPRVN0),HL
            LD   A,(SRCPRVN2)
            LD   (IY+0),A
            LD   A,(SRCPRVN3)
            LD   (IY+1),A
            LD   HL,(SRCPRVN6)
            LD   (IY+2),L
            LD   (IY+3),H
            LD   HL,(SRCPRVN7)
            LD   (IY+4),L
            LD   (IY+5),H
            LD   HL,(SRCPRVN4)
            LD   (IY+6),L
            LD   (IY+7),H
            LD   HL,(SRCPRVN5)
            LD   (IY+8),L
            LD   (IY+9),H
            LD   (IY+10),1
            LD   A,(SRCPRVN8)
            LD   (IY+11),A
            POP  IY
            OR   A
            RET

;@ROUTINE IN IX OUT A,CARRY,ZERO CLOBBERS SIGN,PARITY,HALFCARRY,BC,DE,HL,IY
TRGTSNKB: ;@NUC-GLOBAL TargetSinkBegin PERMANENT TRGTSNKB
            LD   HL,ADPTRCPT
            LD   B,TRGTDSC8
.L00000:
            LD   A,(IX+0)
            LD   (HL),A
            INC  IX
            INC  HL
            DJNZ .L00000
            LD   A,1
            LD   (ADPTROPN),A
            OR   A
            RET

;@ROUTINE IN A,C,HL OUT A,CARRY,ZERO CLOBBERS SIGN,PARITY,HALFCARRY,DE
TRGTSNKI: ;@NUC-GLOBAL TargetSinkImageByte PERMANENT TRGTSNKI
            PUSH IY
            PUSH AF
            PUSH BC
            PUSH HL
            LD   A,7
            CALL ADPTRRSR
            JR   C,.L00001
            POP  HL
            POP  BC
            POP  AF
            LD   (IY+0),1
            LD   (IY+1),C
            LD   (IY+2),L
            LD   (IY+3),H
            LD   (IY+4),1
            LD   (IY+5),0
            LD   (IY+6),A
            POP  IY
            OR   A
            RET
.L00000:
            POP  IY
            RET
.L00001:
            LD   E,A
            POP  HL
            POP  BC
            POP  AF
            POP  IY
            LD   A,E
            SCF
            RET

;@ROUTINE IN A,BC,DE,HL,IX OUT A,CARRY,ZERO CLOBBERS SIGN,PARITY,HALFCARRY,BC,DE,HL,IX,IY
TRGTSNKR: ;@NUC-GLOBAL TargetSinkRuntimeImage PERMANENT TRGTSNKR
            PUSH AF
            LD   A,3
            LD   (ADPTRRN0),A
            POP  AF
            JR   TRGTSNK4
;@ROUTINE IN A,BC,DE,HL,IX OUT A,CARRY,ZERO CLOBBERS SIGN,PARITY,HALFCARRY,BC,DE,HL,IX,IY
TRGTSNK3: ;@NUC-GLOBAL TargetSinkRuntimeInitialImage PERMANENT TRGTSNK3
            PUSH AF
            LD   A,4
            LD   (ADPTRRN0),A
            POP  AF
TRGTSNK4: ;@NUC-GLOBAL TargetSinkRuntimeSelected PERMANENT TRGTSNK4
            LD   (ADPTRRNT),A
            LD   (ADPTRRN1),BC
            LD   (ADPTRRN2),DE
            LD   (ADPTRRN3),HL
            LD   (ADPTRRN4),IX
            LD   A,8+TRGTCNT8
            CALL ADPTRRSR
            RET  C
            LD   A,(ADPTRRNT)
            LD   BC,(ADPTRRN1)
            LD   DE,(ADPTRRN2)
            LD   HL,(ADPTRRN3)
            LD   IX,(ADPTRRN4)
            LD   A,(ADPTRRN0)
            LD   (IY+0),A
            LD   A,(ADPTRRNT)
            LD   (IY+1),A
            LD   (IY+2),L
            LD   (IY+3),H
            LD   (IY+4),C
            LD   (IY+5),B
            LD   (IY+6),E
            LD   (IY+7),D
            LD   (ADPTRRN5),IY
            PUSH IY
            POP  HL
            LD   DE,8
            ADD  HL,DE
            EX   DE,HL
            PUSH IX
            POP  HL
            LD   BC,TRGTCNT8
            LDIR
            LD   IY,(ADPTRRN5)
            PUSH IY
            POP  HL
            LD   DE,8
            ADD  HL,DE
            LD   DE,ADPTRCP0
            LD   BC,TRGTCNT8
            LDIR
            LD   IY,(ADPTRRN5)
            OR   A
            RET

;@ROUTINE IN A,C,HL OUT A,CARRY,ZERO CLOBBERS SIGN,PARITY,HALFCARRY,DE
TRGTSNKP: ;@NUC-GLOBAL TargetSinkPatchByte PERMANENT TRGTSNKP
            PUSH IY
            PUSH AF
            PUSH BC
            PUSH HL
            LD   A,7
            CALL ADPTRRSR
            JR   C,.L00001
            POP  HL
            POP  BC
            POP  AF
            LD   (IY+0),2
            LD   (IY+1),C
            LD   (IY+2),L
            LD   (IY+3),H
            LD   (IY+4),1
            LD   (IY+5),0
            LD   (IY+6),A
            POP  IY
            OR   A
            RET
.L00000:
            POP  IY
            RET
.L00001:
            LD   E,A
            POP  HL
            POP  BC
            POP  AF
            POP  IY
            LD   A,E
            SCF
            RET

;@ROUTINE IN C,DE,HL OUT A,CARRY,ZERO CLOBBERS SIGN,PARITY,HALFCARRY
TRGTSNK5: ;@NUC-GLOBAL TargetSinkPatchWord PERMANENT TRGTSNK5
            PUSH IY
            PUSH BC
            PUSH DE
            PUSH HL
            LD   A,8
            CALL ADPTRRSR
            POP  HL
            POP  DE
            POP  BC
            JR   C,.L00000
            LD   (IY+0),2
            LD   (IY+1),C
            LD   (IY+2),E
            LD   (IY+3),D
            LD   (IY+4),2
            LD   (IY+5),0
            LD   (IY+6),L
            LD   (IY+7),H
            POP  IY
            OR   A
            RET
.L00000:
            POP  IY
            RET

;@ROUTINE IN IX OUT A,CARRY,ZERO CLOBBERS SIGN,PARITY,HALFCARRY,BC,DE,HL,IY
TRGTSNKM: ;@NUC-GLOBAL TargetSinkMapFlat PERMANENT TRGTSNKM
            LD   A,(ADPTRMPF)
            OR   A
            JR   Z,.L00000
            LD   A,DGNSTCT4
            SCF
            RET
.L00000:
            LD   HL,ADPTRCPA
            LD   B,TRGTMPSZ
.L00001:
            LD   A,(IX+0)
            LD   (HL),A
            INC  IX
            INC  HL
            DJNZ .L00001
            OR   A
            RET

;@ROUTINE IN HL,IX,IY OUT A,CARRY,ZERO CLOBBERS SIGN,PARITY,HALFCARRY,BC,DE,HL,IX,IY
TRGTSNK6: ;@NUC-GLOBAL TargetSinkMapBanked PERMANENT TRGTSNK6
            LD   (ADPTRMPR),HL
            LD   A,(IX+FTIXBKC)
            LD   B,A
            LD   C,A
            LD   HL,ADPTRCP1
            LD   DE,ADPTRCP4
.L00000:
            LD   A,(IY+0)
            LD   (HL),A
            INC  HL
            LD   A,(IY+1)
            LD   (HL),A
            INC  HL
            LD   A,(IY+2)
            LD   (DE),A
            INC  DE
            LD   A,(IY+3)
            LD   (DE),A
            INC  DE
            PUSH DE
            LD   DE,TRGTBNK3
            ADD  IY,DE
            POP  DE
            DJNZ .L00000
            LD   HL,(ADPTRMPR)
            LD   DE,ADPTRCP7
            LD   A,C
            ADD  A,A
            LD   B,A
.L00001:
            LD   A,(HL)
            LD   (DE),A
            INC  HL
            INC  DE
            DJNZ .L00001
            OR   A
            RET

;@ROUTINE OUT A,CARRY,ZERO CLOBBERS SIGN,PARITY,HALFCARRY
TRGTSNKC: ;@NUC-GLOBAL TargetSinkCommit PERMANENT TRGTSNKC
            LD   A,(ADPTRCM0)
            OR   A
            JR   Z,.L00000
            LD   A,DGNSTCT4
            SCF
            RET
.L00000:
            LD   A,1
            LD   (ADPTRCMM),A
            OR   A
            RET

;@ROUTINE OUT A,CARRY,ZERO CLOBBERS SIGN,PARITY,HALFCARRY
TRGTSNKA: ;@NUC-GLOBAL TargetSinkAbort PERMANENT TRGTSNKA
            LD   A,1
            LD   (ADPTRABR),A
            OR   A
            RET

PRFSTTS: DB 0 ;@NUC-GLOBAL ProofStatus PERMANENT PRFSTTS
PRFCS:   DB 0 ;@NUC-GLOBAL ProofCase PERMANENT PRFCS
ADPTROPN: DB 0 ;@NUC-GLOBAL AdapterOpen PERMANENT ADPTROPN
ADPTRCMM: DB 0 ;@NUC-GLOBAL AdapterCommitted PERMANENT ADPTRCMM
ADPTRABR:   DB 0 ;@NUC-GLOBAL AdapterAborted PERMANENT ADPTRABR
ADPTRCRS:    DW 0 ;@NUC-GLOBAL AdapterCursor PERMANENT ADPTRCRS
ADPTRLGL: DW 0 ;@NUC-GLOBAL AdapterLogLength PERMANENT ADPTRLGL
ADPTRLDD: DW 0 ;@NUC-GLOBAL AdapterLoadedLogLength PERMANENT ADPTRLDD
ADPTRTRP: DW 0 ;@NUC-GLOBAL AdapterTrapLogLength PERMANENT ADPTRTRP
ADPTRUNH: DW 0 ;@NUC-GLOBAL AdapterUnhandledLogLength PERMANENT ADPTRUNH
ADPTRBNK: DW 0 ;@NUC-GLOBAL AdapterBankedLogLength PERMANENT ADPTRBNK
ADPTRENT: DW 0 ;@NUC-GLOBAL AdapterEntry1LogLength PERMANENT ADPTRENT
ADPTRBN0: DW 0 ;@NUC-GLOBAL AdapterBankedTrapLogLength PERMANENT ADPTRBN0
ADPTRCHP: DW 0 ;@NUC-GLOBAL AdapterChapter21LogLength PERMANENT ADPTRCHP
ADPTRFLD: DW 0 ;@NUC-GLOBAL AdapterFailedLogLength PERMANENT ADPTRFLD
ADPTRFLR: DB 0 ;@NUC-GLOBAL AdapterFailureCountdown PERMANENT ADPTRFLR
ADPTRMPF:       DB 0 ;@NUC-GLOBAL AdapterMapFailure PERMANENT ADPTRMPF
ADPTRCM0:    DB 0 ;@NUC-GLOBAL AdapterCommitFailure PERMANENT ADPTRCM0
ADPTRSVD:  DB 0 ;@NUC-GLOBAL AdapterSavedDiagnostic PERMANENT ADPTRSVD
ADPTRCPT:   DS TRGTDSC8 ;@NUC-GLOBAL AdapterCapturedBegin PERMANENT ADPTRCPT
ADPTRCP0: DS TRGTCNT8 ;@NUC-GLOBAL AdapterCapturedContext PERMANENT ADPTRCP0
ADPTRCP1: DS TRGTBNKC*2 ;@NUC-GLOBAL AdapterCapturedBankCursors PERMANENT ADPTRCP1
ADPTRCP2 EQU ADPTRCP1 ;@NUC-GLOBAL AdapterCapturedBank0Cursor PERMANENT ADPTRCP2
ADPTRCP3 EQU ADPTRCP1+2 ;@NUC-GLOBAL AdapterCapturedBank1Cursor PERMANENT ADPTRCP3
ADPTRCP4: DS TRGTBNKC*2 ;@NUC-GLOBAL AdapterCapturedBankRemaining PERMANENT ADPTRCP4
ADPTRCP5 EQU ADPTRCP4 ;@NUC-GLOBAL AdapterCapturedBank0Remaining PERMANENT ADPTRCP5
ADPTRCP6 EQU ADPTRCP4+2 ;@NUC-GLOBAL AdapterCapturedBank1Remaining PERMANENT ADPTRCP6
ADPTRCP7: DS TRGTBNKC*2 ;@NUC-GLOBAL AdapterCapturedBankRoLengths PERMANENT ADPTRCP7
ADPTRCP8 EQU ADPTRCP7 ;@NUC-GLOBAL AdapterCapturedBank0RoLength PERMANENT ADPTRCP8
ADPTRCP9 EQU ADPTRCP7+2 ;@NUC-GLOBAL AdapterCapturedBank1RoLength PERMANENT ADPTRCP9
ADPTRMPR: DW 0 ;@NUC-GLOBAL AdapterMapRoPointer PERMANENT ADPTRMPR
ADPTRCPA:     DS TRGTMPSZ ;@NUC-GLOBAL AdapterCapturedMap PERMANENT ADPTRCPA
.L00000: DW 0
.L00001: DS 1
ADPTRSCC:      DS TRGTMPSZ ;@NUC-GLOBAL AdapterSuccessMap PERMANENT ADPTRSCC
ADPTRTR0:         DS TRGTMPSZ ;@NUC-GLOBAL AdapterTrapMap PERMANENT ADPTRTR0
ADPTRUN0:    DS TRGTMPSZ ;@NUC-GLOBAL AdapterUnhandledMap PERMANENT ADPTRUN0
ADPTRTR1       EQU ADPTRTR0+$03 ;@NUC-GLOBAL AdapterTrapUsedLength PERMANENT ADPTRTR1
ADPTRTR2       EQU ADPTRTR0+$0B ;@NUC-GLOBAL AdapterTrapCodeLength PERMANENT ADPTRTR2
ADPTRUN1  EQU ADPTRUN0+$03 ;@NUC-GLOBAL AdapterUnhandledUsedLength PERMANENT ADPTRUN1
ADPTRUN2  EQU ADPTRUN0+$0B ;@NUC-GLOBAL AdapterUnhandledCodeLength PERMANENT ADPTRUN2
ADPTRCPB EQU FTCTX00 ;@NUC-GLOBAL AdapterCapturedRuntimeBase PERMANENT ADPTRCPB
ADPTRCPC   EQU FTCTX06 ;@NUC-GLOBAL AdapterCapturedStateBase PERMANENT ADPTRCPC
ADPTRCPD  EQU FTMAP03 ;@NUC-GLOBAL AdapterCapturedUsedLength PERMANENT ADPTRCPD
ADPTRCPE  EQU ADPTRCPA+$0B ;@NUC-GLOBAL AdapterCapturedCodeLength PERMANENT ADPTRCPE
ADPTRRNT:     DB 0 ;@NUC-GLOBAL AdapterRuntimeBank PERMANENT ADPTRRNT
ADPTRRN0:     DB 0 ;@NUC-GLOBAL AdapterRuntimeKind PERMANENT ADPTRRN0
ADPTRRN1:   DW 0 ;@NUC-GLOBAL AdapterRuntimeLength PERMANENT ADPTRRN1
ADPTRRN2: DW 0 ;@NUC-GLOBAL AdapterRuntimeIdentity PERMANENT ADPTRRN2
ADPTRRN3:  DW 0 ;@NUC-GLOBAL AdapterRuntimeAddress PERMANENT ADPTRRN3
ADPTRRN4:  DW 0 ;@NUC-GLOBAL AdapterRuntimeContext PERMANENT ADPTRRN4
ADPTRRN5:      DW 0 ;@NUC-GLOBAL AdapterRuntimeLog PERMANENT ADPTRRN5
ADPTRRN6 EQU ADPTRRN4 ;@NUC-GLOBAL AdapterRuntimeContextPointer PERMANENT ADPTRRN6
SRCPRVNN: DW 0 ;@NUC-GLOBAL SourceProvenanceCursor PERMANENT SRCPRVNN
SRCPRVN0: DW 0 ;@NUC-GLOBAL SourceProvenanceLength PERMANENT SRCPRVN0
SRCPRVN1: DW 0 ;@NUC-GLOBAL SourceProvenanceSuccessLength PERMANENT SRCPRVN1
SRCPRVN2:   DB 0 ;@NUC-GLOBAL SourceProvenancePart PERMANENT SRCPRVN2
SRCPRVN3:   DB 0 ;@NUC-GLOBAL SourceProvenanceBank PERMANENT SRCPRVN3
SRCPRVN4:  DW 0 ;@NUC-GLOBAL SourceProvenanceStart PERMANENT SRCPRVN4
SRCPRVN5:    DW 0 ;@NUC-GLOBAL SourceProvenanceEnd PERMANENT SRCPRVN5
SRCPRVN6:   DW 0 ;@NUC-GLOBAL SourceProvenanceLine PERMANENT SRCPRVN6
SRCPRVN7: DW 0 ;@NUC-GLOBAL SourceProvenanceColumn PERMANENT SRCPRVN7
SRCPRVN8: DB 0 ;@NUC-GLOBAL SourceProvenanceConfidence PERMANENT SRCPRVN8
SRCPRVN9: DB 0 ;@NUC-GLOBAL SourceProvenanceResult PERMANENT SRCPRVN9
ProofEnd:

SRCPRVNA EQU $C600 ;@NUC-GLOBAL SourceProvenanceLogBase PERMANENT SRCPRVNA
SRCPRVNB EQU $C630 ;@NUC-GLOBAL SourceProvenanceLogLimit PERMANENT SRCPRVNB
SRCPRVNC EQU $C640 ;@NUC-GLOBAL SourceProvenanceSuccessLogBase PERMANENT SRCPRVNC
ADPTRLD0    EQU $9A20 ;@NUC-GLOBAL AdapterLoadedLogBase PERMANENT ADPTRLD0
ADPTRSC0   EQU $9D20 ;@NUC-GLOBAL AdapterSuccessLogBase PERMANENT ADPTRSC0
ADPTRTR3      EQU $A100 ;@NUC-GLOBAL AdapterTrapLogBase PERMANENT ADPTRTR3
ADPTRUN3 EQU $A600 ;@NUC-GLOBAL AdapterUnhandledLogBase PERMANENT ADPTRUN3
ADPTRBN1 EQU $AD00 ;@NUC-GLOBAL AdapterBankedTrapLogBase PERMANENT ADPTRBN1
ADPTRLGB          EQU $B500 ;@NUC-GLOBAL AdapterLogBase PERMANENT ADPTRLGB
ADPTRFL0    EQU $C700 ;@NUC-GLOBAL AdapterFailedLogBase PERMANENT ADPTRFL0
ADPTREN0    EQU $CC00 ;@NUC-GLOBAL AdapterEntry1LogBase PERMANENT ADPTREN0
ADPTRCH0 EQU $D100 ;@NUC-GLOBAL AdapterChapter21LogBase PERMANENT ADPTRCH0
ADPTRLG0         EQU $F000 ;@NUC-GLOBAL AdapterLogLimit PERMANENT ADPTRLG0
