            OR   A
            JP   NZ,PRFATMCF

            LD   A,45
            LD   (PRFCS),A
            XOR  A
            LD   (ADPTRABR),A
            LD   (ADPTRFLR),A
            LD   HL,ADPTRLGB
            LD   (ADPTRCRS),HL
            LD   A,2
            LD   HL,BNKDPRM3
            LD   IX,BNKDFLRD
            CALL CMPLTRGT
            JP   NC,PRFCNFGR
            LD   A,(DGNSTCCD)
