            LD   DE,ADPTRSC0
            LDIR
            LD   HL,ADPTRCPA
            LD   DE,ADPTRSCC
            LD   BC,TRGTMPSZ
            LDIR
            LD   HL,(SRCPRVN0)
            LD   (SRCPRVN1),HL
            LD   B,H
            LD   C,L
            LD   HL,SRCPRVNA
            LD   DE,SRCPRVNC
            LDIR

            XOR  A
            LD   (ADPTRCMM),A
            LD   (ADPTRABR),A
            LD   (ADPTRFLR),A
            LD   HL,ADPTRLGB
            LD   (ADPTRCRS),HL
            LD   A,1
            LD   HL,FLTTRGT3
            LD   IX,FLTTRGTD
            CALL CMPLTRGT
            JP   C,PRFCMPLF
            LD   HL,(ADPTRCRS)
            LD   DE,ADPTRLGB
            OR   A
            SBC  HL,DE
            LD   (ADPTRTRP),HL
            LD   B,H
            LD   C,L
            LD   HL,ADPTRLGB
            LD   DE,ADPTRTR3
            LDIR
            LD   HL,ADPTRCPA
            LD   DE,ADPTRTR0
            LD   BC,TRGTMPSZ
            LDIR

            XOR  A
            LD   (ADPTRCMM),A
            LD   (ADPTRABR),A
