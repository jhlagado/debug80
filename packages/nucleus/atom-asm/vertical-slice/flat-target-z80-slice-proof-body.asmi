            LD   (PRFCS),A
            XOR  A
            LD   (ADPTRCMM),A
            LD   (ADPTRABR),A
            LD   (ADPTRFLR),A
            LD   (ADPTRMPF),A
            LD   HL,ADPTRLGB
            LD   (ADPTRCRS),HL
            LD   A,1
