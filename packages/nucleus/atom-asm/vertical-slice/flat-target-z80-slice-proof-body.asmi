            LD   HL,ADPTRLGB
            LD   (ADPTRCRS),HL
            LD   A,2
            LD   HL,BNKDTRG3
            LD   IX,BNKDENTR
            CALL CMPLTRGT
            JP   NC,PRFCNFGR
            LD   A,(DGNSTCCD)
