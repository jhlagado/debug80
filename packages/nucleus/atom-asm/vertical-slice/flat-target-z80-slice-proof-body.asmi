            LD   HL,BNKDTRG3
            LD   IX,BNKDWRNG
            CALL CMPLTRGT
            JP   NC,PRFCNFGR
            LD   A,(DGNSTCCD)
            CP   DGNSTCT2
            JP   NZ,PRFCNFGR

            LD   A,42
            LD   (PRFCS),A
            LD   A,2
            LD   HL,BNKDCNS3
            LD   IX,BNKDFLRD
            CALL CMPLTRGT
            JP   NC,PRFCNFGR
            LD   A,(DGNSTCCD)
            CP   DGNSTCT2
            JP   NZ,PRFCNFGR

            LD   A,43
            LD   (PRFCS),A
            XOR  A
            LD   (ADPTRCMM),A
            LD   (ADPTRABR),A
