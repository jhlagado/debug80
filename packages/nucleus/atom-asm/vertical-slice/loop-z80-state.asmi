; Writable state for the direct-Z80 counted-loop proof target.

STTBS         EQU EXCTNBS ;@NUC-GLOBAL StateBase PERMANENT STTBS
RunState          EQU STTBS+$00
TRPNMBR        EQU STTBS+$01 ;@NUC-GLOBAL TrapNumber PERMANENT TRPNMBR
TRPRTN       EQU STTBS+$02 ;@NUC-GLOBAL TrapRoutine PERMANENT TRPRTN
TRPOFFST        EQU STTBS+$03 ;@NUC-GLOBAL TrapOffset PERMANENT TRPOFFST
TRPERRR         EQU STTBS+$05 ;@NUC-GLOBAL TrapError PERMANENT TRPERRR
ACTVTNDP   EQU STTBS+$06 ;@NUC-GLOBAL ActivationDepth PERMANENT ACTVTNDP
ACTVTNLM   EQU STTBS+$07 ;@NUC-GLOBAL ActivationLimit PERMANENT ACTVTNLM
SCLRSLT        EQU STTBS+$08 ;@NUC-GLOBAL ScalarSlot PERMANENT SCLRSLT
ACTVTNAR   EQU STTBS+$09 ;@NUC-GLOBAL ActivationArena PERMANENT ACTVTNAR
ACTVTNCP EQU 8 ;@NUC-GLOBAL ActivationCapacity PERMANENT ACTVTNCP
RootSP            EQU ACTVTNAR+ACTVTNCP
RootIX            EQU RootSP+2
StateEnd          EQU RootIX+2

RunReady          EQU 1
RNSCCDD      EQU 2 ;@NUC-GLOBAL RunSucceeded PERMANENT RNSCCDD
RNTRPPD        EQU 3 ;@NUC-GLOBAL RunTrapped PERMANENT RNTRPPD

SRVCFLRC      EQU SRVCBS+$00 ;@NUC-GLOBAL ServiceFailureCall PERMANENT SRVCFLRC
SRVCCLLC        EQU SRVCBS+$01 ;@NUC-GLOBAL ServiceCallCount PERMANENT SRVCCLLC
SRVCOTPT     EQU SRVCBS+$02 ;@NUC-GLOBAL ServiceOutputLength PERMANENT SRVCOTPT
SRVCOTP0       EQU SRVCBS+$03 ;@NUC-GLOBAL ServiceOutputBase PERMANENT SRVCOTP0
SRVCOTP1   EQU 4 ;@NUC-GLOBAL ServiceOutputCapacity PERMANENT SRVCOTP1
SRVCINPT      EQU SRVCBS+$07 ;@NUC-GLOBAL ServiceInputLength PERMANENT SRVCINPT
SRVCINP0      EQU SRVCBS+$08 ;@NUC-GLOBAL ServiceInputCursor PERMANENT SRVCINP0
SRVCINP1     EQU SRVCBS+$09 ;@NUC-GLOBAL ServiceInputFailure PERMANENT SRVCINP1
SRVCINP2        EQU SRVCBS+$0A ;@NUC-GLOBAL ServiceInputBase PERMANENT SRVCINP2
SRVCINP3    EQU 4 ;@NUC-GLOBAL ServiceInputCapacity PERMANENT SRVCINP3
SRVCSTRG  EQU SRVCBS+$0E ;@NUC-GLOBAL ServiceStorageInputLength PERMANENT SRVCSTRG
SRVCSTR0  EQU SRVCBS+$0F ;@NUC-GLOBAL ServiceStorageInputCursor PERMANENT SRVCSTR0
SRVCSTR1 EQU SRVCBS+$10 ;@NUC-GLOBAL ServiceStorageInputFailure PERMANENT SRVCSTR1
SRVCSTR2    EQU SRVCBS+$11 ;@NUC-GLOBAL ServiceStorageInputBase PERMANENT SRVCSTR2
SRVCSTR3 EQU 4 ;@NUC-GLOBAL ServiceStorageInputCapacity PERMANENT SRVCSTR3
SRVCSTR4  EQU SRVCBS+$15 ;@NUC-GLOBAL ServiceStorageOutputLength PERMANENT SRVCSTR4
SRVCSTR5  EQU SRVCBS+$16 ;@NUC-GLOBAL ServiceStorageOutputCursor PERMANENT SRVCSTR5
SRVCSTR6 EQU SRVCBS+$17 ;@NUC-GLOBAL ServiceStorageOutputFailure PERMANENT SRVCSTR6
SRVCSTR7    EQU SRVCBS+$18 ;@NUC-GLOBAL ServiceStorageOutputBase PERMANENT SRVCSTR7
SRVCSTR8 EQU 4 ;@NUC-GLOBAL ServiceStorageOutputCapacity PERMANENT SRVCSTR8
SRVCSTTE         EQU SRVCSTR7+SRVCSTR8 ;@NUC-GLOBAL ServiceStateEnd PERMANENT SRVCSTTE

PRGRMSZ       EQU 54 ;@NUC-GLOBAL ProgramSize PERMANENT PRGRMSZ
LPFLROFF EQU 30 ;@NUC-GLOBAL LoopFailureOffset PERMANENT LPFLROFF
GNRTDEND      EQU GNRTDBS+PRGRMSZ ;@NUC-GLOBAL GeneratedEnd PERMANENT GNRTDEND

ARRYPRGR  EQU 74 ;@NUC-GLOBAL ArrayProgramSize PERMANENT ARRYPRGR
ARRYINPT EQU 0 ;@NUC-GLOBAL ArrayInputFailureOffset PERMANENT ARRYINPT
ARRYBNDS EQU 10 ;@NUC-GLOBAL ArrayBoundsOffset PERMANENT ARRYBNDS
ARRYOTPT EQU 22 ;@NUC-GLOBAL ArrayOutputFailureOffset PERMANENT ARRYOTPT
GNRTDARR       EQU GNRTDBS+ARRYPRGR ;@NUC-GLOBAL GeneratedArrayEnd PERMANENT GNRTDARR

CLLPRGRM   EQU 99 ;@NUC-GLOBAL CallProgramSize PERMANENT CLLPRGRM
CLLFLROF EQU 95 ;@NUC-GLOBAL CallFailureOffset PERMANENT CLLFLROF
CLLCPCTY EQU 203 ;@NUC-GLOBAL CallCapacityOffset PERMANENT CLLCPCTY
GNRTDCLL        EQU GNRTDBS+CLLPRGRM ;@NUC-GLOBAL GeneratedCallEnd PERMANENT GNRTDCLL
