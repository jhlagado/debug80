            JP   C,PRFLPRNG

            LD   A,198
            LD   HL,STG8IMMD
            LD   DE,STG8IMM0
            CALL CMPLAGG0
            JP   C,PRFRDSGN
            CALL ENCDAGGR
            JP   C,PRFRDSGN
            CALL Reset
            CALL PRFCLLGN
            JP   C,PRFRDSGN
            LD   A,(RunState)
            CP   RNSCCDD
            JP   NZ,PRFRDSGN
            LD   A,(SRVCOTPT)
            CP   2
            JP   NZ,PRFRDSGN
            LD   A,(SRVCOTP0)
            CP   'H'
            JP   NZ,PRFRDSGN
            LD   A,(SRVCOTP0+1)
            CP   7
            JP   NZ,PRFRDSGN
            LD   A,(ACTVTNDP)
            OR   A
            JP   NZ,PRFRDSGN

            LD   A,116
            LD   (PRFCS),A
            LD   A,199
            LD   HL,STG8HNDL
            LD   DE,STG8HND1
            CALL CMPLAGG0
            JP   C,PRFRDSGN
            CALL ENCDAGGR
            JP   C,PRFRDSGN
            CALL Reset
            LD   A,1
            LD   (SRVCFLRC),A
            CALL PRFCLLGN
            JP   C,PRFRDSGN
            LD   A,(RunState)
            CP   RNTRPPD
            JP   NZ,PRFRDSGN
            LD   A,(TRPNMBR)
            CP   6
            JP   NZ,PRFRDSGN
            LD   A,(TRPERRR)
            CP   3
            JP   NZ,PRFRDSGN
