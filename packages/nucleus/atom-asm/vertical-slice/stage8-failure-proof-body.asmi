            JP   NZ,PRFRSLT1
            LD   A,(SRVCOTPT)
            CP   1
            JP   NZ,PRFRSLT1
            LD   A,(SRVCOTP0)
            CP   'R'
            JP   NZ,PRFRSLT1
            LD   A,(ACTVTNDP)
