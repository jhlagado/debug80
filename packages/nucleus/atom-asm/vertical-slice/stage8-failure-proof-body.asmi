            LD   A,DGNSTCFL
            LD   BC,S8E0V
            LD   HL,STG8LGC2
            LD   DE,STG8LGC4
            CALL PRFEXPCT
            JP   C,PRFRDSGN
            LD   A,121
            LD   (PRFCS),A
            LD   A,DGNSTCFL
            LD   BC,S8E0W
            LD   HL,STG8INFL
            LD   DE,STG8INF1
            CALL PRFEXPCT
            JP   C,PRFRDSGN
            LD   A,122
            LD   (PRFCS),A
            LD   A,DGNSTCFL
            LD   BC,S8E0X
            LD   HL,STG8INF2
            LD   DE,STG8INF4
            CALL PRFEXPCT
            JP   C,PRFRDSGN
            LD   A,123
            LD   (PRFCS),A
            LD   A,DGNSTCFL
            LD   BC,S8E0Y
            LD   HL,STG8DBLC
            LD   DE,STG8DBL1
            CALL PRFEXPCT
