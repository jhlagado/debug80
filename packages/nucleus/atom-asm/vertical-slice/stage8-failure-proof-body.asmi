            LD   BC,S8E16
            LD   HL,STG8AGG7
            LD   DE,STG8AGG9
            CALL PRFEXPCT
            JP   C,PRFRDSGN
            LD   A,132
            LD   (PRFCS),A
            LD   A,DGNSTCAC
            LD   BC,S8E17
            LD   HL,STG8CNTR
            LD   DE,STG8CNT1
            CALL PRFEXPCT
            JP   C,PRFRDSGN

            XOR  A
            LD   (PRFCS),A
            LD   A,$A5
            LD   (PRFSTTS),A
            HALT

; A is the expected diagnostic, BC its offset, HL/DE the source range.
;@ROUTINE IN A,BC,DE,HL OUT A,CARRY,ZERO CLOBBERS SIGN,PARITY,HALFCARRY,BC,DE,HL,IX,IY
PRFEXPCT: ;@NUC-GLOBAL ProofExpectDiagnostic PERMANENT PRFEXPCT
            LD   (PRFEXPC5),A
            LD   (PRFEXPC3),BC
            LD   A,171
            CALL CMPLAGG0
            JR   NC,PRFEXPC2
            LD   A,(PRFEXPC5)
            LD   HL,DGNSTCCD
            CP   (HL)
            JR   NZ,PRFEXPC2
            LD   HL,(DGNSTCOF)
            LD   DE,(PRFEXPC3)
            OR   A
            SBC  HL,DE
            RET  Z
PRFEXPC2: ;@NUC-GLOBAL ProofExpectedDiagnosticFailure PERMANENT PRFEXPC2
            SCF
            RET

; Check publication before a later diagnostic overlays the emission cursor.
;@ROUTINE OUT A,CARRY,ZERO CLOBBERS SIGN,PARITY,HALFCARRY,DE,HL
PRFVLDTP: ;@NUC-GLOBAL ProofValidatePublication PERMANENT PRFVLDTP
            LD   HL,(GNRTDSZ)
            LD   DE,GNRTDBS
            ADD  HL,DE
            LD   DE,(EMTCRSR)
            OR   A
            SBC  HL,DE
            RET  Z
            SCF
            RET

; A/BC select the exact trap and source offset; HL/DE select the source. Input
; byte zero is supplied for the bounds/division cases and is inert otherwise.
;@ROUTINE IN A,BC,DE,HL OUT A,CARRY,ZERO CLOBBERS SIGN,PARITY,HALFCARRY,BC,DE,HL,IX,IY
PRFEXPC6: ;@NUC-GLOBAL ProofExpectRuntimeTrap PERMANENT PRFEXPC6
            LD   (PRFEXPC8),A
            LD   (PRFEXPC3),BC
            LD   A,190
            CALL CMPLAGG0
            RET  C
            CALL ENCDAGGR
            RET  C
            CALL Reset
            LD   A,1
            LD   (SRVCINPT),A
            LD   A,(PRFEXPC8)
            CP   1
            LD   A,0
            JR   NZ,.L00000
            LD   A,2
.L00000:
            LD   (SRVCINP2),A
            CALL PRFCLLGN
            RET  C
            LD   A,(RunState)
            CP   RNTRPPD
            JR   NZ,.L00001
            LD   A,(PRFEXPC8)
            LD   HL,TRPNMBR
            CP   (HL)
            JR   NZ,.L00001
            LD   HL,(TRPOFFST)
            LD   DE,(PRFEXPC3)
            OR   A
            SBC  HL,DE
            JR   NZ,.L00001
            LD   A,(ACTVTNDP)
            OR   A
            JR   NZ,.L00001
            LD   A,(SRVCOTPT)
            OR   A
            RET  Z
.L00001:
            SCF
            RET

; Generated code must restore the root SP and IX on terminal failure.
;@ROUTINE OUT A,CARRY,ZERO CLOBBERS SIGN,PARITY,HALFCARRY,BC,DE,HL,IX,IY
PRFCLLGN: ;@NUC-GLOBAL ProofCallGenerated PERMANENT PRFCLLGN
            LD   HL,0
            ADD  HL,SP
            LD   (PRFEXPC0),HL
            LD   IX,$A55A
            CALL GNRTDBS
            PUSH IX
            POP  DE
            LD   HL,$A55A
            OR   A
            SBC  HL,DE
            JR   NZ,PRFCLLG1
            LD   HL,0
            ADD  HL,SP
            LD   DE,(PRFEXPC0)
            OR   A
            SBC  HL,DE
            RET  Z
PRFCLLG1: ;@NUC-GLOBAL ProofCallGeneratedFailure PERMANENT PRFCLLG1
            SCF
            RET

