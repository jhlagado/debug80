            LD   A,189
            LD   HL,STG8FRW0
            LD   DE,STG8FRW1
            CALL CMPLAGG0
            JP   C,PRFFRWR0
            CALL ENCDAGGR
            JP   C,PRFFRWR1
            CALL PRFVLDTP
            JP   C,PRFPBLCT
            CALL Reset
            CALL PRFCLLGN
            JP   C,PRFFRWR2
            LD   A,(RunState)
