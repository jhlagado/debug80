            ORG $D000
S8E00 EQU STG8MNF0-STG8MNFL
S8E01 EQU STG8INF6-STG8INF5
S8E02 EQU STG8FLR2+5-STG8FLR1
S8E03 EQU STG8FLR4-1-STG8FLRF
S8E04 EQU STG8PRP2-STG8PRP1
S8E05 EQU STG8RDI0-STG8RDIN
S8E06 EQU STG8INC2-STG8INC1
S8E07 EQU STG8PRD3-STG8PRD2
S8E08 EQU STG8PRD6-STG8PRD5
S8E09 EQU STG8PRD9-STG8PRD8
S8E0A EQU STG8WRT0+4-STG8WRTS
S8E0B EQU STG8SKS0+4-STG8SKST
S8E0C EQU STG8SCN0-STG8SCND
S8E0D EQU STG8UNK0-STG8UNKN
S8E0E EQU STG8UNC0-1-STG8UNCN
S8E0F EQU STG8NST0-STG8NSTD
S8E0G EQU STG8SRVB+15-STG8SRVA
S8E0H EQU STG8CMP0-STG8CMPS
S8E0I EQU STG8AGG0-STG8AGGR
S8E0J EQU STG8IND0-STG8INDX
S8E0K EQU STG8AGG3-STG8AGG2
S8E0L EQU STG8TRPR-STG8TRPB
S8E0M EQU STG8INC0-STG8INCM
S8E0N EQU STG8BND0-STG8BNDS
S8E0O EQU STG8NRR0-STG8NRRW
S8E0P EQU STG8DVD0-STG8DVDT
S8E0Q EQU STG8LPR0-STG8LPRN
S8E0R EQU STG8HND0-STG8HNDL
S8E0S EQU STG8BRL0-STG8BRLC
S8E0T EQU STG8BRA0-STG8BRAS
S8E0U EQU STG8LGC0-STG8LGCY
S8E0V EQU STG8LGC3-STG8LGC2
S8E0W EQU STG8INF0-STG8INFL
S8E0X EQU STG8INF3-STG8INF2
S8E0Y EQU STG8DBL0-STG8DBLC
S8E0Z EQU STG8LCL0-STG8LCLH
S8E10 EQU STG8RSL2-STG8RSL1
S8E11 EQU STG8FRR0-STG8FRRT
S8E12 EQU STG8MSS0-STG8MSSN
S8E13 EQU STG8UNK3-STG8UNK2
S8E14 EQU STG8WDH0-STG8WDHN
S8E15 EQU STG8CNS1-STG8CNST
S8E16 EQU STG8AGG8-STG8AGG7
S8E17 EQU STG8CNT0-STG8CNTR

;@ROUTINE OUT CARRY,ZERO CLOBBERS SIGN,PARITY,HALFCARRY,A,BC,DE,HL,IX,IY
PRFSTRT: ;@NUC-GLOBAL ProofStart PERMANENT PRFSTRT
            LD   SP,StackTop
            XOR  A
            LD   (PRFSTTS),A
            LD   (PRFCS),A

            LD   A,170
            LD   HL,STG8MNFL
            LD   DE,STG8MNF1
            CALL CMPLAGG0
            JP   C,PRFCMPLF
            CALL ENCDAGGR
            JP   C,PRFENCDF
            CALL Reset
            CALL PRFCLLGN
            JP   C,PRFFRMFL
            LD   A,(RunState)
            CP   RNTRPPD
            JP   NZ,PRFTRPST
            LD   A,(TRPNMBR)
            CP   6
            JP   NZ,PRFTRPRS
            LD   A,(TRPERRR)
            CP   7
            JP   NZ,PRFTRPER
            LD   HL,(TRPOFFST)
            LD   DE,S8E00
            LD   (PRFACTLT),HL
            LD   (PRFEXPC7),DE
            OR   A
            SBC  HL,DE
            JP   NZ,PRFTRPOF
            LD   A,(ACTVTNDP)
            OR   A
            JP   NZ,PRFACTVT

            LD   A,DGNSTCFL
            LD   BC,S8E01
            LD   HL,STG8INF5
            LD   DE,STG8INF7
            CALL PRFEXPCT
            JP   C,PRFINFLL

            LD   A,DGNSTCIN
            LD   BC,S8E02
            LD   HL,STG8FLR1
            LD   DE,STG8FLR3
            CALL PRFEXPCT
            JP   C,PRFRNGFL

            LD   A,DGNSTCR0
            LD   BC,S8E03
            LD   HL,STG8FLRF
            LD   DE,STG8FLR5
            CALL PRFEXPCT
            JP   C,PRFFLWFL

            LD   A,172
            LD   HL,STG8PRPG
            LD   DE,STG8PRP0
            CALL CMPLAGG0
            JP   C,PRFPRPGT
            CALL ENCDAGGR
            JP   C,PRFPRPG0
            CALL Reset
            CALL PRFCLLGN
            JP   C,PRFPRPG1
            LD   A,(RunState)
            CP   RNSCCDD
            JP   NZ,PRFPRPG1
            LD   A,(SRVCOTPT)
            CP   1
            JP   NZ,PRFPRPG1
            LD   A,(SRVCOTP0)
            CP   'A'
            JP   NZ,PRFPRPG1

            LD   A,173
            LD   HL,STG8PRP1
            LD   DE,STG8PRP3
            CALL CMPLAGG0
            JP   C,PRFPRPG2
            CALL ENCDAGGR
            JP   C,PRFPRPG3
            CALL Reset
            CALL PRFCLLGN
            JP   C,PRFPRPG4
            LD   A,(RunState)
            CP   RNTRPPD
            JP   NZ,PRFPRPG4
            LD   A,(TRPNMBR)
            CP   6
            JP   NZ,PRFPRPG4
            LD   A,(TRPERRR)
            CP   10
            JP   NZ,PRFPRPG4
            LD   HL,(TRPOFFST)
            LD   DE,S8E04
            OR   A
            SBC  HL,DE
            JP   NZ,PRFPRPG4

            LD   A,174
            LD   HL,STG8BRRT
            LD   DE,STG8BRR0
            CALL CMPLAGG0
            JP   C,PRFBRRTR
            CALL ENCDAGGR
            JP   C,PRFBRRT0
            CALL Reset
            CALL PRFCLLGN
            JP   C,PRFBRRT1
            LD   A,(RunState)
            CP   RNSCCDD
            JP   NZ,PRFBRRT1
            LD   A,(SRVCOTPT)
            CP   1
            JP   NZ,PRFBRRT1
            LD   A,(SRVCOTP0)
            OR   A
            JP   NZ,PRFBRRT1

            LD   A,175
            LD   HL,STG8SXTN
            LD   DE,STG8SXT0
            CALL CMPLAGG0
            JP   C,PRFSXTNC
            CALL ENCDAGGR
            JP   C,PRFSXTNE
            CALL Reset
            CALL PRFCLLGN
            JP   C,PRFSXTNR
            LD   A,(RunState)
            CP   RNSCCDD
            JP   NZ,PRFSXTNR
            LD   A,(SRVCOTPT)
            CP   1
            JP   NZ,PRFSXTNR
            LD   A,(SRVCOTP0)
            CP   16
            JP   NZ,PRFSXTNR

            LD   A,176
            LD   HL,STG8LCL2
            LD   DE,STG8LCL3
            CALL CMPLAGG0
            JP   C,PRFHNDLR
            CALL ENCDAGGR
            JP   C,PRFHNDL0
            CALL Reset
            CALL PRFCLLGN
            JP   C,PRFHNDL1
            LD   A,(RunState)
            CP   RNSCCDD
            JP   NZ,PRFHNDL1
            LD   A,(SRVCOTPT)
            CP   1
            JP   NZ,PRFHNDL1
            LD   A,(SRVCOTP0)
            CP   7
            JP   NZ,PRFHNDL1

            LD   A,204
            LD   HL,STG8PRGR
            LD   DE,STG8PRG0
            CALL CMPLAGG0
            JP   C,PRFPRGRM
            CALL ENCDAGGR
            JP   C,PRFPRGR0
            CALL Reset
            CALL PRFCLLGN
            JP   C,PRFPRGR1
            LD   A,(RunState)
            CP   RNSCCDD
            JP   NZ,PRFPRGR1
            LD   A,(ACTVTNDP)
            OR   A
            JP   NZ,PRFPRGR1
            LD   A,(PRGRMBS0)
            CP   7
            JP   NZ,PRFPRGR1
            LD   A,(SRVCOTPT)
            CP   1
            JP   NZ,PRFPRGR1
            LD   A,(SRVCOTP0)
            CP   8
            JP   NZ,PRFPRGR1

            LD   A,177
            LD   HL,STG8RDIN
            LD   DE,STG8RDI1
            CALL CMPLAGG0
            JP   C,PRFRDSCC
            CALL ENCDAGGR
            JP   C,PRFRDSC0
            CALL Reset
            LD   A,1
            LD   (SRVCINPT),A
            LD   A,'Q'
            LD   (SRVCINP2),A
            CALL PRFCLLGN
            JP   C,PRFRDSC1
            LD   A,(RunState)
            CP   RNSCCDD
            JP   NZ,PRFRDSC1
            LD   A,(SRVCINP0)
            CP   1
            JP   NZ,PRFRDSC1
            LD   A,(SRVCOTP0)
            CP   'Q'
            JP   NZ,PRFRDSC1
            CALL Reset
            LD   A,1
            LD   (SRVCINPT),A
            LD   A,'Q'
            LD   (SRVCINP2),A
            LD   A,1
            LD   (SRVCFLRC),A
            CALL PRFCLLGN
            JP   C,PRFRDSC1
            LD   A,(RunState)
            CP   RNTRPPD
            JP   NZ,PRFRDSC1
            LD   A,(TRPERRR)
            CP   3
            JP   NZ,PRFRDSC1
            LD   HL,(TRPOFFST)
            LD   DE,S8E05
            OR   A
            SBC  HL,DE
            JP   NZ,PRFRDSC1

            LD   A,117
            LD   (PRFCS),A
            LD   A,178
            LD   HL,STG8SRVE
            LD   DE,STG8SRVF
            CALL CMPLAGG0
            JP   C,PRFRDSGN
            CALL ENCDAGGR
            JP   C,PRFRDSGN
            CALL Reset
            CALL PRFCLLGN
            JP   C,PRFRDSGN
            LD   A,(RunState)
            CP   RNSCCDD
            JP   NZ,PRFRDSGN
            LD   A,(SRVCOTPT)
            CP   1
            JP   NZ,PRFRDSGN
            LD   A,(SRVCOTP0)
            CP   1
            JP   NZ,PRFRDSGN
            LD   A,(ACTVTNDP)
            OR   A
            JP   NZ,PRFRDSGN

            LD   A,178
            LD   HL,STG8RDI2
            LD   DE,STG8RDI3
            CALL CMPLAGG0
            JP   C,PRFRDHND
            CALL ENCDAGGR
            JP   C,PRFRDHN0
            CALL Reset
            XOR  A
            LD   (SRVCINPT),A
            CALL PRFCLLGN
            JP   C,PRFRDHN1
            LD   A,(RunState)
            CP   RNSCCDD
            JP   NZ,PRFRDHN1
            LD   A,(SRVCINP0)
            OR   A
            JP   NZ,PRFRDHN1
            LD   A,(SRVCOTPT)
            CP   1
            JP   NZ,PRFRDHN1
            LD   A,(SRVCOTP0)
            CP   1
            JP   NZ,PRFRDHN1

            ; The same handler must receive inputFailure without advancing the
            ; cursor or converting the recoverable error into a trap.
            CALL Reset
            LD   A,2
            LD   (SRVCINP1),A
            CALL PRFCLLGN
            JP   C,PRFRDHN1
            LD   A,(RunState)
            CP   RNSCCDD
            JP   NZ,PRFRDHN1
            LD   A,(SRVCINP0)
            OR   A
            JP   NZ,PRFRDHN1
            LD   A,(SRVCOTP0)
            CP   2
            JP   NZ,PRFRDHN1

            ; A distinct reset run must not inherit the configured failure.
            CALL Reset
            LD   A,(SRVCINP1)
            OR   A
            JP   NZ,PRFRDHN1
            LD   A,1
            LD   (SRVCINPT),A
            LD   A,'Q'
            LD   (SRVCINP2),A
            CALL PRFCLLGN
            JP   C,PRFRDHN1
            LD   A,(RunState)
            CP   RNSCCDD
            JP   NZ,PRFRDHN1
            LD   A,(SRVCINP0)
            CP   1
            JP   NZ,PRFRDHN1
            LD   A,(SRVCOTP0)
            CP   'Q'
            JP   NZ,PRFRDHN1

            LD   A,179
            LD   HL,STG8CNS3
            LD   DE,STG8CNS4
            CALL CMPLAGG0
            JP   C,PRFCNST4
            CALL ENCDAGGR
            JP   C,PRFCNST5
            CALL Reset
            CALL PRFCLLGN
            JP   C,PRFCNST6
            LD   A,(RunState)
            CP   RNSCCDD
            JP   NZ,PRFCNST6
            LD   A,(SRVCOTP0)
            CP   'C'
            JP   NZ,PRFCNST6

            LD   A,180
            LD   HL,STG8STRG
            LD   DE,STG8STR0
            CALL CMPLAGG0
            JP   C,PRFSTRGC
            CALL ENCDAGGR
            JP   C,PRFSTRGE
            CALL Reset
            XOR  A
            LD   (SRVCSTR1),A
            LD   (SRVCSTR6),A
            INC  A
            LD   (SRVCSTRG),A
            LD   A,'A'
            LD   (SRVCSTR2),A
            CALL PRFCLLGN
            JP   C,PRFSTRGR
            LD   A,(RunState)
            CP   RNSCCDD
            JP   NZ,PRFSTRGR
            LD   A,(SRVCSTR0)
            CP   1
            JP   NZ,PRFSTRGR
            LD   A,(SRVCSTR4)
            CP   2
            JP   NZ,PRFSTRGR
            LD   A,(SRVCSTR5)
            CP   1
            JP   NZ,PRFSTRGR
            LD   A,(SRVCSTR7)
            CP   'Z'
            JP   NZ,PRFSTRGR
            LD   A,(SRVCSTR7+1)
            CP   'B'
            JP   NZ,PRFSTRGR
            LD   A,(SRVCOTP0)
            CP   'A'
            JP   NZ,PRFSTRGR

            LD   A,181
            LD   HL,STG8WRTF
            LD   DE,STG8WRT2
            CALL CMPLAGG0
            JP   C,PRFWRTFL
            CALL ENCDAGGR
            JP   C,PRFWRTF0
            CALL Reset
            LD   A,1
            LD   (SRVCSTR6),A
            LD   (SRVCSTR5),A
            INC  A
            LD   (SRVCSTR4),A
            LD   A,'X'
            LD   (SRVCSTR7),A
            LD   A,'Y'
            LD   (SRVCSTR7+1),A
            CALL PRFCLLGN
            JP   C,PRFWRTF1
            LD   A,(RunState)
            CP   RNSCCDD
            JP   NZ,PRFWRTF1
            LD   A,(SRVCSTR4)
            CP   2
            JP   NZ,PRFWRTF1
            LD   A,(SRVCSTR5)
            CP   1
            JP   NZ,PRFWRTF1
            LD   A,(SRVCSTR7)
            CP   'X'
            JP   NZ,PRFWRTF1
            LD   A,(SRVCSTR7+1)
            CP   'Y'
            JP   NZ,PRFWRTF1
            LD   A,(SRVCOTP0)
            CP   4
            JP   NZ,PRFWRTF1

            LD   A,182
            LD   HL,STG8SKFL
            LD   DE,STG8SKF0
            CALL CMPLAGG0
            JP   C,PRFSKFLR
            CALL ENCDAGGR
            JP   C,PRFSKFL0
            CALL Reset
            XOR  A
            LD   (SRVCSTR6),A
            INC  A
            LD   (SRVCSTR5),A
            INC  A
            LD   (SRVCSTR4),A
            CALL PRFCLLGN
            JP   C,PRFSKFL1
            LD   A,(RunState)
            CP   RNSCCDD
            JP   NZ,PRFSKFL1
            LD   A,(SRVCSTR5)
            CP   1
            JP   NZ,PRFSKFL1
            LD   A,(SRVCOTP0)
            CP   4
            JP   NZ,PRFSKFL1

            LD   A,183
            LD   HL,STG8RWND
            LD   DE,STG8RWN0
            CALL CMPLAGG0
            JP   C,PRFRWNDF
            CALL ENCDAGGR
            JP   C,PRFRWND0
            CALL Reset
            LD   A,1
            LD   (SRVCSTR1),A
            INC  A
            LD   (SRVCSTR0),A
            CALL PRFCLLGN
            JP   C,PRFRWND1
            LD   A,(RunState)
            CP   RNSCCDD
            JP   NZ,PRFRWND1
            LD   A,(SRVCSTR0)
            CP   2
            JP   NZ,PRFRWND1
            LD   A,(SRVCOTP0)
            CP   4
            JP   NZ,PRFRWND1

            LD   A,184
            LD   HL,STG8RDST
            LD   DE,STG8RDS0
            CALL CMPLAGG0
            JP   C,PRFRDSTR
            CALL ENCDAGGR
            JP   C,PRFRDST0
            CALL Reset
            XOR  A
            LD   (SRVCSTR1),A
            LD   (SRVCSTRG),A
            CALL PRFCLLGN
            JP   C,PRFRDST1
            LD   A,(RunState)
            CP   RNSCCDD
            JP   NZ,PRFRDST1
            LD   A,(SRVCSTR0)
            OR   A
            JP   NZ,PRFRDST1
            LD   A,(SRVCOTP0)
            CP   1
            JP   NZ,PRFRDST1

            LD   A,185
            LD   HL,STG8WRTO
            LD   DE,STG8WRT3
            CALL CMPLAGG0
            JP   C,PRFWRTOT
            CALL ENCDAGGR
            JP   C,PRFWRTO0
            CALL Reset
            LD   A,1
            LD   (SRVCFLRC),A
            CALL PRFCLLGN
            JP   C,PRFWRTO1
            LD   A,(RunState)
            CP   RNSCCDD
            JP   NZ,PRFWRTO1
            LD   A,(SRVCOTPT)
            OR   A
            JP   NZ,PRFWRTO1
            XOR  A
            LD   (SRVCFLRC),A

            LD   A,186
            LD   HL,STG8MTLF
            LD   DE,STG8MTL0
            CALL CMPLAGG0
            JP   C,PRFMTLCM
            CALL ENCDAGGR
            JP   C,PRFMTLEN
            CALL Reset
            CALL PRFCLLGN
            JP   C,PRFMTLRN
            LD   A,(RunState)
            CP   RNSCCDD
            JP   NZ,PRFMTLRN
            LD   A,(SRVCOTPT)
            CP   1
            JP   NZ,PRFMTLRN
            LD   A,(SRVCOTP0)
            CP   'M'
            JP   NZ,PRFMTLRN

            LD   A,DGNSTCF0
            LD   BC,S8E06
            LD   HL,STG8INC1
            LD   DE,STG8INC2
            CALL PRFEXPCT
            JP   C,PRFINCMP

            LD   A,DGNSTCDP
            LD   BC,S8E07
            LD   HL,STG8PRD2
            LD   DE,STG8PRD4
            CALL PRFEXPCT
            JP   C,PRFPRDFN
            LD   HL,(DGNSTCLN)
            LD   DE,1
            OR   A
            SBC  HL,DE
            JP   NZ,PRFPRDFN
            LD   HL,(DGNSTCCL)
            LD   DE,5
            OR   A
            SBC  HL,DE
            JP   NZ,PRFPRDFN

            LD   A,DGNSTCDP
            LD   BC,S8E08
            LD   HL,STG8PRD5
            LD   DE,STG8PRD7
            CALL PRFEXPCT
            JP   C,PRFPRDF0

            LD   A,DGNSTCDP
            LD   BC,S8E09
            LD   HL,STG8PRD8
            LD   DE,STG8PRDA
            CALL PRFEXPCT
            JP   C,PRFPRDF1

            LD   A,DGNSTCTY
            LD   BC,S8E0A
            LD   HL,STG8WRTS
            LD   DE,STG8WRT1
            CALL PRFEXPCT
            JP   C,PRFWRTST

            LD   A,DGNSTCTY
            LD   BC,S8E0B
            LD   HL,STG8SKST
            LD   DE,STG8SKS1
            CALL PRFEXPCT
            JP   C,PRFSKSTR

            LD   A,DGNSTCDP
            LD   BC,S8E0C
            LD   HL,STG8SCND
            LD   DE,STG8SCN1
            CALL PRFEXPCT
            JP   C,PRFSCNDF

            LD   A,DGNSTCUN
            LD   BC,S8E0D
            LD   HL,STG8UNKN
            LD   DE,STG8UNK1
            CALL PRFEXPCT
            JP   C,PRFUNKNW

            LD   A,DGNSTCFL
            LD   BC,S8E0E
            LD   HL,STG8UNCN
            LD   DE,STG8UNC1
            CALL PRFEXPCT
            JP   C,PRFUNCNS

            LD   A,DGNSTCFL
            LD   BC,S8E0F
            LD   HL,STG8NSTD
            LD   DE,STG8NST1
            CALL PRFEXPCT
            JP   C,PRFNSTDS

            LD   A,DGNSTCFL
            LD   BC,S8E0G
            LD   HL,STG8SRVA
            LD   DE,STG8SRVD
            CALL PRFEXPCT
            JP   C,PRFSRVCA

            LD   A,DGNSTCFL
            LD   BC,S8E0H
            LD   HL,STG8CMPS
            LD   DE,STG8CMP1
            CALL PRFEXPCT
            JP   C,PRFCMPSD

            LD   A,DGNSTCFL
            LD   BC,S8E0I
            LD   HL,STG8AGGR
            LD   DE,STG8AGG1
            CALL PRFEXPCT
            JP   C,PRFAGGRG

            LD   A,DGNSTCFL
            LD   BC,S8E0J
            LD   HL,STG8INDX
            LD   DE,STG8IND1
            CALL PRFEXPCT
            JP   C,PRFINDXF

            LD   A,DGNSTCFL
            LD   BC,S8E0K
            LD   HL,STG8AGG2
            LD   DE,STG8AGG4
            CALL PRFEXPCT
            JP   C,PRFAGGR0

            LD   A,192
            LD   HL,STG8NST2
            LD   DE,STG8NST3
            CALL CMPLAGG0
            JP   C,PRFNSTDF
            CALL ENCDAGGR
            JP   C,PRFNSTD0
            CALL Reset
            CALL PRFCLLGN
            JP   C,PRFNSTD1
            LD   A,(RunState)
            CP   RNSCCDD
            JP   NZ,PRFNSTD1
            LD   A,(SRVCOTPT)
            CP   1
            JP   NZ,PRFNSTD1
            LD   A,(SRVCOTP0)
            CP   'N'
            JP   NZ,PRFNSTD1
            LD   A,(ACTVTNDP)
            OR   A
            JP   NZ,PRFNSTD1

            LD   A,193
            LD   HL,STG8PRDB
            LD   DE,STG8PRDC
            CALL CMPLAGG0
            JP   C,PRFPRDF2
            CALL ENCDAGGR
            JP   C,PRFPRDF3
            CALL Reset
            CALL PRFCLLGN
            JP   C,PRFPRDF4
            LD   A,(RunState)
            CP   RNSCCDD
            JP   NZ,PRFPRDF4
            LD   A,(SRVCOTPT)
            CP   2
            JP   NZ,PRFPRDF4
            LD   A,(SRVCOTP0)
            CP   'S'
            JP   NZ,PRFPRDF4
            LD   A,(SRVCOTP0+1)
            CP   'S'
            JP   NZ,PRFPRDF4

            LD   A,115
            LD   (PRFCS),A
            LD   A,198
            LD   HL,STG8RTN2
            LD   DE,STG8RTN3
            CALL CMPLAGG0
            JP   C,PRFRTNDF
            LD   HL,(STG8CLLM)
            INC  HL
            INC  HL
            LD   A,(HL)
            CP   1
            JP   NZ,PRFRTND2
            INC  HL
            LD   A,(HL)
            CP   SMNTCSTR
            JP   NZ,PRFRTND3

            LD   A,194
            LD   HL,STG8INDR
            LD   DE,STG8IND2
            CALL CMPLAGG0
            JP   C,PRFINDRC
            CALL ENCDAGGR
            JP   C,PRFINDR0
            CALL Reset
            CALL PRFCLLGN
            JP   C,PRFINDR1
            LD   A,(RunState)
            CP   RNSCCDD
            JP   NZ,PRFINDR1
            LD   A,(SRVCOTPT)
            CP   2
            JP   NZ,PRFINDR1
            LD   A,(SRVCOTP0)
            CP   7
            JP   NZ,PRFINDR1
            LD   A,(SRVCOTP0+1)
            CP   9
            JP   NZ,PRFINDR1
            LD   A,(ACTVTNDP)
            OR   A
            JP   NZ,PRFINDR1

            LD   A,195
            LD   HL,STG8AGG5
            LD   DE,STG8AGG6
            CALL CMPLAGG0
            JP   C,PRFAGGR1
            CALL ENCDAGGR
            JP   C,PRFAGGR2
            CALL Reset
            CALL PRFCLLGN
            JP   C,PRFAGGR3
            LD   A,(RunState)
            CP   RNSCCDD
            JP   NZ,PRFAGGR3
            LD   A,(SRVCOTPT)
            CP   3
            JP   NZ,PRFAGGR3
            LD   A,(SRVCOTP0)
            CP   5
            JP   NZ,PRFAGGR3
            LD   A,(SRVCOTP0+1)
            CP   7
            JP   NZ,PRFAGGR3
            LD   A,(SRVCOTP0+2)
            CP   5
            JP   NZ,PRFAGGR3
            LD   A,(ACTVTNDP)
            OR   A
            JP   NZ,PRFAGGR3

            LD   A,196
            LD   HL,STG8RTN0
            LD   DE,STG8RTN1
            CALL CMPLAGG0
            JP   C,PRFRTNDR
            CALL ENCDAGGR
            JP   C,PRFRTND0
            CALL Reset
            LD   A,4
            LD   (SRVCSTR1),A
            CALL PRFCLLGN
            JP   C,PRFRTND1
            LD   A,(RunState)
            CP   RNSCCDD
            JP   NZ,PRFRTND1
            LD   A,(SRVCOTPT)
