            JP   NZ,PRFTRPB2
            LD   A,(ACTVTNDP)
            OR   A
            JP   NZ,PRFTRPB2
            LD   A,(SRVCOTPT)
            OR   A
            JP   NZ,PRFTRPB2

            LD   A,188
            LD   HL,STG8RSLT
            LD   DE,STG8RSL0
            CALL CMPLAGG0
