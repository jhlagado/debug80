; Fixed state for the first Nucleus compiler proof.
;
; All addresses are within the compiler-workspace account. The symbols make
; the peak writable extent directly measurable from the AZM debug map.

CMPLRSTT       EQU CMPLRWR0 ;@NUC-GLOBAL CompilerStateBase PERMANENT CMPLRSTT

SRCPRTID            EQU CMPLRSTT+$00 ;@NUC-GLOBAL SourcePartId PERMANENT SRCPRTID
SRCCRSR            EQU CMPLRSTT+$01 ;@NUC-GLOBAL SourceCursor PERMANENT SRCCRSR
SRCEND               EQU CMPLRSTT+$03 ;@NUC-GLOBAL SourceEnd PERMANENT SRCEND
SRCOFFST            EQU CMPLRSTT+$05 ;@NUC-GLOBAL SourceOffset PERMANENT SRCOFFST
SRCLN              EQU CMPLRSTT+$07 ;@NUC-GLOBAL SourceLine PERMANENT SRCLN
SRCCLMN            EQU CMPLRSTT+$09 ;@NUC-GLOBAL SourceColumn PERMANENT SRCCLMN
SRCLNHST       EQU CMPLRSTT+$0B ;@NUC-GLOBAL SourceLineHasToken PERMANENT SRCLNHST
SRCDLMTR    EQU CMPLRSTT+$0C ;@NUC-GLOBAL SourceDelimiterDepth PERMANENT SRCDLMTR
TKNZREFP     EQU CMPLRSTT+$0D ;@NUC-GLOBAL TokenizerEofPending PERMANENT TKNZREFP

TKNKND               EQU CMPLRSTT+$0E ;@NUC-GLOBAL TokenKind PERMANENT TKNKND
TKNVL              EQU CMPLRSTT+$0F ;@NUC-GLOBAL TokenValue PERMANENT TKNVL
TKNSTRTO        EQU CMPLRSTT+$10 ;@NUC-GLOBAL TokenStartOffset PERMANENT TKNSTRTO
TKNSTRTL          EQU CMPLRSTT+$12 ;@NUC-GLOBAL TokenStartLine PERMANENT TKNSTRTL
TKNSTRTC        EQU CMPLRSTT+$14 ;@NUC-GLOBAL TokenStartColumn PERMANENT TKNSTRTC
TKNLXMPN      EQU CMPLRSTT+$16 ;@NUC-GLOBAL TokenLexemePointer PERMANENT TKNLXMPN
TKNLNGTH             EQU CMPLRSTT+$18 ;@NUC-GLOBAL TokenLength PERMANENT TKNLNGTH

PRSDOTPT        EQU CMPLRSTT+$19 ;@NUC-GLOBAL ParsedOutputByte PERMANENT PRSDOTPT
DGNSTCCD          EQU CMPLRSTT+$1A ;@NUC-GLOBAL DiagnosticCode PERMANENT DGNSTCCD
DGNSTCP0        EQU CMPLRSTT+$1B ;@NUC-GLOBAL DiagnosticPartId PERMANENT DGNSTCP0
DGNSTCOF        EQU CMPLRSTT+$1C ;@NUC-GLOBAL DiagnosticOffset PERMANENT DGNSTCOF
DGNSTCLN          EQU CMPLRSTT+$1E ;@NUC-GLOBAL DiagnosticLine PERMANENT DGNSTCLN
DGNSTCCL        EQU CMPLRSTT+$20 ;@NUC-GLOBAL DiagnosticColumn PERMANENT DGNSTCCL

SNKCRSR              EQU CMPLRSTT+$22 ;@NUC-GLOBAL SinkCursor PERMANENT SNKCRSR
SNKOPRTN      EQU CMPLRSTT+$24 ;@NUC-GLOBAL SinkOperationCount PERMANENT SNKOPRTN
GNRTDSZ           EQU CMPLRSTT+$25 ;@NUC-GLOBAL GeneratedSize PERMANENT GNRTDSZ

CMPLRST0        EQU CMPLRSTT+$27 ;@NUC-GLOBAL CompilerStateEnd PERMANENT CMPLRST0
SMNTCBFF      EQU CMPLRST0 ;@NUC-GLOBAL SemanticBufferBase PERMANENT SMNTCBFF
SMNTCBF0     EQU SMNTCBFF+$10 ;@NUC-GLOBAL SemanticBufferLimit PERMANENT SMNTCBF0
CMPLRWRK    EQU SMNTCBF0 ;@NUC-GLOBAL CompilerWorkspaceEnd PERMANENT CMPLRWRK

; Token ordinals needed by the fixed Stage-3 program.
TokenEof                EQU 0
TKNNWLN            EQU 1 ;@NUC-GLOBAL TokenNewline PERMANENT TKNNWLN
TKNNM               EQU 2 ;@NUC-GLOBAL TokenName PERMANENT TKNNM
TKNCHRCT          EQU 3 ;@NUC-GLOBAL TokenCharacter PERMANENT TKNCHRCT
TKNLFTPR          EQU 4 ;@NUC-GLOBAL TokenLeftParen PERMANENT TKNLFTPR
TKNRGHTP         EQU 5 ;@NUC-GLOBAL TokenRightParen PERMANENT TKNRGHTP
TokenSub                EQU 6
TKNFLS              EQU 7 ;@NUC-GLOBAL TokenFails PERMANENT TKNFLS
TKNELS               EQU 8 ;@NUC-GLOBAL TokenElse PERMANENT TKNELS
TKNFL               EQU 9 ;@NUC-GLOBAL TokenFail PERMANENT TKNFL
TokenEnd                EQU 10

; First-failure diagnostics. Values are proof-visible and intentionally small.
DGNSTCNN          EQU 0 ;@NUC-GLOBAL DiagnosticNone PERMANENT DGNSTCNN
DGNSTCLX       EQU 1 ;@NUC-GLOBAL DiagnosticLexical PERMANENT DGNSTCLX
DGNSTCEX   EQU 16 ;@NUC-GLOBAL DiagnosticExpectedSub PERMANENT DGNSTCEX
DGNSTCE0  EQU 17 ;@NUC-GLOBAL DiagnosticExpectedMain PERMANENT DGNSTCE0
DGNSTCE1  EQU 18 ;@NUC-GLOBAL DiagnosticExpectedLeft PERMANENT DGNSTCE1
DGNSTCE2 EQU 19 ;@NUC-GLOBAL DiagnosticExpectedRight PERMANENT DGNSTCE2
DGNSTCE3 EQU 20 ;@NUC-GLOBAL DiagnosticExpectedFails PERMANENT DGNSTCE3
DGNSTCE4  EQU 21 ;@NUC-GLOBAL DiagnosticExpectedLine PERMANENT DGNSTCE4
DGNSTCE5 EQU 22 ;@NUC-GLOBAL DiagnosticExpectedWrite PERMANENT DGNSTCE5
DGNSTCE6  EQU 23 ;@NUC-GLOBAL DiagnosticExpectedChar PERMANENT DGNSTCE6
DGNSTCE7  EQU 24 ;@NUC-GLOBAL DiagnosticExpectedElse PERMANENT DGNSTCE7
DGNSTCE8  EQU 25 ;@NUC-GLOBAL DiagnosticExpectedFail PERMANENT DGNSTCE8
DGNSTCE9   EQU 26 ;@NUC-GLOBAL DiagnosticExpectedEnd PERMANENT DGNSTCE9
DGNSTCEA   EQU 27 ;@NUC-GLOBAL DiagnosticExpectedEof PERMANENT DGNSTCEA
DGNSTCSN  EQU 32 ;@NUC-GLOBAL DiagnosticSinkCapacity PERMANENT DGNSTCSN

; Checked semantic-operation stream ordinals.
SMNTCLDU          EQU 1 ;@NUC-GLOBAL SemanticLoadU8 PERMANENT SMNTCLDU
SMNTCWRT EQU 2 ;@NUC-GLOBAL SemanticWriteOutputByte PERMANENT SMNTCWRT
SMNTCPRP       EQU 3 ;@NUC-GLOBAL SemanticPropagate PERMANENT SMNTCPRP
SMNTCRT2          EQU 4 ;@NUC-GLOBAL SemanticReturn PERMANENT SMNTCRT2
