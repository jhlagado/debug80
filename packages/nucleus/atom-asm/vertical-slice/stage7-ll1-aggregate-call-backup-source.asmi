STG7SHRT: ;@NUC-GLOBAL Stage7ShortCircuitSource PERMANENT STG7SHRT
            DB "record R",10
            DB "value as u8",10
            DB "end",10
            DB "var items as R[2]",10
            DB "sub main()",10
            DB "if false and items[2].value = 0",10
            DB "end",10
            DB "if true or items[2].value = 0",10
            DB "end",10
            DB "end",10
STG7SHR0: ;@NUC-GLOBAL Stage7ShortCircuitSourceEnd PERMANENT STG7SHR0

STG7STRC: ;@NUC-GLOBAL Stage7StructuredRoutineSource PERMANENT STG7STRC
            DB "record R",10
            DB "value as u8",10
            DB "end",10
            DB "var items as R[2]",10
            DB "sub identity(flag as boolean) as boolean",10
            DB "return flag",10
            DB "end",10
            DB "sub first(flag as boolean) as u8",10
            DB "if flag",10
            DB "return 1",10
            DB "else",10
            DB "return 0",10
            DB "end",10
            DB "end",10
            DB "sub second(word as u16) as u16",10
            DB "if word > 0",10
            DB "return word",10
            DB "else",10
            DB "return 0",10
            DB "end",10
            DB "end",10
            DB "sub main() fails",10
            DB "if identity(false and items[2].value = 0)",10
            DB "writeOutputByte('X') else fail",10
            DB "end",10
            DB "if identity(true or items[2].value = 0)",10
            DB "else",10
            DB "writeOutputByte('X') else fail",10
            DB "end",10
            DB "if first(true) = 1 and second(513) = 513",10
            DB "writeOutputByte('Y') else fail",10
            DB "end",10
            DB "end",10
STG7STR8: ;@NUC-GLOBAL Stage7StructuredRoutineSourceEnd PERMANENT STG7STR8

STG7RCRS: ;@NUC-GLOBAL Stage7RecursiveCapacitySource PERMANENT STG7RCRS
            DB "var marker as u8",10
