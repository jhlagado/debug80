            DB "if level = 0",10
            DB "marker = 1",10
            DB "else",10
            DB "descend(level - 1)",10
            DB "end",10
            DB "end",10
            DB "sub main()",10
            DB "descend(8)",10
            DB "end",10
STG7RCR1: ;@NUC-GLOBAL Stage7RecursiveCapacitySourceEnd PERMANENT STG7RCR1

