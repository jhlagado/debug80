CHPTR216: ;@NUC-GLOBAL Chapter21_1Part1 PERMANENT CHPTR216
            DB "record Cell",10
            DB "    value as u8",10
            DB "end",10
            DB 10
            DB "var template as Cell = (1)",10
            DB "var cells as Cell[4] = [(0), (0), (0), (0)]",10
            DB 10
CHPTR217: ;@NUC-GLOBAL Chapter21_1Part1End PERMANENT CHPTR217
CHPTR218: ;@NUC-GLOBAL Chapter21_1Part2 PERMANENT CHPTR218
            DB "sub cellAt(index as u8) as Cell",10
            DB "    return cells[index]",10
            DB "end",10
            DB 10
            DB "sub setCell(cell as Cell, value as u8)",10
            DB "    cell.value = value",10
            DB "end",10
            DB 10
            DB "sub main()",10
            DB "    var index as u8",10
            DB "    var code as u8",10
            DB 10
            DB "    for index = 0 until 4",10
            DB "        cells[index] = template",10
            DB "        setCell(template, index + 1)",10
            DB "    end",10
            DB 10
            DB "    cells[0].value = cellAt(0).value",10
            DB "    if cells[0].value = 1",10
            DB "        writeOutputByte('Y') handle code",10
            DB "            return",10
            DB "        end",10
            DB "    elseif cells[0].value = 0",10
            DB "        writeOutputByte('N') handle code",10
            DB "            return",10
            DB "        end",10
            DB "    end",10
            DB "end",10
CHPTR219: ;@NUC-GLOBAL Chapter21_1Part2End PERMANENT CHPTR219
CHPTR21A: ;@NUC-GLOBAL Chapter21_1Descriptors PERMANENT CHPTR21A
            DB 1
            DW CHPTR216,CHPTR217
            DB 2
            DW CHPTR218,CHPTR219

CHPTR21B: ;@NUC-GLOBAL Chapter21_2Source PERMANENT CHPTR21B
            DB "const badByte = 10",10
            DB 10
            DB "sub checkedByte() as u8 fails",10
            DB "    var value as u8 = readInputByte() else fail",10
            DB "    if value = 0",10
            DB "        fail badByte",10
            DB "    end",10
            DB "    return value",10
            DB "end",10
            DB 10
            DB "sub emitByte() fails",10
            DB "    var value as u8 = checkedByte() else fail",10
            DB "    writeOutputByte(value) else fail",10
            DB "end",10
            DB 10
            DB "sub main() fails",10
            DB "    emitByte() else fail",10
            DB "end",10
CHPTR21C: ;@NUC-GLOBAL Chapter21_2SourceEnd PERMANENT CHPTR21C

CHPTR21D: ;@NUC-GLOBAL Chapter21_3Source PERMANENT CHPTR21D
            DB "forward sub odd(value as u16) as boolean",10
            DB 10
            DB "sub even(value as u16) as boolean",10
            DB "    if value = 0",10
            DB "        return true",10
            DB "    end",10
            DB "    return odd(value - 1)",10
            DB "end",10
            DB 10
            DB "sub odd",10
            DB "    if value = 0",10
            DB "        return false",10
            DB "    end",10
            DB "    return even(value - 1)",10
            DB "end",10
            DB 10
            DB "sub main()",10
            DB "    var index as u16",10
            DB "    var code as u8",10
            DB 10
            DB "    for index = 0 to 5",10
            DB "        if odd(index)",10
            DB "            continue",10
            DB "        elseif index = 4",10
            DB "            exit",10
            DB "        end",10
            DB "    end",10
            DB 10
            DB "    writeOutputByte(u8(index)) handle code",10
            DB "        return",10
            DB "    end",10
            DB "end",10
CHPTR21E: ;@NUC-GLOBAL Chapter21_3SourceEnd PERMANENT CHPTR21E

CHPTR21F: ;@NUC-GLOBAL Chapter21_4Source PERMANENT CHPTR21F
            DB "var text as string[4] = \"A\\0B\"",10
            DB "var snapshot as string[4]",10
            DB 10
            DB "sub textAlias() as string[4]",10
            DB "    return text",10
            DB "end",10
            DB 10
            DB "sub mutate(value as string[4])",10
            DB "    value[1] = 'Z'",10
            DB "end",10
            DB 10
            DB "sub main() fails",10
            DB "    snapshot = textAlias()",10
            DB 10
            DB "    if snapshot.length = 3 and snapshot[1] = 0",10
            DB "        mutate(textAlias())",10
            DB "    end",10
            DB 10
            DB "    if text[1] = 'Z' and snapshot[1] = 0",10
            DB "        writeOutputByte('Y') else fail",10
            DB "    end",10
            DB "end",10
CHPTR21G: ;@NUC-GLOBAL Chapter21_4SourceEnd PERMANENT CHPTR21G

CHPTR21H: ;@NUC-GLOBAL Chapter21_5Source PERMANENT CHPTR21H
            DB "sub emitMarker() fails",10
            DB "    writeOutputByte('R') else fail",10
            DB "end",10
            DB 10
            DB "sub relayMarker() fails",10
            DB "    emitMarker() else fail",10
            DB "    return",10
            DB "end",10
            DB 10
            DB "sub main() fails",10
            DB "    relayMarker() else fail",10
            DB "end",10
CHPTR21I: ;@NUC-GLOBAL Chapter21_5SourceEnd PERMANENT CHPTR21I

CHPTR21J: ;@NUC-GLOBAL Chapter21_6Source PERMANENT CHPTR21J
            DB "const sampleFailure = 7",10
            DB 10
            DB "sub alwaysFails() as u8 fails",10
            DB "    fail sampleFailure",10
            DB "end",10
            DB 10
            DB "sub main() fails",10
            DB "    var code as u8",10
            DB 10
            DB "    code = alwaysFails() handle code",10
            DB "        writeOutputByte(code) else fail",10
            DB "        return",10
            DB "    end",10
            DB 10
            DB "    writeOutputByte(0) else fail",10
            DB "end",10
