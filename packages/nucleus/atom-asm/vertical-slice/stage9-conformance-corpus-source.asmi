CHPTR21Z: ;@NUC-GLOBAL Chapter21_12Source PERMANENT CHPTR21Z
            DB "forward sub render(Player as u8) as u8",10
            DB 10
            DB "var player as u8 = 1",10
            DB "var PLAYER as u8 = 2",10
            DB 10
            DB "sub render",10
            DB "    return Player + player + PLAYER",10
