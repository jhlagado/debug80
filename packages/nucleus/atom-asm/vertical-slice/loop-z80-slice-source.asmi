            ORG SRCBS
LPPRFSRC: ;@NUC-GLOBAL LoopProofSource PERMANENT LPPRFSRC
            DB "sub main() fails",10
            DB "    var index as u8 = 0",10
            DB "    for index = 0 until 3",10
            DB "        writeOutputByte('A') else fail",10
            DB "    end",10
            DB "end",10
LPPRFSR0: ;@NUC-GLOBAL LoopProofSourceEnd PERMANENT LPPRFSR0

ZRLPPRFS: ;@NUC-GLOBAL ZeroLoopProofSource PERMANENT ZRLPPRFS
            DB "sub main() fails",10
            DB "    var index as u8 = 0",10
            DB "    for index = 0 until 0",10
            DB "        writeOutputByte('A') else fail",10
            DB "    end",10
            DB "end",10
ZRLPPRF0: ;@NUC-GLOBAL ZeroLoopProofSourceEnd PERMANENT ZRLPPRF0
