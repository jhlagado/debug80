            DB "total as u8 = 1",10
            DB "sub main() fails",10
            DB "end",10
DPLCTSC1: ;@NUC-GLOBAL DuplicateScalarSourceEnd PERMANENT DPLCTSC1

UNKNWNSC: ;@NUC-GLOBAL UnknownScalarSource PERMANENT UNKNWNSC
