{
  "start": "compilation-unit",
  "diagnostics": {
    "compilation-unit": "DiagnosticExpectedTopLevel",
    "top-level-list": "DiagnosticExpectedTopLevel",
    "top-level-declaration": "DiagnosticExpectedTopLevel",
    "const-declaration": "DiagnosticExpectedTopLevel",
    "program-var-declaration": "DiagnosticExpectedTopLevel",
    "program-initializer-opt": "DiagnosticExpectedEqual",
    "record-declaration": "DiagnosticExpectedTopLevel",
    "record-fields": "DiagnosticRecordEmpty",
    "record-field-tail": "DiagnosticExpectedScalar",
    "record-field": "DiagnosticExpectedScalar",
    "sub-definition": "DiagnosticExpectedSub",
    "parameter-list": "DiagnosticExpectedRight",
    "parameter-tail": "DiagnosticExpectedRight",
    "parameter": "DiagnosticExpectedScalar",
    "result-opt": "DiagnosticExpectedLine",
    "fails-opt": "DiagnosticExpectedLine",
    "routine-body": "DiagnosticExpectedScalar",
    "local-list": "DiagnosticExpectedScalar",
    "local-declaration": "DiagnosticExpectedVar",
    "local-initializer-opt": "DiagnosticExpectedLine",
    "statement-sequence": "DiagnosticExpectedScalar",
    "statement": "DiagnosticExpectedScalar",
    "return-statement": "DiagnosticExpectedReturn",
    "transfer-statement": "DiagnosticExpectedLoop",
    "if-statement": "DiagnosticExpectedIf",
    "if-tail": "DiagnosticExpectedScalar",
    "while-statement": "DiagnosticExpectedScalar",
    "for-statement": "DiagnosticExpectedFor",
    "for-bound": "DiagnosticExpectedScalar",
    "for-step-opt": "DiagnosticExpectedLine",
    "type": "DiagnosticExpectedType",
    "type-atom": "DiagnosticExpectedType",
    "type-array-opt": "DiagnosticExpectedScalar",
    "scalar-type": "DiagnosticExpectedType"
  },
  "externals": {
    "ConstantExpression": ["TokenNumber", "TokenCharacter", "TokenTrue", "TokenFalse", "TokenName", "TokenLeftParen", "TokenU8", "TokenU16", "TokenPlus", "TokenMinus", "TokenNot"],
    "RuntimeExpression": ["TokenNumber", "TokenCharacter", "TokenTrue", "TokenFalse", "TokenName", "TokenLeftParen", "TokenU8", "TokenU16", "TokenPlus", "TokenMinus", "TokenNot"],
    "StaticInitializer": ["TokenNumber", "TokenCharacter", "TokenTrue", "TokenFalse", "TokenName", "TokenLeftParen", "TokenLeftBracket", "TokenStringLiteral", "TokenU8", "TokenU16", "TokenPlus", "TokenMinus", "TokenNot"],
    "StepConstant": ["TokenNumber", "TokenName", "TokenPlus", "TokenMinus"],
    "StrayClause": ["TokenElse", "TokenElseIf"],
    "NameStatement": ["TokenName"],
    "ReturnValue": ["TokenNumber", "TokenCharacter", "TokenTrue", "TokenFalse", "TokenName", "TokenLeftParen", "TokenU8", "TokenU16", "TokenPlus", "TokenMinus", "TokenNot"]
  },
  "productions": [
    { "lhs": "compilation-unit", "rhs": ["top-level-list", "a:RequireMain", "TokenEof"] },

    { "lhs": "top-level-list", "rhs": ["top-level-declaration", "top-level-list"] },
    { "lhs": "top-level-list", "rhs": [] },
    { "lhs": "top-level-declaration", "rhs": ["const-declaration"] },
    { "lhs": "top-level-declaration", "rhs": ["program-var-declaration"] },
    { "lhs": "top-level-declaration", "rhs": ["record-declaration"] },
    { "lhs": "top-level-declaration", "rhs": ["sub-definition"] },

    { "lhs": "const-declaration", "rhs": ["a:RequireBeforeMain", "TokenConst", "TokenName", "a:RetainDeclarationName", "TokenAs", "scalar-type", "a:SaveDeclarationType", "TokenEquals", "x:ConstantExpression", "a:FinishConstantExpression", "TokenNewline", "a:CommitConstant"] },
    { "lhs": "program-var-declaration", "rhs": ["a:RequireBeforeMain", "TokenVar", "TokenName", "a:RetainDeclarationName", "TokenAs", "type", "a:SaveProgramType", "program-initializer-opt", "TokenNewline", "a:CommitProgramVariable"] },
    { "lhs": "program-initializer-opt", "rhs": ["TokenEquals", "x:StaticInitializer", "a:FinishProgramInitializer"] },
    { "lhs": "program-initializer-opt", "rhs": [] },

    { "lhs": "record-declaration", "rhs": ["a:RequireBeforeMain", "TokenRecord", "TokenName", "a:BeginRecord", "TokenNewline", "record-fields", "TokenEnd", "TokenNewline", "a:CommitRecord"] },
    { "lhs": "record-fields", "rhs": ["record-field", "record-field-tail"] },
    { "lhs": "record-field-tail", "rhs": ["record-field", "record-field-tail"] },
    { "lhs": "record-field-tail", "rhs": [] },
    { "lhs": "record-field", "rhs": ["TokenName", "a:BeginRecordField", "TokenAs", "type", "TokenNewline", "a:CommitRecordField"] },

    { "lhs": "sub-definition", "rhs": ["TokenSub", "TokenName", "a:BeginSub", "TokenLeftParen", "parameter-list", "TokenRightParen", "result-opt", "fails-opt", "TokenNewline", "a:BeginSubBody", "routine-body", "a:EndSub"] },
    { "lhs": "parameter-list", "rhs": ["parameter", "parameter-tail"] },
    { "lhs": "parameter-list", "rhs": [] },
    { "lhs": "parameter-tail", "rhs": ["TokenComma", "parameter", "parameter-tail"] },
    { "lhs": "parameter-tail", "rhs": [] },
    { "lhs": "parameter", "rhs": ["TokenName", "a:RetainParameter", "TokenAs", "type", "a:CommitParameter"] },
    { "lhs": "result-opt", "rhs": ["TokenAs", "a:AllowSubResult", "type", "a:SaveSubResult"] },
    { "lhs": "result-opt", "rhs": [] },
    { "lhs": "fails-opt", "rhs": ["TokenFails", "a:MarkSubFails"] },
    { "lhs": "fails-opt", "rhs": [] },
    { "lhs": "routine-body", "rhs": ["local-list", "statement-sequence", "TokenEnd", "TokenNewline"] },
    { "lhs": "routine-body", "rhs": ["x:StrayClause"] },

    { "lhs": "local-list", "rhs": ["local-declaration", "local-list"] },
    { "lhs": "local-list", "rhs": [] },
    { "lhs": "local-declaration", "rhs": ["TokenVar", "TokenName", "a:RetainDeclarationName", "TokenAs", "scalar-type", "a:SaveLocalType", "local-initializer-opt", "TokenNewline", "a:CommitLocal"] },
    { "lhs": "local-initializer-opt", "rhs": ["TokenEquals", "a:BeginLocalInitializer", "x:RuntimeExpression", "a:FinishLocalInitializer"] },
    { "lhs": "local-initializer-opt", "rhs": ["a:DefaultLocalInitializer"] },

    { "lhs": "statement-sequence", "rhs": ["statement", "statement-sequence"] },
    { "lhs": "statement-sequence", "rhs": [] },
    { "lhs": "statement", "rhs": ["x:NameStatement"] },
    { "lhs": "statement", "rhs": ["return-statement", "TokenNewline"] },
    { "lhs": "statement", "rhs": ["transfer-statement", "TokenNewline"] },
    { "lhs": "statement", "rhs": ["if-statement"] },
    { "lhs": "statement", "rhs": ["while-statement"] },
    { "lhs": "statement", "rhs": ["for-statement"] },

    { "lhs": "return-statement", "rhs": ["TokenReturn", "a:BeginReturnValue", "x:ReturnValue", "a:CommitReturn"] },
    { "lhs": "transfer-statement", "rhs": ["TokenExit", "a:EmitExit"] },
    { "lhs": "transfer-statement", "rhs": ["TokenContinue", "a:EmitContinue"] },

    { "lhs": "if-statement", "rhs": ["TokenIf", "a:BeginIf", "x:RuntimeExpression", "TokenNewline", "a:BeginIfBody", "statement-sequence", "if-tail", "TokenEnd", "TokenNewline", "a:EndIf"] },
    { "lhs": "if-tail", "rhs": ["TokenElseIf", "a:BeginElseIf", "x:RuntimeExpression", "TokenNewline", "a:BeginIfBody", "statement-sequence", "if-tail"] },
    { "lhs": "if-tail", "rhs": ["TokenElse", "a:BeginElse", "TokenNewline", "statement-sequence", "a:FinishElse"] },
    { "lhs": "if-tail", "rhs": ["a:FinishIfClauses"] },
    { "lhs": "while-statement", "rhs": ["TokenWhile", "a:BeginWhile", "x:RuntimeExpression", "TokenNewline", "a:BeginWhileBody", "statement-sequence", "TokenEnd", "TokenNewline", "a:EndWhile"] },
    { "lhs": "for-statement", "rhs": ["TokenFor", "TokenName", "a:BeginFor", "TokenEquals", "x:RuntimeExpression", "for-bound", "x:RuntimeExpression", "for-step-opt", "TokenNewline", "a:BeginForBody", "statement-sequence", "TokenEnd", "TokenNewline", "a:EndFor"] },
    { "lhs": "for-bound", "rhs": ["TokenTo", "a:ForTo"] },
    { "lhs": "for-bound", "rhs": ["TokenUntil", "a:ForUntil"] },
    { "lhs": "for-step-opt", "rhs": ["TokenStep", "x:StepConstant", "a:SaveForStep"] },
    { "lhs": "for-step-opt", "rhs": ["a:DefaultForStep"] },

    { "lhs": "type", "rhs": ["type-atom", "type-array-opt"] },
    { "lhs": "type-atom", "rhs": ["scalar-type"] },
    { "lhs": "type-atom", "rhs": ["TokenName", "a:ResolveRecordType"] },
    { "lhs": "type-atom", "rhs": ["TokenString", "TokenLeftBracket", "a:BeginTypeBound", "x:ConstantExpression", "TokenRightBracket", "a:MakeStringType"] },
    { "lhs": "type-array-opt", "rhs": ["TokenLeftBracket", "a:BeginTypeBound", "x:ConstantExpression", "TokenRightBracket", "a:MakeArrayType"] },
    { "lhs": "type-array-opt", "rhs": [] },
    { "lhs": "scalar-type", "rhs": ["TokenU8", "a:TypeU8"] },
    { "lhs": "scalar-type", "rhs": ["TokenU16", "a:TypeU16"] },
    { "lhs": "scalar-type", "rhs": ["TokenBoolean", "a:TypeBoolean"] }
  ]
