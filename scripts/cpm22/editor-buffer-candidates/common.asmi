; Representation-independent cursor scans used by both editor buffer candidates.
; CandidateByteAt accepts a logical byte offset in HL and returns the byte in A,
; with carry set at or beyond logical EOF.

.routine in HL out HL,carry,zero clobbers sign,parity,halfCarry,A,BC,DE
CandidateFindLineStart:
            LD   A,H
            OR   L
            RET  Z
CandidateFindLineStartLoop:
            DEC  HL
            PUSH HL
            CALL CandidateByteAt
            POP  HL
            CP   10
            JR   NZ,CandidateFindLineStartContinue
            INC  HL
            RET
CandidateFindLineStartContinue:
            LD   A,H
            OR   L
            JR   NZ,CandidateFindLineStartLoop
            RET

.routine in HL out HL,carry,zero clobbers sign,parity,halfCarry,A,BC,DE
CandidateFindNextLine:
            PUSH HL
            CALL CandidateByteAt
            POP  HL
            RET  C
            INC  HL
            CP   10
            JR   NZ,CandidateFindNextLine
            OR   A
            RET

.routine out A,carry,zero clobbers sign,parity,halfCarry,BC,DE,HL
CandidateTraverse:
            XOR  A
            LD   (CandidateChecksum),A
            LD   HL,0
CandidateTraverseLoop:
            PUSH HL
            CALL CandidateByteAt
            JR   C,CandidateTraverseDone
            LD   B,A
            LD   A,(CandidateChecksum)
            ADD  A,B
            LD   (CandidateChecksum),A
            POP  HL
            INC  HL
            JR   CandidateTraverseLoop
CandidateTraverseDone:
            POP  HL
            LD   A,(CandidateChecksum)
            RET

CandidateCommonEnd:
