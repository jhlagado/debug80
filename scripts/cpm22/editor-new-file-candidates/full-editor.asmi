; Complete production editor boundary with candidate command, load, and save
; modules. All unrelated modules and immutable bytes come directly from the
; production editor so the resident deltas remain comparable.

            .include "../../../apps/debug80-vscode/roms/cpm22/editor-memory.asmi"

            .org EditorCodeBase
EditorTransientStart:
            JP   EditorEntry

EditorCodeStart:
            .include "../../../apps/debug80-vscode/roms/cpm22/editor-bdos.asm"
            .include "command.asmi"
            .include "load.asmi"
            .include "../../../apps/debug80-vscode/roms/cpm22/editor-buffer.asm"
            .include "../../../apps/debug80-vscode/roms/cpm22/editor-navigation.asm"
            .include "../../../apps/debug80-vscode/roms/cpm22/editor-screen.asm"
            .include "save.asmi"
            .include "../../../apps/debug80-vscode/roms/cpm22/editor-search.asm"
            .include "../../../apps/debug80-vscode/roms/cpm22/editor-main.asm"
EditorCodeEnd:

EditorImmutableStart:
EditorDefaultName:        .db 0,"INPUT   ","NU "
EditorBackupExtension:    .db "BAK"
EditorTemporaryExtension: .db "$$$"
EditorErrorPrefix:        .db 13,10,"EDIT error ","$"
EditorNewline:            .db 13,10,"$"
EditorClearHome:          .db 27,"[2J",27,"[H","$"
EditorStatusPosition:     .db 27,"[24;1H",27,"[7m","$"
EditorReverseOff:         .db 27,"[0m",27,"[","$"
EditorStatusPrefix:       .db "EDIT ",0
EditorStatusHints:        .db "  ^S Save  ^Q Quit",0
EditorStatusSavedText:    .db "Saved  ",0
EditorStatusFullText:     .db "Full  ",0
EditorStatusDiscardText:  .db "Discard changes? ^Q again  ",0
EditorStatusSaveFailedText: .db "Save failed ",0
EditorStatusFoundText:    .db "Found",0
EditorStatusWrappedText:  .db "Wrapped",0
EditorStatusNotFoundText: .db "Not found",0
EditorStatusNoSearchText: .db "No search",0
EditorSearchPrompt:       .db "Find: ",0
EditorImmutableEnd:
EditorResidentEnd:
            .end
