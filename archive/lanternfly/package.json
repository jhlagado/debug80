{
  "name": "lanternfly",
  "version": "0.0.0",
  "private": true,
  "description": "Lanternfly compiler package for a statically typed structured BASIC targeting fixed-memory systems",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build -w @jhlagado/azm && npm run build -w @jhlagado/debug80-runtime",
    "test": "vitest run",
    "generate:runtime": "UPDATE_RUNTIME=1 vitest run test/runtime-image.test.ts",
    "generate:lowering": "UPDATE_LOWERING=1 vitest run test/lowering-doc.test.ts",
    "generate:capacity": "UPDATE_CAPACITY=1 vitest run test/capacity.test.ts",
    "generate:grammar": "UPDATE_GRAMMAR=1 vitest run test/grammar.test.ts",
    "generate:nucleus": "UPDATE_NUCLEUS=1 vitest run test/nucleus-lowering.test.ts"
  },
  "dependencies": {
    "@jhlagado/azm": "^0.4.0",
    "@jhlagado/debug80-runtime": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "5.3.3",
    "vitest": "^4.1.7"
  }
}
